{
  "redirects": [
    { "source": "/localita/:slug", "destination": "/:slug", "permanent": true },
    { "source": "/spiagge/:slug", "destination": "/:slug", "permanent": true },
    { "source": "/noleggio-senza-carta-credito", "destination": "/noleggio-auto-senza-carta-di-credito-olbia", "permanent": true },
    { "source": "/en/car-hire-olbia", "destination": "/noleggio-auto-olbia", "permanent": false },
    { "source": "/de/autovermietung-olbia", "destination": "/noleggio-auto-olbia", "permanent": false },
    { "source": "/fr/location-voiture-olbia", "destination": "/noleggio-auto-olbia", "permanent": false },
    { "source": "/sitemap.xml", "destination": "/sitemap-index.xml", "permanent": true },
    { "source": "/noleggio-auto-santa-teresa-gallura", "destination": "/noleggio-auto-palau", "permanent": true },
    { "source": "/en/noleggio-auto-santa-teresa-gallura", "destination": "/en/noleggio-auto-palau", "permanent": true },
    { "source": "/de/noleggio-auto-santa-teresa-gallura", "destination": "/de/noleggio-auto-palau", "permanent": true },
    { "source": "/fr/noleggio-auto-santa-teresa-gallura", "destination": "/fr/noleggio-auto-palau", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|svg|gif|ico|woff2|woff|mp4)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://*.googletagmanager.com https://*.google-analytics.com https://*.googleadservices.com https://*.googleapis.com https://maps.googleapis.com https://cdn.iubenda.com https://embeds.iubenda.com https://www.googletagmanager.com https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.iubenda.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.google-analytics.com https://*.googletagmanager.com https://*.googleapis.com https://www.google.com https://stats.g.doubleclick.net; frame-src 'self' https://*.google.com https://*.iubenda.com https://www.youtube.com https://www.youtube-nocookie.com; media-src 'self' https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
