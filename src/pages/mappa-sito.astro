const itemListJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Mappa del sito KS Rent Sardinia",
  numberOfItems: allItems.length,
  itemListElement: allItems.map((it, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: it.label,
    url: `${SITE}${it.to}`,
