  { title: "Località Costa Est & Nord", icon: "📍", items: locCostaEst },
  { title: "Spiagge Costa Smeralda", icon: "🌊", items: spiaggeCS },
  { title: "Spiagge Costa Est & Nord", icon: "🌊", items: spiaggeEstNord },
