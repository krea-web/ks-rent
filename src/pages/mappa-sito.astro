---
<BaseLayout
  title="Mappa del Sito | KS Rent Sardinia — Noleggio Auto Olbia"
  description="Mappa completa del sito KS Rent Sardinia: tutte le pagine di noleggio auto a Olbia, Costa Smeralda, Gallura e le spiagge servite con consegna a domicilio."
  canonical="https://www.ksrentsardinia.com/mappa-sito"
  jsonLd={[buildBreadcrumb("Mappa del Sito", "/mappa-sito"), itemListJsonLd]}
>
  <main class="min-h-screen bg-gray-50 dark:bg-[#050505] text-foreground pt-32 md:pt-40 pb-20">
    <div class="container mx-auto px-4 max-w-6xl">
      {/* Hero */}
      <header class="mb-12 md:mb-16 text-center">
        <span class="inline-block text-gold font-semibold tracking-[0.3em] uppercase text-[11px] md:text-xs mb-4">
          Indice Completo
        </span>
        <h1 class="text-3xl md:text-5xl lg:text-6xl font-display font-black tracking-tight text-foreground leading-tight mb-4">
          Mappa del Sito
        </h1>
        <p class="text-base md:text-lg text-muted-foreground max-w-2xl mx-auto leading-relaxed">
          Tutte le pagine di KS Rent Sardinia in un'unica vista: navigazione rapida,
          accessibilità e indice per i motori di ricerca. Olbia, Costa Smeralda, Gallura,
          spiagge e servizi.
        </p>
      </header>

      {/* Sections */}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
        {sections.map((sec) => (
          <section class="bg-white dark:bg-[#0a0a0a] border border-gray-200 dark:border-white/10 rounded-2xl p-6 md:p-8 hover:border-gold/30 transition-colors">
            <h2 class="text-foreground font-bold text-sm uppercase tracking-[0.18em] mb-5 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-gold flex-shrink-0"></span>
              <span>{sec.title}</span>
              <span class="ml-auto text-[11px] font-medium text-muted-foreground tracking-widest">
                {sec.items.length}
              </span>
            </h2>
            <ul class="flex flex-col gap-1.5">
              {sec.items.map((it) => (
                <li>
                  <a
                    href={it.to}
                    class="flex items-center justify-between gap-3 px-3 py-2 rounded-lg text-sm text-gray-700 dark:text-white/75 hover:bg-gold/10 hover:text-gold transition-colors group"
                  >
                    <span>{it.label}</span>
                    <span class="text-gold opacity-0 group-hover:opacity-100 transition-opacity">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      {/* Footer note */}
      <div class="mt-12 md:mt-16 text-center text-sm text-muted-foreground">
        <p>
          {allItems.length} pagine indicizzate ·
          <a href="/sitemap-index.xml" class="text-gold hover:underline ml-1">Sitemap XML</a>
        </p>
      </div>
    </div>
  </main>
</BaseLayout>
