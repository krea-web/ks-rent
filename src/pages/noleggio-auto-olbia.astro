import NoleggioOlbiaContent from "@/components/NoleggioOlbiaContent.astro";
import GuideVehicleStrip from "@/components/GuideVehicleStrip.astro";
import {
  olbiaAutoRentalJsonLd,
  olbiaFaqJsonLd,
  buildBreadcrumb,
} from "@/lib/jsonLd";
---

<BaseLayout
  title="Noleggio Auto Olbia | KS Rent Sardinia — Senza Carta di Credito"
  description="Noleggio auto, moto e quad a Olbia con consegna a domicilio gratuita all'aeroporto OLB e al porto Isola Bianca. Flotta moderna, anche senza carta di credito obbligatoria."
  canonical="https://www.ksrentsardinia.com/noleggio-auto-olbia"
  ogImage="https://zgytnkimjpoosvshfopz.supabase.co/storage/v1/object/public/asset/og-image.jpg"
  jsonLd={[
    olbiaAutoRentalJsonLd,
    olbiaFaqJsonLd,
    buildBreadcrumb("Noleggio Auto Olbia", "/noleggio-auto-olbia"),
  ]}
  breadcrumbs={[{ name: "Noleggio Auto Olbia", path: "/noleggio-auto-olbia" }]}
>
  <NoleggioOlbiaContent lang="it" />
  <GuideVehicleStrip lang="it" />
