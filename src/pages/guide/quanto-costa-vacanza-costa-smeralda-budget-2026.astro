---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GuideArticleLayout from "@/components/GuideArticleLayout.astro";
import { findArticle } from "@/data/guide-articles";

const meta = findArticle("quanto-costa-vacanza-costa-smeralda-budget-2026")!;
const pageUrl = `https://www.ksrentsardinia.com/guide/${meta.slug}`;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": `${pageUrl}#article`,
  headline: meta.title,
  description: meta.excerpt,
  image: meta.heroImage,
  datePublished: meta.publishedAt,
  dateModified: meta.updatedAt || meta.publishedAt,
  author: [
    { "@type": "Person", name: "Francesco Milo", jobTitle: "Co-fondatore KS Rent Sardinia" },
    { "@type": "Person", name: "Salvatore Milo", jobTitle: "Co-fondatore KS Rent Sardinia" },
  ],
  publisher: { "@id": "https://www.ksrentsardinia.com/#organization" },
  mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
  inLanguage: "it-IT",
  about: {
    "@type": "Thing",
    name: "Budget vacanza Costa Smeralda",
  },
};
---
<BaseLayout
  title={`${meta.title} | Guide KS Rent Sardinia`}
  description={meta.excerpt}
  canonical={pageUrl}
  ogImage={meta.heroImage}
  jsonLd={articleJsonLd}
  breadcrumbs={[
    { name: "Guide", path: "/guide" },
    { name: "Quanto costa Costa Smeralda", path: `/guide/${meta.slug}` },
  ]}
>
  <GuideArticleLayout meta={meta}>
    <p>
      <strong>La Costa Smeralda ha la fama di essere "carissima"</strong>, e in effetti i picchi di luglio-agosto possono essere proibitivi. Ma una vacanza in Costa Smeralda <strong>può costare da 700 € a 7.000 € a persona</strong> per una settimana, a seconda di stagione, sistemazione, ristoranti e attività. Questa guida raccoglie i numeri reali del 2026 — visti da Francesco e Salvatore Milo che ogni anno gestiscono clienti con budget molto diversi — divisi per profilo (single backpacker, coppia media, famiglia, gruppo lusso). Tutti i prezzi sono <strong>per persona, 7 giorni</strong>, salvo diversa indicazione.
    </p>

    <h2>Le 5 voci di spesa principali</h2>

    <p>
      Una vacanza in Costa Smeralda si compone di:
    </p>

    <ol>
      <li><strong>Trasporto</strong>: volo o traghetto + auto</li>
      <li><strong>Alloggio</strong>: hotel, B&B, villa, agriturismo</li>
      <li><strong>Cibo</strong>: ristoranti, supermercati, bar</li>
      <li><strong>Spiagge</strong>: lettini, ombrelloni, parcheggi, stabilimenti</li>
      <li><strong>Attività</strong>: escursioni in barca, eventi, locali notturni</li>
    </ol>

    <p>
      Vediamo le 4 fasce principali con esempi concreti.
    </p>

    <h2>Profilo 1 — Backpacker low-budget (single, bassa stagione)</h2>

    <p>
      <strong>Stagione</strong>: maggio o ottobre · <strong>Sistemazione</strong>: ostello/B&B economico
    </p>

    <table>
      <thead>
        <tr>
          <th>Voce</th>
          <th>Costo</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Volo Roma-Olbia a/r</td>
          <td>50-100 €</td>
        </tr>
        <tr>
          <td>Auto Fiat Panda noleggio 7 giorni</td>
          <td>280 €</td>
        </tr>
        <tr>
          <td>Carburante</td>
          <td>50 €</td>
        </tr>
        <tr>
          <td>Ostello/B&B 7 notti (camera condivisa)</td>
          <td>200-350 €</td>
        </tr>
        <tr>
          <td>Cibo (supermercato + 2 ristoranti)</td>
          <td>150-200 €</td>
        </tr>
        <tr>
          <td>Spiagge libere + 1 stabilimento</td>
          <td>40-80 €</td>
        </tr>
        <tr>
          <td>Attività zero o 1 escursione barca economica</td>
          <td>0-50 €</td>
        </tr>
        <tr>
          <td><strong>TOTALE 1 persona, 7 giorni</strong></td>
          <td><strong>770 - 1.110 €</strong></td>
        </tr>
      </tbody>
    </table>

    <p>
      <strong>Cosa puoi fare</strong>: girare le spiagge libere (Pittulongu, Bados, Cala Sabina, La Cinta zona libera, Spiaggia del Principe), visitare i centri (Olbia, San Pantaleo, Tempio Pausania), fare 1-2 cene fuori. <strong>Cosa NON puoi fare</strong>: pranzare in Piazzetta a Porto Cervo, soggiornare in Costa Smeralda (alloggi solo a Olbia o entroterra), bere ai locali esclusivi.
    </p>

    <h2>Profilo 2 — Coppia media (settembre, hotel 3-4 stelle)</h2>

    <p>
      <strong>Stagione</strong>: settembre · <strong>Sistemazione</strong>: hotel 3-4 stelle a Olbia o Cannigione
    </p>

    <table>
      <thead>
        <tr>
          <th>Voce</th>
          <th>Costo per coppia</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Voli a/r 2 persone</td>
          <td>200-400 €</td>
        </tr>
        <tr>
          <td>Auto Mercedes Classe A noleggio 7 giorni</td>
          <td>650-900 €</td>
        </tr>
        <tr>
          <td>Carburante + parcheggi</td>
          <td>150-200 €</td>
        </tr>
        <tr>
          <td>Hotel 3-4 stelle 7 notti (mezzosogg)</td>
          <td>800-1.300 €</td>
        </tr>
        <tr>
          <td>Cibo (ristoranti vari)</td>
          <td>500-800 €</td>
        </tr>
        <tr>
          <td>Spiagge stabilimento + ingressi</td>
          <td>200-400 €</td>
        </tr>
        <tr>
          <td>1 escursione barca + qualche aperitivo</td>
          <td>150-300 €</td>
        </tr>
        <tr>
          <td><strong>TOTALE coppia, 7 giorni</strong></td>
          <td><strong>2.650 - 4.300 €</strong></td>
        </tr>
        <tr>
          <td><strong>Per persona</strong></td>
          <td><strong>1.325 - 2.150 €</strong></td>
        </tr>
      </tbody>
    </table>

    <p>
      <strong>Cosa puoi fare</strong>: pranzare in Costa Smeralda 2-3 volte, fare aperitivo al Phi Beach, escursione a Tavolara o La Maddalena, cene di pesce in posti buoni, visitare tutta la Costa Smeralda con stabilimenti.
    </p>

    <h2>Profilo 3 — Famiglia 4 persone (luglio, hotel 4 stelle)</h2>

    <p>
      <strong>Stagione</strong>: luglio · <strong>Sistemazione</strong>: hotel famiglia 4 stelle
    </p>

    <table>
      <thead>
        <tr>
