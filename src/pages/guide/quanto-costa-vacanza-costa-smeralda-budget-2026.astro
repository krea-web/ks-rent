        </tr>
        <tr>
          <td>Auto Jeep Avenger noleggio 7 giorni</td>
          <td>770-900 €</td>
        </tr>
        <tr>
          <td>Carburante + parcheggi</td>
          <td>200-300 €</td>
        </tr>
        <tr>
          <td>Hotel 4 stelle famiglia 7 notti (mezzosogg)</td>
          <td>2.500-4.500 €</td>
        </tr>
        <tr>
