---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GuideArticleLayout from "@/components/GuideArticleLayout.astro";
import { findArticle } from "@/data/guide-articles";

const meta = findArticle("noleggio-auto-olbia-mensile-30-giorni")!;
const pageUrl = `https://www.ksrentsardinia.com/guide/${meta.slug}`;

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": `${pageUrl}#article`,
  headline: meta.title,
  description: meta.excerpt,
  image: meta.heroImage,
  datePublished: meta.publishedAt,
  dateModified: meta.updatedAt || meta.publishedAt,
  author: [
    { "@type": "Person", name: "Francesco Milo", jobTitle: "Co-fondatore KS Rent Sardinia" },
    { "@type": "Person", name: "Salvatore Milo", jobTitle: "Co-fondatore KS Rent Sardinia" },
  ],
  publisher: { "@id": "https://www.ksrentsardinia.com/#organization" },
  mainEntityOfPage: { "@type": "WebPage", "@id": pageUrl },
  inLanguage: "it-IT",
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${pageUrl}#faq`,
  mainEntity: [
    { "@type": "Question", name: "Quanto costa noleggiare un'auto per un mese intero a Olbia?", acceptedAnswer: { "@type": "Answer", text: "30 giorni di Fiat Panda Hybrid: 800 € bassa stagione (apr/mag/ott), 1.500 € media (giu/set), 2.400-3.500 € alta (lug/ago). Jeep Avenger: 1.100 € bassa, 2.000 € media, 3.500-4.500 € alta. La tariffa mensile è circa 22 × giornaliera (~27% risparmio vs 30×)." } },
    { "@type": "Question", name: "Chi sceglie tipicamente il noleggio mensile a Olbia?", acceptedAnswer: { "@type": "Answer", text: "I clienti del noleggio mensile KS Rent Sardinia sono: 1) smart worker remoti che si trasferiscono in Sardegna per 1-3 mesi, 2) chi sta cercando casa in Costa Smeralda e ha bisogno di esplorare zone, 3) famiglie che fanno vacanze prolungate estive (intero agosto), 4) freelance digital nomad che lavorano da Olbia." } },
    { "@type": "Question", name: "Posso pagare il noleggio mensile a rate o solo in unica soluzione?", acceptedAnswer: { "@type": "Answer", text: "Sì, KS Rent Sardinia accetta pagamento mensile in 2 tranche per durate di 30+ giorni: 50% al ritiro, 50% al 15° giorno. Pagamento accettato anche senza carta di credito: bonifico, prepagate, contanti, bancomat. Per durate >2 mesi possiamo discutere piani di rateizzazione personalizzati." } },
    { "@type": "Question", name: "Cosa succede se ho bisogno di manutenzione (es. olio motore) durante un noleggio di 30 giorni?", acceptedAnswer: { "@type": "Answer", text: "KS Rent Sardinia copre interamente la manutenzione di routine durante i noleggi 30+ giorni: cambio olio (se km lo richiedono), controllo pneumatici, lavaggio mensile, ricarica climatizzatore. Cambia veicolo temporaneo per 1-2 giorni gratis durante l'intervento. Coperture incluse senza costi aggiuntivi." } },
    { "@type": "Question", name: "C'è un limite di chilometri per il noleggio mensile?", acceptedAnswer: { "@type": "Answer", text: "Per noleggi mensili KS Rent Sardinia applica un limite generoso di 3.500 km/mese (115 km/giorno medi), più che sufficienti per uso intensivo Gallura + Costa Smeralda + escursioni in Sardegna. Oltre quel limite: 0,15 €/km extra. La maggior parte dei clienti mensili sta sotto i 2.500 km." } },
  ],
};

const howToJsonLd = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "@id": `${pageUrl}#howto`,
  name: "Come noleggiare un'auto al mese a Olbia",
  description: "I passaggi per attivare un noleggio long-stay di 30 giorni con KS Rent Sardinia: preventivo, scelta veicolo, ritiro, manutenzione inclusa e riconsegna.",
  totalTime: "P30D",
  step: [
    { "@type": "HowToStep", position: 1, name: "Richiedi il preventivo", text: "Scrivi su WhatsApp con date di inizio/fine, veicolo preferito e finalità (smart work, vacanza, ricerca casa): rispondiamo con un preventivo nominale entro un'ora." },
    { "@type": "HowToStep", position: 2, name: "Scegli il veicolo", text: "Seleziona il mezzo in base all'uso: Fiat Panda Hybrid per la città, Jeep Avenger per la famiglia, Mercedes Classe A per il comfort sulle lunghe percorrenze." },
    { "@type": "HowToStep", position: 3, name: "Ritira e paga (anche senza carta)", text: "Presenta patente B (1+ anno), documento e codice fiscale/TIN. Pagamento in 2 tranche (50% al ritiro, 50% al 15° giorno) con bonifico, prepagate, bancomat o contanti." },
    { "@type": "HowToStep", position: 4, name: "Usa l'auto con manutenzione inclusa", text: "Sono inclusi cambio olio se necessario, controllo pneumatici, lavaggio mensile e veicolo sostitutivo durante gli interventi, con 3.500 km/mese compresi." },
    { "@type": "HowToStep", position: 5, name: "Riconsegna", text: "Restituisci il veicolo col pieno nel punto concordato (aeroporto, porto o centro Olbia). Per durate oltre i 30 giorni si attivano tariffe long-term ancora più convenienti." },
  ],
};
---
<BaseLayout
  title={meta.title}
  description={meta.excerpt}
  canonical={pageUrl}
  ogImage={meta.heroImage}
  jsonLd={[articleJsonLd, faqJsonLd, howToJsonLd]}
  breadcrumbs={[
    { name: "Guide", path: "/guide" },
    { name: "Noleggio mensile 30 giorni", path: `/guide/${meta.slug}` },
  ]}
>
  <GuideArticleLayout meta={meta}>
    <p>
      <strong>Il noleggio mensile è un'altra categoria rispetto alle vacanze brevi.</strong> Non è il "vacanziere che vede tutto in 7 giorni", è chi <strong>vive temporaneamente in Sardegna</strong>: smart worker remoti che trasferiscono ufficio in Costa Smeralda per 1-3 mesi, famiglie che fanno l'intero agosto in Gallura, professionisti che cercano casa e devono esplorare zone, digital nomad che alternano cliente e mare. Per questi clienti KS Rent Sardinia applica la <strong>tariffa long stay più aggressiva</strong>: ~22 × giornaliera per 30 giorni (-27% vs 30 giornate singole). Qui prezzi, copertura manutenzione inclusa, e perché conviene rispetto a comprare un'auto usata per il soggiorno breve.
    </p>

    <h2>Tariffe noleggio 30 giorni</h2>

    <table>
      <thead>
        <tr>
          <th>Veicolo</th>
          <th>Aprile/Maggio/Ottobre</th>
          <th>Giugno/Settembre</th>
          <th>Luglio/Agosto</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>Fiat Panda Hybrid</td><td>800 €</td><td>1.500 €</td><td>2.400-3.500 €</td></tr>
        <tr><td>Jeep Avenger</td><td>1.100 €</td><td>2.000 €</td><td>3.500-4.500 €</td></tr>
        <tr><td>Mercedes Classe A 180d</td><td>1.700 €</td><td>3.000 €</td><td>4.800 €</td></tr>
        <tr><td>Honda SH 125 (scooter)</td><td>750 €</td><td>1.300 €</td><td>2.200 €</td></tr>
      </tbody>
    </table>

    <p>
      <strong>Per durate &gt; 30 giorni</strong>: tariffe ancora più scontate, prezzi su preventivo personalizzato. Per durate &gt; 90 giorni offriamo formula <strong>"long-term rental"</strong> con condizioni tipo leasing breve (verifica documenti + caparra ridotta + tariffa flat mensile).
    </p>

    <h2>Cosa è incluso nel noleggio mensile</h2>

    <ul>
      <li><strong>Assicurazione RCA</strong> completa.</li>
      <li><strong>Assistenza stradale 24/7</strong> Sardegna intera (no Corsica).</li>
      <li><strong>Manutenzione di routine</strong>: cambio olio se km lo richiedono, controllo pneumatici, lavaggio mensile, ricarica climatizzatore.</li>
      <li><strong>Veicolo sostitutivo temporaneo</strong> durante interventi manutenzione (1-2 giorni).</li>
      <li><strong>Chilometraggio</strong>: 3.500 km/mese inclusi (115 km/giorno medi).</li>
      <li><strong>Consegna gratuita</strong>: aeroporto, porto, centro Olbia.</li>
      <li><strong>Cambio veicolo</strong>: 1 cambio gratuito durante il mese se le esigenze cambiano (es. Panda per primi 20 giorni, SUV per ultimi 10).</li>
    </ul>

    <p>
      <strong>Esclusi</strong>: carburante (consegnato pieno, restituito pieno), multe, pedaggi (zero in Sardegna nord comunque), franchigia kasko in caso danni.
    </p>

    <h2>Noleggio mensile vs acquisto usata per soggiorno breve</h2>

    <p>
      Una domanda che riceviamo spesso da chi resta 2-3 mesi: "<em>conviene noleggiare o comprare usata?</em>". Calcoli:
    </p>

    <ul>
      <li><strong>Auto usata media (es. Panda 2020 a Olbia)</strong>: 6.000-8.000 € + bollo + assicurazione 6 mesi (~500 €) + tagliando (~250 €) + tempo gestione vendita post = 7.000-9.000 € totali per 3 mesi.</li>
      <li><strong>Noleggio mensile KS Rent × 3 mesi</strong>: 2.400-4.500 € totali (bassa-media stagione).</li>
      <li><strong>Differenza</strong>: noleggio è <strong>40-60% più economico</strong> rispetto a comprare/rivendere.</li>
    </ul>

    <p>
      Aggiungere: zero rischio rottura imprevista, zero gestione documenti, zero rischio "non riesco a vendere", manutenzione inclusa. Per soggiorni &lt; 6 mesi noleggiare è sempre la scelta razionale.
    </p>

    <h2>Profilo cliente tipico noleggio mensile</h2>

    <ul>
      <li><strong>Smart worker remoto</strong>: lavora 4 giorni a settimana da B&B Costa Smeralda, ha 3 giorni liberi. Veicolo: Fiat Panda Hybrid (parcheggi facili, consumi minimi).</li>
      <li><strong>Famiglia agosto intero</strong>: villa privata vicino Porto Cervo, bambini, percorsi spiagge ogni giorno. Veicolo: Jeep Avenger (5 posti, automatic, bagagliaio capiente).</li>
      <li><strong>Coppia maturi pensionati ottobre</strong>: 30 giorni Gallura per evitare clima nord, ritmo lento. Veicolo: Mercedes Classe A 180d (comfort top, diesel economico).</li>
      <li><strong>Digital nomad influencer</strong>: produce contenuti, vuole macchina foto-genica. Veicolo: BMW M2 (su preventivo).</li>
      <li><strong>Professionista in trasferta cantiere</strong>: visita siti edili Gallura, settimana lavorativa. Veicolo: Jeep Avenger (luci alte per cantieri sterrati).</li>
    </ul>

    <h2>Documenti per noleggio mensile</h2>

    <p>
      Patente B valida da 1+ anno, documento identità, codice fiscale italiano O TIN paese origine. Caparra cauzionale leggermente più alta del weekend ma rateizzabile. <a href="/guide/noleggio-auto-olbia-senza-carta-di-credito-guida-completa">Noleggio anche senza carta di credito</a>: accettiamo bonifico, prepagate (Postepay, Revolut, N26, Hype, Wise), bancomat, contanti.
    </p>

    <h2>Richiedi quote personalizzata mensile</h2>

    <p>
      Per noleggi 30+ giorni preferiamo <strong>quote personalizzata WhatsApp</strong> perché ogni cliente ha esigenze diverse (km previsti, periodo esatto, veicolo, opzionali). Scrivi a <a href="https://wa.me/393446107071">+39 344 6107071</a> con: date inizio/fine, veicolo preferito, finalità (smart work, vacanza, ricerca casa). Ti rispondiamo entro 1 ora con preventivo nominale. Per durate &lt; 14 giorni vedi <a href="/guide/noleggio-auto-olbia-14-giorni-due-settimane">tariffe quindicinali</a>.
    </p>
  </GuideArticleLayout>
</BaseLayout>
