---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ChiSiamo, { chiSiamoFaqJsonLd } from "@/views/ChiSiamo";
import AboutCrawlerText from "@/components/AboutCrawlerText.astro";
import { buildBreadcrumb, personFrancescoMilo, personSalvatoreMilo } from "@/lib/jsonLd";
---
<BaseLayout
  title="Chi Siamo — KS Rent | Autonoleggio Olbia Sardegna"
  description="KS Rent Sardinia: autonoleggio premium con sede a Olbia, fondato l'8 aprile 2025. Flotta di proprietà, consegna in Costa Smeralda, deposito flessibile e senza carta di credito obbligatoria."
  canonical="https://www.ksrentsardinia.com/chisiamo"
  ogImage="https://zgytnkimjpoosvshfopz.supabase.co/storage/v1/object/public/asset/og/chisiamo.webp"
  jsonLd={[chiSiamoFaqJsonLd, personFrancescoMilo, personSalvatoreMilo, buildBreadcrumb("Chi Siamo", "/chisiamo")]}
>
  <AboutCrawlerText lang="it" />
  <ChiSiamo client:only="react" lang="it" />
</BaseLayout>
