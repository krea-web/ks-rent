---
/**
 * Pagina SEO multilingua per località e spiagge.
 * Genera /en/[slug], /de/[slug], /fr/[slug] usando le colonne
 * slug_en/de/fr e title_en/de/fr di seo_locations e seo_beaches.
 *
 * Filosofia: una pagina viene pubblicata in lingua X solo se title_X
 * NON è null. Slug nella lingua X = slug_X (può divergere dall'IT).
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import CompanyMap from "@/components/CompanyMap";
import { supabase } from "@/lib/supabase";
import { buildLocationJsonLd, buildBeachJsonLd } from "@/lib/jsonLd";
import { getLocalitySEOContent } from "@/data/locality-content";
import { getFleetPath, localizeVehicleSlug } from "@/lib/i18n";
import { getDict } from "@/i18n";
import { getRecommendedVehicle } from "@/lib/dynamic-page-helpers";
import { ArrowRight, MapPin, Info, ShieldCheck, Navigation, Users, Gauge, Fuel, Star } from "lucide-react";
import DOMPurify from "isomorphic-dompurify";

interface SeoRow {
  slug: string;
  title: string;
  h1: string;
  meta_description: string;
  hero_image_url?: string;
  content_html?: string;
  parking_info?: string;
  canonical_url?: string;
  og_image_url?: string;
  slug_en?: string | null;
  title_en?: string | null;
  h1_en?: string | null;
  meta_description_en?: string | null;
  content_html_en?: string | null;
  slug_de?: string | null;
  title_de?: string | null;
  h1_de?: string | null;
  meta_description_de?: string | null;
  content_html_de?: string | null;
  slug_fr?: string | null;
  title_fr?: string | null;
  h1_fr?: string | null;
  meta_description_fr?: string | null;
  content_html_fr?: string | null;
}

type Lang = "en" | "de" | "fr";

export async function getStaticPaths() {
  const [locRes, beachRes] = await Promise.all([
    supabase.from("seo_locations").select("*"),
    supabase.from("seo_beaches").select("*"),
  ]);

  if (locRes.error) console.warn("[lang/slug] seo_locations:", locRes.error.message);
  if (beachRes.error) console.warn("[lang/slug] seo_beaches:", beachRes.error.message);

  const locs = (locRes.data || []) as SeoRow[];
  const beaches = (beachRes.data || []) as SeoRow[];

  const paths: any[] = [];
  const langs: Lang[] = ["en", "de", "fr"];

  for (const lang of langs) {
    for (const row of locs) {
      const localizedSlug = (row as any)[`slug_${lang}`];
      const localizedTitle = (row as any)[`title_${lang}`];
      // Pubblica solo se ENTRAMBI slug e title della lingua sono presenti
      if (localizedSlug && localizedTitle) {
        paths.push({
          params: { lang, slug: localizedSlug },
          props: { row, type: "location" as const, lang },
        });
      }
    }
    for (const row of beaches) {
      const localizedSlug = (row as any)[`slug_${lang}`];
      const localizedTitle = (row as any)[`title_${lang}`];
      if (localizedSlug && localizedTitle) {
        paths.push({
          params: { lang, slug: localizedSlug },
          props: { row, type: "beach" as const, lang },
        });
      }
    }
  }

  return paths;
}

const { row, type, lang } = Astro.props as { row: SeoRow; type: "location" | "beach"; lang: Lang };
const t = getDict(lang).dynamicPage;

const localized = {
  slug: (row as any)[`slug_${lang}`] as string,
  title: (row as any)[`title_${lang}`] as string,
  h1: (row as any)[`h1_${lang}`] || (row as any)[`title_${lang}`],
  meta_description: (row as any)[`meta_description_${lang}`] || row.meta_description,
  content_html: (row as any)[`content_html_${lang}`] || row.content_html || "",
  parking_info: (row as any)[`parking_info_${lang}`] || row.parking_info || "",
};

const seoContent = getLocalitySEOContent(row.slug);
const vehicle = getRecommendedVehicle(row.slug);

// Traduci label tecniche veicolo se in IT (Automatico/Manuale + Benzina/Diesel).
const localizedTransmission = vehicle.transmission
  .replace(/^Automatico/, t.transmissionAutomatic)
  .replace(/^Manuale/, t.transmissionManual);
const localizedFuel = (t.fuel as Record<string, string>)[vehicle.fuel] || vehicle.fuel;

// JSON-LD basata sui dati IT (con title localizzato come override)
const jsonLdSource = {
  ...row,
  title: localized.title,
  h1: localized.h1,
  meta_description: localized.meta_description,
  slug: localized.slug,
};
const jsonLd =
  type === "beach"
    ? buildBeachJsonLd(jsonLdSource as any, seoContent.faqs)
    : buildLocationJsonLd(jsonLdSource as any, seoContent.faqs);

const safeContentHtml = localized.content_html
  ? DOMPurify.sanitize(
      localized.content_html.replace(/<h1(\s|>)/gi, "<h2$1").replace(/<\/h1>/gi, "</h2>"),
    )
  : "";

const eyebrow = type === "location" ? t.eyebrowLocation : t.eyebrowBeach;
const vehicleEyebrow = t.vehicleEyebrow;
const vehicleHeading = t.vehicleHeading;
const mapEyebrow = t.mapEyebrow;
const mapHeading = type === "beach" ? t.mapHeadingBeach : t.mapHeadingLocation;
const mapIntro = type === "beach" ? t.mapIntroBeach : t.mapIntroLocation;
const parkingHeading = t.parkingHeading;
const localizedVehicleSlug = localizeVehicleSlug(vehicle.groupSlug, lang);

const canonicalUrl = `https://www.ksrentsardinia.com/${lang}/${localized.slug}`;
---
<BaseLayout
  title={localized.title}
  description={localized.meta_description}
  canonical={canonicalUrl}
  ogImage={row.og_image_url}
  jsonLd={jsonLd}
  breadcrumbs={[{ name: localized.title, path: `/${lang}/${localized.slug}` }]}
>
  <div class="bg-background min-h-screen">
    {/* HERO */}
    <section class="relative min-h-[60vh] flex items-end overflow-hidden">
      {row.hero_image_url && (
        <div class="absolute inset-0">
          <img
            src={row.hero_image_url}
            alt={localized.h1}
            class="w-full h-full object-cover"
            loading="eager"
            fetchpriority="high"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-background via-background/70 to-transparent"></div>
        </div>
      )}

      <div class="relative z-10 w-full max-w-7xl mx-auto px-4 md:px-12 pb-16 pt-32">
        <span class="inline-flex items-center gap-2 text-gold font-bold tracking-[0.3em] uppercase text-[10px] mb-4">
          <MapPin className="w-3.5 h-3.5" />
          {eyebrow}
        </span>
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-black italic uppercase tracking-tighter text-foreground leading-[0.95]">
          {localized.h1}
        </h1>
        <p class="mt-6 text-lg md:text-xl text-foreground/70 font-light max-w-2xl leading-relaxed">
          {localized.meta_description}
        </p>
      </div>
    </section>

    {/* CONTENT */}
    <section class="py-16 px-4 md:px-12 max-w-4xl mx-auto">
      {safeContentHtml ? (
        <div
          class="prose dark:prose-invert prose-lg max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-foreground prose-p:text-foreground/80 prose-p:font-light prose-p:leading-relaxed prose-strong:text-foreground prose-strong:font-semibold prose-a:text-gold hover:prose-a:text-gold/80"
          set:html={safeContentHtml}
        />
      ) : (
        <div class="text-center py-12">
          <p class="text-muted-foreground font-light text-lg leading-relaxed max-w-xl mx-auto">
            {t.noContent}
          </p>
        </div>
      )}

      {type === "beach" && localized.parking_info && (
        <div class="mt-12 bg-card border border-border rounded-2xl p-8">
          <div class="flex items-center gap-3 mb-4">
            <Info className="w-5 h-5 text-gold" />
            <h2 class="text-xl font-bold text-foreground">{parkingHeading}</h2>
          </div>
          <p class="text-foreground/70 font-light leading-relaxed">{localized.parking_info}</p>
        </div>
      )}
    </section>

    {/* VEICOLO CONSIGLIATO */}
    <section class="py-20 px-4 md:px-12">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <span class="text-gold font-bold tracking-[0.3em] uppercase text-[10px]">{vehicleEyebrow}</span>
          <h2 class="text-3xl md:text-5xl font-black italic uppercase tracking-tighter text-foreground mt-2">
            {vehicleHeading}
          </h2>
        </div>

        <div class="relative bg-card border border-border rounded-[2rem] overflow-hidden">
          <div class="grid md:grid-cols-2 gap-0">
            <div class="relative flex items-center justify-center p-8 md:p-12 bg-gradient-to-br from-card to-background min-h-[300px]">
              <img src={vehicle.image} alt={vehicle.name} class="w-full max-w-md object-contain drop-shadow-2xl" loading="lazy" />
            </div>
            <div class="p-8 md:p-12 flex flex-col justify-center">
              <span class="text-gold text-xs font-bold tracking-[0.2em] uppercase">{vehicle.category}</span>
              <h3 class="text-2xl md:text-3xl font-black italic uppercase tracking-tight text-foreground mt-1">
                {vehicle.name}
              </h3>
              <div class="grid grid-cols-2 gap-4 mt-8">
                <div class="flex items-center gap-3">
                  <Gauge className="w-4 h-4 text-gold" />
                  <span class="text-foreground/70 text-sm">{localizedTransmission}</span>
                </div>
                <div class="flex items-center gap-3">
                  <Users className="w-4 h-4 text-gold" />
                  <span class="text-foreground/70 text-sm">{vehicle.seats} {t.seatsLabel}</span>
                </div>
                <div class="flex items-center gap-3">
                  <Fuel className="w-4 h-4 text-gold" />
                  <span class="text-foreground/70 text-sm">{localizedFuel}</span>
                </div>
                <div class="flex items-center gap-3">
                  <Star className="w-4 h-4 text-gold" />
                  <span class="text-foreground/70 text-sm">{t.insuredLabel}</span>
                </div>
              </div>
              <a
                href={`/${lang}${getFleetPath(lang)}/${localizedVehicleSlug}`}
                class="mt-10 inline-flex items-center justify-center gap-3 bg-gold text-background font-bold uppercase tracking-wider text-sm px-8 py-4 rounded-full hover:scale-105 transition-transform"
              >
                {t.discoverVehicle}
                <ArrowRight className="w-4 h-4" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* MAPPA */}
    <section class="py-20 px-4 md:px-12 bg-card">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-12">
          <span class="text-gold font-bold tracking-[0.3em] uppercase text-[10px]">
            <Navigation className="w-3.5 h-3.5 inline mr-2" />
            {mapEyebrow}
          </span>
          <h2 class="text-3xl md:text-5xl font-black italic uppercase tracking-tighter text-foreground mt-2">
            {mapHeading}
          </h2>
          <p class="text-foreground/60 font-light mt-4 max-w-xl mx-auto leading-relaxed">{mapIntro}</p>
        </div>
        <CompanyMap client:visible targetLocation={localized.title} />
      </div>
    </section>

    {/* CTA */}
    <section class="py-20 px-4 md:px-12">
      <div class="max-w-3xl mx-auto text-center">
        <ShieldCheck className="w-12 h-12 text-gold mx-auto mb-6" />
        <h2 class="text-3xl md:text-5xl font-black italic uppercase tracking-tighter text-foreground mb-4">
          {t.readyForPrefix} {localized.title}?
        </h2>
        <a
          href={`/${lang}/${lang === "en" ? "book-now" : lang === "de" ? "jetzt-buchen" : "reserver"}`}
          class="inline-flex items-center gap-3 bg-gold text-background font-bold uppercase tracking-wider text-sm px-12 py-5 rounded-full hover:scale-105 transition-transform shadow-lg"
        >
          {t.bookNowCta}
          <ArrowRight className="w-4 h-4" />
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
