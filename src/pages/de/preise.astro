---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { supabase } from "@/lib/supabase";
import RelatedGuides from "@/components/RelatedGuides.astro";
import { ArrowRight, ShieldCheck, Calendar, CreditCard, CheckCircle2 } from "lucide-react";

interface VehicleRow {
  make: string;
  model: string;
  category: string;
  group_slug: string | null;
  is_primary_variant: boolean | null;
  is_archived: boolean | null;
  transparent_image_url: string | null;
  image_url: string | null;
  daily_rate: number | null;
  rate_april: number | null;
  rate_may: number | null;
  rate_june: number | null;
  rate_july: number | null;
  rate_august: number | null;
  rate_september: number | null;
  rate_october: number | null;
}

interface SeoVehicleRow {
  group_slug: string;
  title: string | null;
}

const [vehRes, seoRes] = await Promise.all([
  supabase
    .from("vehicles")
    .select("*")
    .or("is_archived.is.null,is_archived.eq.false")
    .order("category"),
  supabase.from("seo_vehicles").select("group_slug, title"),
]);

const allVehicles = (vehRes.data || []) as VehicleRow[];
const seoMap = new Map<string, SeoVehicleRow>();
for (const s of (seoRes.data || []) as SeoVehicleRow[]) {
  seoMap.set(s.group_slug, s);
}

// Raggruppa per group_slug, prendi primary variant
const groupsMap = new Map<string, { primary: VehicleRow; rates: Record<string, number | null>; image: string | null; title: string }>();
for (const v of allVehicles) {
  const slug = v.group_slug || `${v.make}-${v.model}`.toLowerCase().replace(/[^a-z0-9]+/g, "-");
  if (!groupsMap.has(slug) || v.is_primary_variant) {
    const seo = seoMap.get(slug);
    groupsMap.set(slug, {
      primary: v,
      rates: {
        rate_april: v.rate_april,
        rate_may: v.rate_may,
        rate_june: v.rate_june,
        rate_july: v.rate_july,
        rate_august: v.rate_august,
        rate_september: v.rate_september,
        rate_october: v.rate_october,
      },
      image: v.transparent_image_url || v.image_url,
      title: seo?.title || `${v.make} ${v.model}`,
    });
  }
}

const groups = Array.from(groupsMap.entries())
  .map(([slug, g]) => ({ slug, ...g }))
  .sort((a, b) => a.primary.category.localeCompare(b.primary.category));

const MONTHS = [
  { key: "rate_april", label: "April" },
  { key: "rate_may", label: "Mai" },
  { key: "rate_june", label: "Juni" },
  { key: "rate_july", label: "Juli" },
  { key: "rate_august", label: "August" },
  { key: "rate_september", label: "September" },
  { key: "rate_october", label: "Oktober" },
] as const;

// Categorie per raggruppare visivamente
const byCategory = new Map<string, typeof groups>();
for (const g of groups) {
  const cat = g.primary.category;
  if (!byCategory.has(cat)) byCategory.set(cat, []);
  byCategory.get(cat)!.push(g);
}

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "PriceSpecification",
    name: "Saisonpreise Autovermietung KS Rent Sardinia",
    description: "Offizielle, aktualisierte Preise für die Vermietung von Pkw, Rollern und Quads an der Costa Smeralda.",
    priceCurrency: "EUR",
    validFrom: `${new Date().getFullYear()}-04-01`,
    validThrough: `${new Date().getFullYear()}-10-31`,
  },
];
---
<BaseLayout
  title="Preise Autovermietung Olbia | Monatspreise — KS Rent Sardinia"
  description="Transparente Preise für die Autovermietung in Olbia: Monatspreise von April bis Oktober für jedes Fahrzeug. Audi RS3, BMW M2, Jeep Avenger, Fiat Panda, Roller und Quads."
  canonical="https://www.ksrentsardinia.com/de/preise"
  jsonLd={jsonLd}
  breadcrumbs={[{ name: "Preise", path: "/de/preise" }]}
>
  <div class="bg-background min-h-screen">
    {/* HERO */}
    <section class="relative overflow-hidden border-b border-border">
      <div class="absolute inset-0 bg-gradient-to-br from-card via-background to-card pointer-events-none"></div>
      <div class="absolute -top-20 -right-20 w-96 h-96 bg-gold/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative max-w-5xl mx-auto px-4 md:px-12 pt-32 pb-16 text-center">
        <span class="inline-flex items-center gap-2 text-gold font-bold tracking-[0.3em] uppercase text-[10px] mb-4">
          <Calendar className="w-3.5 h-3.5" />
          Offizielle Preisliste {new Date().getFullYear()}
        </span>
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-black italic uppercase tracking-tighter text-foreground leading-[0.95]">
          Preise Autovermietung Olbia
        </h1>
        <p class="mt-6 text-lg md:text-xl text-foreground/70 font-light max-w-2xl mx-auto leading-relaxed">
          Transparente Preise für jedes Fahrzeug, von April bis Oktober. Ohne Kreditkartenpflicht, ohne Überraschungen, ohne versteckte Gebühren.
        </p>

        <div class="mt-10 flex flex-wrap items-center justify-center gap-4 text-xs text-foreground/60">
          <span class="flex items-center gap-2"><CheckCircle2 className="w-4 h-4 text-gold" /> Kostenlose Lieferung</span>
          <span class="flex items-center gap-2"><CreditCard className="w-4 h-4 text-gold" /> Ohne Kreditkarte</span>
          <span class="flex items-center gap-2"><ShieldCheck className="w-4 h-4 text-gold" /> Versicherung inklusive</span>
        </div>
      </div>
    </section>

    {/* TARIFFE PER CATEGORIA */}
    {Array.from(byCategory.entries()).map(([category, catGroups]) => (
      <section class="py-12 md:py-16 px-4 md:px-12 border-b border-border last:border-0">
        <div class="max-w-6xl mx-auto">
          <div class="mb-8">
            <span class="text-gold font-bold tracking-[0.3em] uppercase text-[10px]">Kategorie</span>
            <h2 class="text-3xl md:text-4xl font-black italic uppercase tracking-tighter text-foreground mt-1">
              {category}
            </h2>
          </div>

          <div class="bg-card border border-border rounded-2xl overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full text-sm min-w-[680px]">
                <thead class="bg-background/50 border-b border-border">
                  <tr>
                    <th class="px-4 py-4 text-left text-xs uppercase tracking-wider text-foreground/50 font-bold min-w-[200px]">
                      Fahrzeug
                    </th>
                    {MONTHS.map((m) => (
                      <th class="px-3 py-4 text-center text-xs uppercase tracking-wider text-foreground/50 font-bold">
                        {m.label.slice(0, 3)}
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {catGroups.map((g) => {
                    const validRates = MONTHS.map((m) => g.rates[m.key]).filter((r): r is number => typeof r === "number" && r > 0);
                    const minRate = validRates.length ? Math.min(...validRates) : null;
                    return (
                      <tr class="border-b border-border/50 last:border-0 hover:bg-background/30 transition-colors">
                        <td class="px-4 py-4">
                          <a href={`/de/fuhrpark/${g.slug}`} class="flex items-center gap-3 group">
                            {g.image && (
                              <img
                                src={g.image}
                                alt={g.title}
                                class="w-14 h-14 object-contain bg-background rounded-lg p-1 shrink-0"
                                loading="lazy"
                              />
                            )}
                            <div>
                              <p class="font-bold text-foreground group-hover:text-gold transition-colors">
                                {g.title}
                              </p>
                              {minRate && (
                                <p class="text-xs text-foreground/50 mt-0.5">ab €{minRate}/Tag</p>
                              )}
                            </div>
                          </a>
                        </td>
                        {MONTHS.map((m) => {
                          const rate = g.rates[m.key];
                          return (
                            <td class="px-3 py-4 text-center">
                              {rate ? (
                                <span class="text-gold font-bold">€{rate}</span>
                              ) : (
                                <span class="text-foreground/30">—</span>
                              )}
                            </td>
                          );
                        })}
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>
    ))}

    {groups.length === 0 && (
      <section class="py-20 px-4 text-center">
        <p class="text-foreground/60 text-lg">
          Preisliste wird aktualisiert. Kontaktieren Sie uns direkt für ein persönliches Angebot.
        </p>
      </section>
    )}

    {/* KASKO-SELBSTBETEILIGUNG & KAUTION — Kontakt */}
    <section class="py-12 md:py-16 px-4 md:px-12 bg-background border-t border-border">
      <div class="max-w-4xl mx-auto">
        <span class="block text-gold font-bold tracking-[0.3em] uppercase text-[10px] mb-3">Versicherungstransparenz</span>
        <h2 class="text-2xl md:text-3xl font-black italic uppercase tracking-tighter text-foreground mb-3">
          Kasko-Selbstbeteiligung und Kaution
        </h2>
        <p class="text-foreground/70 font-light mb-8 leading-relaxed">
          Kasko-Selbstbeteiligung und Kaution variieren je nach Fahrzeugkategorie (Kleinwagen, SUV/Premium, Sportwagen, Roller oder Quads) und Mietdauer. <strong>Kontaktieren Sie uns auf WhatsApp</strong>, um den genauen Betrag der Selbstbeteiligung und Kaution fuer das Fahrzeug Ihrer Wahl zu erhalten, einschliesslich der bei Abholung verfuegbaren <strong>Selbstbeteiligungsreduzierungsoptionen</strong>.
        </p>

        <div class="bg-card border border-border rounded-2xl p-6 md:p-8">
          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-5">
            <div>
              <h3 class="font-bold text-foreground text-lg mb-2">Details zu Selbstbeteiligung und Kaution anfragen</h3>
              <p class="text-sm text-foreground/70 leading-relaxed">
                Antwort innerhalb eines Tages, 7 Tage die Woche. Die Betraege werden schriftlich im Angebot und im unterzeichneten Vertrag bestaetigt und <em>nur</em> bei kontradiktorisch dokumentierten Schaeden berechnet.
              </p>
            </div>
            <a
              href="https://wa.me/393446107071?text=Hallo%20KS%20Rent%2C%20ich%20haette%20gerne%20detaillierte%20Informationen%20zur%20Kasko-Selbstbeteiligung%20und%20Kaution%20fuer%20das%20Fahrzeug%2C%20das%20mich%20interessiert.%20Danke!"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 bg-[#25D366] text-white font-semibold tracking-wide text-sm px-6 py-3.5 rounded-full hover:scale-105 transition-transform shadow-lg whitespace-nowrap shrink-0"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.262.489 1.693.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
              </svg>
              Auf WhatsApp anfragen
            </a>
          </div>
        </div>

        <p class="text-xs text-foreground/55 mt-6 leading-relaxed">
          Die Kaution wird bei Fahrzeugrueckgabe vollstaendig zurueckerstattet, ausser bei ausstehenden Schaeden oder Strafen. Details siehe unsere <a href="/de/agb" class="text-gold hover:underline">Allgemeinen Geschaeftsbedingungen</a>.
        </p>
      </div>
    </section>

    {/* INFO LISTINO */}
    <section class="py-16 md:py-20 px-4 md:px-12 bg-card">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-black italic uppercase tracking-tighter text-foreground text-center mb-10">
          So funktioniert unsere Preisliste
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-background border border-border rounded-2xl p-6">
            <Calendar className="w-8 h-8 text-gold mb-4" />
            <h3 class="font-bold text-foreground mb-2">Saisonpreise</h3>
            <p class="text-foreground/60 text-sm font-light leading-relaxed">
              April und Oktober sind die günstigsten Monate. Juli und August sind Hochsaison: Buchen Sie rechtzeitig, um sich Ihr Fahrzeug zu sichern.
            </p>
          </div>
          <div class="bg-background border border-border rounded-2xl p-6">
            <CreditCard className="w-8 h-8 text-gold mb-4" />
            <h3 class="font-bold text-foreground mb-2">Ohne Kreditkarte</h3>
            <p class="text-foreground/60 text-sm font-light leading-relaxed">
              Wir akzeptieren Bankkarte, Prepaid (PostePay, Revolut, N26) und Bargeld als Kaution. Keine Kartensperrung.
            </p>
          </div>
          <div class="bg-background border border-border rounded-2xl p-6">
            <ShieldCheck className="w-8 h-8 text-gold mb-4" />
            <h3 class="font-bold text-foreground mb-2">Alles inklusive</h3>
            <p class="text-foreground/60 text-sm font-light leading-relaxed">
              Die Preise enthalten Versicherung, unbegrenzte Kilometer und kostenlose Lieferung in ganz Gallura. Keine versteckten Gebühren.
            </p>
          </div>
        </div>
      </div>
    </section>
    <RelatedGuides lang="de" itSlugs={["quanto-costa-vacanza-costa-smeralda-budget-2026", "noleggio-auto-olbia-senza-carta-di-credito-guida-completa", "noleggio-scooter-quad-sardegna-come-scegliere"]} />


    {/* CTA FINALE su sfondo ORO */}
    <section class="relative bg-gold text-background py-20 md:py-24 text-center px-4 md:px-12 overflow-hidden">
      <div class="absolute inset-0 opacity-[0.07] mix-blend-overlay pointer-events-none bg-[radial-gradient(circle_at_20%_20%,#000_2px,transparent_2px),radial-gradient(circle_at_60%_70%,#000_1px,transparent_1px)] bg-[length:32px_32px,18px_18px]"></div>
      <div class="relative max-w-3xl mx-auto">
        <h2 class="font-serif text-3xl md:text-5xl text-background font-medium mb-5 leading-tight">
          Bereit zu buchen?
        </h2>
        <p class="font-serif text-background/85 text-[17px] md:text-lg leading-relaxed max-w-xl mx-auto mb-10">
          Bestätigen Sie die Preise für Ihre Daten und wählen Sie das passende Fahrzeug für Ihren Urlaub an der Costa Smeralda.
        </p>
        <a
          href="/de/jetzt-buchen"
          class="inline-flex items-center gap-2 bg-background text-foreground font-semibold tracking-wide text-sm px-10 py-4 rounded-full hover:scale-105 transition-transform shadow-xl ring-1 ring-background/20"
        >
          Verfügbarkeit prüfen
          <ArrowRight className="w-4 h-4" />
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
