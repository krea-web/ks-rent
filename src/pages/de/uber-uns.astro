---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ChiSiamo, { chiSiamoFaqJsonLd } from "@/views/ChiSiamo";
import AboutCrawlerText from "@/components/AboutCrawlerText.astro";
import { buildBreadcrumb, personFrancescoMilo, personSalvatoreMilo } from "@/lib/jsonLd";
---
<BaseLayout
  title="Über uns — KS Rent | Autovermietung Olbia Sardinien"
  description="KS Rent Sardinia: Premium-Autovermietung mit Sitz in Olbia. Eigener Fuhrpark, Lieferung an die Haustür an der Costa Smeralda, flexible Kaution und ohne Kreditkartenpflicht."
  canonical="https://www.ksrentsardinia.com/de/uber-uns"
  ogImage="https://zgytnkimjpoosvshfopz.supabase.co/storage/v1/object/public/asset/og/chisiamo.webp"
  jsonLd={[chiSiamoFaqJsonLd, personFrancescoMilo, personSalvatoreMilo, buildBreadcrumb("Über uns", "/de/uber-uns")]}
>
  <AboutCrawlerText lang="de" />
  <ChiSiamo client:only="react" lang="de" />
</BaseLayout>
