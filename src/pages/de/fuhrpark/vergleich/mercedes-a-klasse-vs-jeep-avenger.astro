---
import BaseLayout from "@/layouts/BaseLayout.astro";
import VehicleComparison from "@/components/VehicleComparison.astro";
import { getTranslatedSpec } from "@/data/vehicle-specs-i18n";

const lang = "de" as const;
const a = getTranslatedSpec("mercedes-classe-a", lang);
const b = getTranslatedSpec("jeep-avenger", lang);

const h1 = "Mercedes A-Klasse vs Jeep Avenger: Premium oder SUV fuer Sardinien?";
const intro =
  "Mercedes A-Klasse 180d und Jeep Avenger sind zwei mittlere Optionen der Autovermietung in Olbia, beide mit Automatikgetriebe und geeignet fuer Paare und Familien. Die A-Klasse 180d ist ein Premium-Diesel-Kompaktwagen mit 116 PS und 4,5 L/100km Verbrauch, ideal fuer komfortable Autobahn-Touren und fuer alle, die Mercedes-Eleganz suchen. Der Jeep Avenger ist ein Benzin-Kompakt-SUV mit 100 PS und 6,1 L/100km Verbrauch, erhoehte Sitzposition und groessere Vielseitigkeit fuer Straende, die nur ueber Schotter erreichbar sind. Beide ab 60-90 €/Tag in der Nebensaison und erreichen 110-160 €/Tag in der Hochsaison. Die Wahl haengt von der Art der Reise ab: Autobahnkomfort und historische Zentren (Mercedes A) oder Offroad-Flexibilitaet und Familiengepaeck (Jeep Avenger).";

const pageUrl = "https://www.ksrentsardinia.com/de/fuhrpark/vergleich/mercedes-a-klasse-vs-jeep-avenger";
const jsonLd = [{
  "@context": "https://schema.org", "@type": "WebPage", "@id": `${pageUrl}#page`,
  name: h1, description: intro.slice(0, 220), url: pageUrl, inLanguage: "de-DE",
  isPartOf: { "@id": "https://www.ksrentsardinia.com/#website" },
  primaryImageOfPage: a.image,
  about: [
    { "@type": "Vehicle", name: a.name, brand: { "@type": "Brand", name: a.brand }, url: `https://www.ksrentsardinia.com${a.href}`, image: a.image, vehicleConfiguration: a.category },
    { "@type": "Vehicle", name: b.name, brand: { "@type": "Brand", name: b.brand }, url: `https://www.ksrentsardinia.com${b.href}`, image: b.image, vehicleConfiguration: b.category },
  ],
}];
---
<BaseLayout
  title="Mercedes A-Klasse vs Jeep Avenger Olbia: Premium oder SUV?"
  description="Vergleich Mercedes A-Klasse 180d Diesel vs Jeep Avenger SUV: Verbrauch, Komfort, Offroad, Preise. Welcher Mietwagen in Olbia waehlen."
  canonical={pageUrl}
  jsonLd={jsonLd}
  breadcrumbs={[{ name: "Fuhrpark", path: "/de/fuhrpark" }, { name: "Mercedes A-Klasse vs Jeep Avenger", path: "/de/fuhrpark/vergleich/mercedes-a-klasse-vs-jeep-avenger" }]}
>
  <VehicleComparison a={a} b={b} h1={h1} intro={intro} lang={lang} />
</BaseLayout>
