---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroSection from "@/components/HeroSection";
import TrustMarquee from "@/components/TrustMarquee";
import TopBeachesShowcase from "@/components/TopBeachesShowcase.astro";
import FleetShowcase from "@/components/FleetShowcase";
import GuideSpotlight from "@/components/GuideSpotlight.astro";
import FAQSection from "@/components/FAQSection";
import GoogleReviews from "@/components/GoogleReviews";
import { supabase } from "@/lib/supabase";
import { getAggregateRating, getTopReviewsForSchema } from "@/lib/reviews";

// Fetch reviews al build-time da Supabase
const { data: reviewsData } = await supabase
  .from("reviews")
  .select("author_name, author_photo_url, rating, text, published_at, is_featured")
  .eq("is_published", true)
  .order("is_featured", { ascending: false })
  .order("published_at", { ascending: false })
  .limit(3);

const { count: reviewsCount } = await supabase
  .from("reviews")
  .select("id", { count: "exact", head: true })
  .eq("is_published", true);

const { data: avgData } = await supabase
  .from("reviews")
  .select("rating")
  .eq("is_published", true);

const averageRating = avgData && avgData.length > 0
  ? avgData.reduce((s, r) => s + r.rating, 0) / avgData.length
  : null;

const aggregateAuth = await getAggregateRating();
const topReviewSchemas = await getTopReviewsForSchema(5);

const reviewsLdExtension = topReviewSchemas.length >= 3
  ? {
      "@context": "https://schema.org",
      "@type": ["AutoRental", "LocalBusiness"],
      "@id": "https://www.ksrentsardinia.com/#organization",
      review: topReviewSchemas,
    }
  : null;
---
<BaseLayout
  title="Autovermietung Olbia | Mietwagen Costa Smeralda — KS Rent"
  description="Autovermietung in Olbia mit Lieferung an die Haustür an der Costa Smeralda. SUVs, Supersportwagen und Kleinwagen ohne Kreditkarte. Online buchen mit KS Rent Sardinia."
  canonical="https://www.ksrentsardinia.com/de/"
  ogImage="https://zgytnkimjpoosvshfopz.supabase.co/storage/v1/object/public/asset/og/home.webp"
  includeGlobalFaq={true}
  aggregateRating={aggregateAuth ?? undefined}
  jsonLd={reviewsLdExtension ? [reviewsLdExtension] : []}
>
  <HeroSection lang="de" />
  <TrustMarquee lang="de" />
  <FleetShowcase lang="de" client:visible />
  <TopBeachesShowcase lang="de" />
  <GuideSpotlight lang="de" />
  <FAQSection lang="de" />
  <GoogleReviews
    reviews={reviewsData || []}
    totalCount={reviewsCount || 0}
    averageRating={averageRating ?? undefined}
    client:visible
  />

  {/* SEO RICH TEXT statico — letto direttamente da Google senza JS */}
  <section class="py-16 md:py-20 px-4 md:px-12 bg-background">
    <div class="editorial mx-auto">
    <h2>Autovermietung Olbia — Ihr Mietwagen-Partner Ihres Vertrauens</h2>
    <p class="mb-4">
      Suchen Sie eine <strong>Autovermietung in Olbia</strong>? KS Rent Sardinia ist die <strong>Autovermietung in Olbia</strong> Ihrer Wahl,
      wenn Sie Nordost-Sardinien ohne Einschränkungen erkunden möchten. Wir liefern SUVs, Supersportwagen, Kleinwagen,
      Motorräder und Quads direkt an den
      <a href="/de/autovermietung-hafen-olbia">Hafen von Olbia</a>,
      an den <a href="/de/autovermietung-flughafen-olbia">Flughafen Olbia Costa Smeralda</a>,
      zu Ihrem Hotel oder zu Ihrer Villa — täglich von 10:00 bis 22:30 Uhr, 7 Tage die Woche.
    </p>
    <p class="mb-4">
      <strong>
        Wir sind ein stolz und ausschließlich sardisches Unternehmen (USt-IdNr. 03028900904), vollständig unabhängig
        und nicht verbunden mit anderen gleichnamigen Gesellschaften, die im übrigen Italien tätig sind.
      </strong>
      Wir sind kein klassischer Autoverleih oder Online-Vermittler: Unser Fuhrpark gehört uns selbst — Audi RS3, BMW M2,
      Mercedes A-Klasse, Jeep Avenger, Fiat Panda, Honda SH — und wir bereiten ihn akribisch für jeden Kunden vor.
    </p>
    <p class="mb-4">
      Unsere <strong>Autovermietung in Olbia</strong> hebt sich durch einen konkreten Vorteil ab: Wir akzeptieren Bankkarte,
      Prepaid und Bargeld als Kaution. Keine Kreditkartenpflicht, keine Kartensperrung,
      keine Überraschungen.
      <a href="/de/autovermietung-ohne-kreditkarte-olbia">Entdecken Sie die Vermietung ohne Kreditkarte</a>.
    </p>

    <h3>Lieferung an die Haustür in ganz Gallura und an der Costa Smeralda</h3>
    <p class="mb-4">
      Der <strong>Mietwagen-Service in Olbia</strong> von KS Rent deckt ganz Gallura flächendeckend ab. Wir liefern an die meistgefragten Orte:
      <a href="/de/noleggio-auto-porto-cervo">Porto Cervo</a>,
      <a href="/de/noleggio-auto-san-teodoro">San Teodoro</a>,
      <a href="/de/noleggio-auto-baja-sardinia">Baja Sardinia</a>,
      <a href="/de/noleggio-auto-palau">Palau</a>,
      <a href="/de/noleggio-auto-porto-rotondo">Porto Rotondo</a>,
      <a href="/de/noleggio-auto-budoni">Budoni</a> und die
      <a href="/de/autovermietung-costa-smeralda">Costa Smeralda</a>.
      Ihre <strong>Autovermietung in Olbia</strong> beginnt in dem Moment, in dem Sie landen oder von der Fähre gehen.
    </p>

    <h3>Die schönsten Strände bequem mit dem Auto</h3>
    <p class="mb-4">
      Mit einem SUV von KS Rent erreichen Sie auch die versteckten Buchten Nordost-Sardiniens:
      <a href="/de/spiaggia-del-principe">Spiaggia del Principe</a>,
      <a href="/de/cala-brandinchi">Cala Brandinchi</a>,
      <a href="/de/la-cinta">La Cinta</a>,
      <a href="/de/capriccioli">Capriccioli</a> und
      <a href="/de/porto-istana">Porto Istana</a> mit Blick auf Tavolara.
      Für Strände mit Schotterpiste empfehlen wir den Jeep Avenger; für die Panoramastraßen entlang der Küste den Audi RS3 oder den BMW M2.
    </p>
      </div>
  </section>
</BaseLayout>
