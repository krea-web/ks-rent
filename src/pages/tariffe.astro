---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { supabase } from "@/lib/supabase";
import RelatedGuides from "@/components/RelatedGuides.astro";
import { ArrowRight, ShieldCheck, Calendar, CreditCard, CheckCircle2 } from "lucide-react";
import { serviceCatalogJsonLd, buildBreadcrumb } from "@/lib/jsonLd";

interface VehicleRow {
  make: string;
  model: string;
  category: string;
  group_slug: string | null;
  is_primary_variant: boolean | null;
  is_archived: boolean | null;
  transparent_image_url: string | null;
  image_url: string | null;
  daily_rate: number | null;
  rate_april: number | null;
  rate_may: number | null;
  rate_june: number | null;
  rate_july: number | null;
  rate_august: number | null;
  rate_september: number | null;
  rate_october: number | null;
}

interface SeoVehicleRow {
  group_slug: string;
  title: string | null;
}

const [vehRes, seoRes] = await Promise.all([
  supabase
    .from("vehicles")
    .select("*")
    .or("is_archived.is.null,is_archived.eq.false")
    .order("category"),
  supabase.from("seo_vehicles").select("group_slug, title"),
]);

const allVehicles = (vehRes.data || []) as VehicleRow[];
const seoMap = new Map<string, SeoVehicleRow>();
for (const s of (seoRes.data || []) as SeoVehicleRow[]) {
  seoMap.set(s.group_slug, s);
}

// Raggruppa per group_slug, prendi primary variant
const groupsMap = new Map<string, { primary: VehicleRow; rates: Record<string, number | null>; image: string | null; title: string }>();
for (const v of allVehicles) {
  const slug = v.group_slug || `${v.make}-${v.model}`.toLowerCase().replace(/[^a-z0-9]+/g, "-");
  if (!groupsMap.has(slug) || v.is_primary_variant) {
    const seo = seoMap.get(slug);
    groupsMap.set(slug, {
      primary: v,
      rates: {
        rate_april: v.rate_april,
        rate_may: v.rate_may,
        rate_june: v.rate_june,
        rate_july: v.rate_july,
        rate_august: v.rate_august,
        rate_september: v.rate_september,
        rate_october: v.rate_october,
      },
      image: v.transparent_image_url || v.image_url,
      title: seo?.title || `${v.make} ${v.model}`,
    });
  }
}

const groups = Array.from(groupsMap.entries())
  .map(([slug, g]) => ({ slug, ...g }))
  .sort((a, b) => a.primary.category.localeCompare(b.primary.category));

const MONTHS = [
  { key: "rate_april", label: "Aprile" },
  { key: "rate_may", label: "Maggio" },
  { key: "rate_june", label: "Giugno" },
  { key: "rate_july", label: "Luglio" },
  { key: "rate_august", label: "Agosto" },
  { key: "rate_september", label: "Settembre" },
  { key: "rate_october", label: "Ottobre" },
] as const;

// Categorie per raggruppare visivamente
const byCategory = new Map<string, typeof groups>();
for (const g of groups) {
  const cat = g.primary.category;
  if (!byCategory.has(cat)) byCategory.set(cat, []);
  byCategory.get(cat)!.push(g);
}

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "PriceSpecification",
    name: "Tariffe stagionali noleggio auto KS Rent Sardinia",
    description: "Tariffe ufficiali aggiornate per il noleggio di auto, scooter e quad in Costa Smeralda.",
    priceCurrency: "EUR",
    validFrom: `${new Date().getFullYear()}-04-01`,
    validThrough: `${new Date().getFullYear()}-10-31`,
  },
  ...serviceCatalogJsonLd,
  buildBreadcrumb("Tariffe", "/tariffe"),
];
---
<BaseLayout
  title="Tariffe Noleggio Auto Olbia | Prezzi Mensili — KS Rent Sardinia"
  description="Tariffe trasparenti per il noleggio auto a Olbia: prezzi mensili da Aprile a Ottobre per ogni veicolo. Audi RS3, BMW M2, Jeep Avenger, Fiat Panda, scooter e quad."
  canonical="https://www.ksrentsardinia.com/tariffe"
  ogImage="https://zgytnkimjpoosvshfopz.supabase.co/storage/v1/object/public/asset/og/tariffe.webp"
  jsonLd={jsonLd}
  breadcrumbs={[{ name: "Tariffe", path: "/tariffe" }]}
>
  <div class="bg-background min-h-screen">
    {/* HERO */}
    <section class="relative overflow-hidden border-b border-border">
      <div class="absolute inset-0 bg-gradient-to-br from-card via-background to-card pointer-events-none"></div>
      <div class="absolute -top-20 -right-20 w-96 h-96 bg-gold/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative max-w-5xl mx-auto px-4 md:px-12 pt-32 pb-16 text-center">
        <span class="inline-flex items-center gap-2 text-gold font-bold tracking-[0.3em] uppercase text-[10px] mb-4">
          <Calendar className="w-3.5 h-3.5" />
          Listino ufficiale {new Date().getFullYear()}
        </span>
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-black italic uppercase tracking-tighter text-foreground leading-[0.95]">
          Tariffe Noleggio Auto Olbia
        </h1>
        <p class="mt-6 text-lg md:text-xl text-foreground/70 font-light max-w-2xl mx-auto leading-relaxed">
          Prezzi trasparenti per ogni veicolo, da Aprile a Ottobre. Senza carta di credito obbligatoria, senza sorprese, senza commissioni nascoste.
        </p>

        <div class="mt-10 flex flex-wrap items-center justify-center gap-4 text-xs text-foreground/60">
          <span class="flex items-center gap-2"><CheckCircle2 className="w-4 h-4 text-gold" /> Consegna gratuita</span>
          <span class="flex items-center gap-2"><CreditCard className="w-4 h-4 text-gold" /> Senza carta di credito</span>
          <span class="flex items-center gap-2"><ShieldCheck className="w-4 h-4 text-gold" /> Assicurazione inclusa</span>
        </div>
      </div>
    </section>

    {/* TARIFFE PER CATEGORIA */}
    {Array.from(byCategory.entries()).map(([category, catGroups]) => (
      <section class="py-12 md:py-16 px-4 md:px-12 border-b border-border last:border-0">
        <div class="max-w-6xl mx-auto">
          <div class="mb-8">
            <span class="text-gold font-bold tracking-[0.3em] uppercase text-[10px]">Categoria</span>
            <h2 class="text-3xl md:text-4xl font-black italic uppercase tracking-tighter text-foreground mt-1">
              {category}
            </h2>
          </div>

          <div class="bg-card border border-border rounded-2xl overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full text-sm min-w-[680px]">
                <thead class="bg-background/50 border-b border-border">
                  <tr>
                    <th class="px-4 py-4 text-left text-xs uppercase tracking-wider text-foreground/50 font-bold min-w-[200px]">
                      Veicolo
                    </th>
                    {MONTHS.map((m) => (
                      <th class="px-3 py-4 text-center text-xs uppercase tracking-wider text-foreground/50 font-bold">
                        {m.label.slice(0, 3)}
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {catGroups.map((g) => {
                    const validRates = MONTHS.map((m) => g.rates[m.key]).filter((r): r is number => typeof r === "number" && r > 0);
                    const minRate = validRates.length ? Math.min(...validRates) : null;
                    return (
                      <tr class="border-b border-border/50 last:border-0 hover:bg-background/30 transition-colors">
                        <td class="px-4 py-4">
                          <a href={`/flotta/${g.slug}`} class="flex items-center gap-3 group">
                            {g.image && (
                              <img
                                src={g.image}
                                alt={`Noleggio ${g.title} a Olbia con consegna gratuita in Costa Smeralda — KS Rent Sardinia`}
                                width="56"
                                height="56"
                                class="w-14 h-14 object-contain bg-background rounded-lg p-1 shrink-0"
                                loading="lazy"
                              />
                            )}
                            <div>
                              <p class="font-bold text-foreground group-hover:text-gold transition-colors">
                                {g.title}
                              </p>
                              {minRate && (
                                <p class="text-xs text-foreground/50 mt-0.5">da €{minRate}/giorno</p>
                              )}
                            </div>
                          </a>
                        </td>
                        {MONTHS.map((m) => {
                          const rate = g.rates[m.key];
                          return (
                            <td class="px-3 py-4 text-center">
                              {rate ? (
                                <span class="text-gold font-bold">€{rate}</span>
                              ) : (
                                <span class="text-foreground/30">—</span>
                              )}
                            </td>
                          );
                        })}
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>
    ))}

    {groups.length === 0 && (
      <section class="py-20 px-4 text-center">
        <p class="text-foreground/60 text-lg">
          Listino in aggiornamento. Contattaci direttamente per un preventivo personalizzato.
        </p>
      </section>
    )}

    {/* QUICK FACTS — passaggio enciclopedico per AI/Google AIO */}
    <section class="py-12 md:py-16 px-4 md:px-12 bg-background border-t border-border">
      <div class="max-w-4xl mx-auto">
        <span class="block text-gold font-bold tracking-[0.3em] uppercase text-[10px] mb-3">Quick Facts</span>
        <h2 class="text-2xl md:text-3xl font-black italic uppercase tracking-tighter text-foreground mb-6">
          Tariffe noleggio auto Olbia 2026 in sintesi
        </h2>
        <div class="bg-card border border-border rounded-2xl p-6 md:p-8 text-foreground/80 leading-relaxed font-light">
          <p>
            Le tariffe ufficiali di KS Rent Sardinia per il noleggio auto a Olbia e Costa Smeralda sono <strong>stagionali, valide da aprile a ottobre</strong>. La tariffa minima parte da <strong>40 €/giorno</strong> per la Fiat Panda Hybrid in bassa stagione (aprile-maggio-ottobre) e arriva a <strong>160 €/giorno</strong> per la Mercedes Classe A in alta stagione (luglio-agosto). Le sportive <strong>Audi RS3 e BMW M2</strong> hanno tariffe dedicate fornite su preventivo. Gli scooter Honda SH 125 partono da 40 €/giorno; il quad Yamaha Raptor è su richiesta.
          </p>
          <p class="mt-4">
            <strong>Cosa è incluso</strong>: RCA obbligatoria, assistenza stradale 24 ore su 24, gestione del contratto, chilometraggio adeguato all'itinerario in Gallura. <strong>Cosa non è incluso</strong>: carburante (consegnato e da restituire con stesso livello), pedaggi, costi opzionali (secondo conducente, seggiolino, riduzione franchigia kasko). <strong>Consegna gratuita all'interno del comune di Olbia</strong> (incluso aeroporto OLB e porto Isola Bianca); per le altre località della Gallura e Costa Smeralda il costo parte da 5 € e viene dichiarato in modo trasparente in fase di preventivo.
          </p>
          <p class="mt-4">
            <strong>Pagamento</strong>: la carta di credito tradizionale non è obbligatoria. KS Rent Sardinia accetta contanti, bonifico bancario (anche istantaneo), carte prepagate (Postepay, Revolut, N26, Hype, Wise), bancomat, carte di debito. <strong>Rating Google: 5,0 / 5 su 45 recensioni verificate</strong> (più 3 su Tripadvisor e 2 su PagineGialle, tutte 5★ — aggiornato maggio 2026). Apertura 7 giorni su 7 inclusi festivi: 10:00–13:00 e 15:00–22:30.
          </p>
        </div>
      </div>
    </section>

    {/* DOCUMENTI RICHIESTI PER IL NOLEGGIO */}
    <section class="py-12 md:py-16 px-4 md:px-12 bg-card border-t border-border">
      <div class="max-w-4xl mx-auto">
        <span class="block text-gold font-bold tracking-[0.3em] uppercase text-[10px] mb-3">Pronto al Ritiro</span>
        <h2 class="text-2xl md:text-3xl font-black italic uppercase tracking-tighter text-foreground mb-3">
          Documenti per il noleggio
        </h2>
        <p class="text-foreground/70 font-light mb-8 leading-relaxed">
          Per ritirare il veicolo presso la nostra sede di Olbia o al punto di consegna concordato, il conducente principale deve presentare in originale i seguenti documenti.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="bg-background border border-border rounded-2xl p-5">
            <h3 class="font-bold text-foreground mb-2">🪪 Patente di guida</h3>
            <p class="text-sm text-foreground/70 leading-relaxed">
              Patente <strong>categoria B</strong> per autoveicoli (valida da almeno <strong>1 anno</strong>), <strong>A1/A2</strong> per scooter, <strong>B</strong> per quad. In corso di validità, originale (no fotocopia).
            </p>
          </div>
          <div class="bg-background border border-border rounded-2xl p-5">
            <h3 class="font-bold text-foreground mb-2">🛂 Documento d'identità</h3>
            <p class="text-sm text-foreground/70 leading-relaxed">
              Carta d'identità o passaporto in corso di validità. Per cittadini extra-UE è consigliata anche la <strong>patente internazionale</strong>.
            </p>
          </div>
          <div class="bg-background border border-border rounded-2xl p-5">
            <h3 class="font-bold text-foreground mb-2">🧾 Codice fiscale</h3>
            <p class="text-sm text-foreground/70 leading-relaxed">
              Per residenti italiani, da indicare nel contratto. Cittadini stranieri possono indicare invece il TIN o codice fiscale del paese di origine.
            </p>
          </div>
          <div class="bg-background border border-border rounded-2xl p-5">
            <h3 class="font-bold text-foreground mb-2">💳 Metodo di pagamento</h3>
            <p class="text-sm text-foreground/70 leading-relaxed">
              Per saldo e deposito: <strong>contanti, bonifico istantaneo, bancomat, carte prepagate</strong> (Postepay, Revolut, N26, Hype, Wise), carte di debito o credito. La carta di credito tradizionale <strong>non</strong> è obbligatoria.
            </p>
          </div>
        </div>

        <div class="mt-6 bg-gold/5 border border-gold/20 rounded-xl p-4">
          <p class="text-sm text-foreground/80 leading-relaxed">
            <strong>Età minima conducente</strong>: 21 anni per utilitarie e veicoli standard (Fiat Panda, Jeep Avenger, Mercedes Classe A); <strong>25 anni</strong> per sportive e supercar (Audi RS3, BMW M2); 21 anni per quad. Il <strong>secondo conducente</strong> è opzionale con costo aggiuntivo dichiarato in fase di preventivo.
          </p>
        </div>
      </div>
    </section>

    {/* FRANCHIGIA KASKO & DEPOSITO CAUZIONALE — contattaci */}
    <section class="py-12 md:py-16 px-4 md:px-12 bg-background border-t border-border">
      <div class="max-w-4xl mx-auto">
        <span class="block text-gold font-bold tracking-[0.3em] uppercase text-[10px] mb-3">Trasparenza Assicurativa</span>
        <h2 class="text-2xl md:text-3xl font-black italic uppercase tracking-tighter text-foreground mb-3">
          Franchigia kasko e deposito cauzionale
        </h2>
        <p class="text-foreground/70 font-light mb-8 leading-relaxed">
          La franchigia kasko e il deposito cauzionale variano in funzione della categoria del veicolo (utilitarie, SUV/premium, sportive, scooter o quad) e del periodo di noleggio. <strong>Contattaci su WhatsApp</strong> per ricevere l'importo esatto della franchigia e del deposito per il veicolo che ti interessa, insieme alle opzioni di <strong>riduzione franchigia</strong> disponibili al ritiro.
        </p>

        <div class="bg-card border border-border rounded-2xl p-6 md:p-8">
          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-5">
            <div>
              <h3 class="font-bold text-foreground text-lg mb-2">Richiedi il dettaglio franchigia e deposito</h3>
              <p class="text-sm text-foreground/70 leading-relaxed">
                Risposta in giornata, 7 giorni su 7. Importi confermati per iscritto nel preventivo e nel contratto firmato, addebitati <em>solo</em> in presenza di danno documentato in contraddittorio.
              </p>
            </div>
            <a
              href="https://wa.me/393446107071?text=Ciao%20KS%20Rent%2C%20vorrei%20ricevere%20informazioni%20dettagliate%20sulla%20franchigia%20kasko%20e%20sul%20deposito%20cauzionale%20per%20il%20veicolo%20che%20mi%20interessa.%20Grazie!"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 bg-[#25D366] text-white font-semibold tracking-wide text-sm px-6 py-3.5 rounded-full hover:scale-105 transition-transform shadow-lg whitespace-nowrap shrink-0"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.262.489 1.693.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
              </svg>
              Chiedi su WhatsApp
            </a>
          </div>
        </div>

        <p class="text-xs text-foreground/55 mt-6 leading-relaxed">
          Il deposito cauzionale viene restituito integralmente alla riconsegna del veicolo, salvo danni o sanzioni pendenti. Per il dettaglio completo consulta i <a href="/termini-e-condizioni" class="text-gold hover:underline">Termini e Condizioni di Noleggio</a>.
        </p>
      </div>
    </section>

    {/* INFO LISTINO */}
    <section class="py-16 md:py-20 px-4 md:px-12 bg-card">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-black italic uppercase tracking-tighter text-foreground text-center mb-10">
          Come funziona il nostro listino
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-background border border-border rounded-2xl p-6">
            <Calendar className="w-8 h-8 text-gold mb-4" />
            <h3 class="font-bold text-foreground mb-2">Tariffe stagionali</h3>
            <p class="text-foreground/60 text-sm font-light leading-relaxed">
              Aprile e Ottobre sono i mesi più convenienti. Luglio e Agosto sono in alta stagione: prenota con anticipo per garantirti il veicolo.
            </p>
          </div>
          <div class="bg-background border border-border rounded-2xl p-6">
            <CreditCard className="w-8 h-8 text-gold mb-4" />
            <h3 class="font-bold text-foreground mb-2">Senza carta di credito</h3>
            <p class="text-foreground/60 text-sm font-light leading-relaxed">
              Accettiamo bancomat, prepagate (PostePay, Revolut, N26) e contanti per il deposito cauzionale. Nessun blocco sulla carta.
            </p>
          </div>
          <div class="bg-background border border-border rounded-2xl p-6">
            <ShieldCheck className="w-8 h-8 text-gold mb-4" />
            <h3 class="font-bold text-foreground mb-2">Tutto incluso</h3>
            <p class="text-foreground/60 text-sm font-light leading-relaxed">
              Le tariffe includono RCA, assistenza stradale e gestione contratto. Consegna gratuita nel comune di Olbia (aeroporto e porto inclusi); per le altre località della Gallura il costo parte da 5 € ed è dichiarato in fase di preventivo.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* RELATED GUIDES: budget vacanza, senza carta, scelta veicolo */}
    <RelatedGuides
      lang="it"
      itSlugs={["quanto-costa-vacanza-costa-smeralda-budget-2026", "noleggio-auto-olbia-senza-carta-di-credito-guida-completa", "noleggio-scooter-quad-sardegna-come-scegliere"]}
    />

    {/* CTA FINALE su sfondo ORO */}
    <section class="relative bg-gold text-background py-20 md:py-24 text-center px-4 md:px-12 overflow-hidden">
      <div class="absolute inset-0 opacity-[0.07] mix-blend-overlay pointer-events-none bg-[radial-gradient(circle_at_20%_20%,#000_2px,transparent_2px),radial-gradient(circle_at_60%_70%,#000_1px,transparent_1px)] bg-[length:32px_32px,18px_18px]"></div>
      <div class="relative max-w-3xl mx-auto">
        <h2 class="font-serif text-3xl md:text-5xl text-background font-medium mb-5 leading-tight">
          Pronto a prenotare?
        </h2>
        <p class="font-serif text-background/85 text-[17px] md:text-lg leading-relaxed max-w-xl mx-auto mb-10">
          Conferma le tariffe per le tue date e scegli il veicolo perfetto per la tua vacanza in Costa Smeralda.
        </p>
        <a
          href="/prenotaora"
          class="inline-flex items-center gap-2 bg-background text-foreground font-semibold tracking-wide text-sm px-10 py-4 rounded-full hover:scale-105 transition-transform shadow-xl ring-1 ring-background/20"
        >
          Verifica disponibilità
          <ArrowRight className="w-4 h-4" />
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
