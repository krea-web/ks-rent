---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroSection from "@/components/HeroSection";
import TrustMarquee from "@/components/TrustMarquee";
import TopBeachesShowcase from "@/components/TopBeachesShowcase.astro";
import FleetShowcase from "@/components/FleetShowcase";
import GuideSpotlight from "@/components/GuideSpotlight.astro";
import FAQSection from "@/components/FAQSection";
import GoogleReviews from "@/components/GoogleReviews";
import { supabase } from "@/lib/supabase";
import { getAggregateRating, getTopReviewsForSchema } from "@/lib/reviews";
import { buildSpeakableJsonLd } from "@/lib/jsonLd";

// Fetch reviews at build-time from Supabase
const { data: reviewsData } = await supabase
  .from("reviews")
  .select("author_name, author_photo_url, rating, text, published_at, is_featured")
  .eq("is_published", true)
  .order("is_featured", { ascending: false })
  .order("published_at", { ascending: false })
  .limit(3);

const { count: reviewsCount } = await supabase
  .from("reviews")
  .select("id", { count: "exact", head: true })
  .eq("is_published", true);

const { data: avgData } = await supabase
  .from("reviews")
  .select("rating")
  .eq("is_published", true);

const averageRating = avgData && avgData.length > 0
  ? avgData.reduce((s, r) => s + r.rating, 0) / avgData.length
  : null;

const aggregateAuth = await getAggregateRating();
const topReviewSchemas = await getTopReviewsForSchema(5);

const reviewsLdExtension = topReviewSchemas.length >= 3
  ? {
      "@context": "https://schema.org",
      "@type": ["AutoRental", "LocalBusiness"],
      "@id": "https://www.ksrentsardinia.com/#organization",
      review: topReviewSchemas,
    }
  : null;
---
<BaseLayout
  title="Car Hire Olbia | Costa Smeralda Car Rental — KS Rent"
  description="Car hire in Olbia with home delivery throughout Costa Smeralda. SUVs, supercars and city cars without a credit card. Book online with KS Rent Sardinia."
  canonical="https://www.ksrentsardinia.com/en/"
  ogImage="https://zgytnkimjpoosvshfopz.supabase.co/storage/v1/object/public/asset/og/home.webp"
  includeGlobalFaq={true}
  aggregateRating={aggregateAuth ?? undefined}
  jsonLd={reviewsLdExtension ? [reviewsLdExtension, buildSpeakableJsonLd("https://www.ksrentsardinia.com/en/", "en")] : [buildSpeakableJsonLd("https://www.ksrentsardinia.com/en/", "en")]}
>
  <HeroSection lang="en" />
  <TrustMarquee lang="en" />
  <FleetShowcase lang="en" client:visible />
  <TopBeachesShowcase lang="en" />
  <GuideSpotlight lang="en" />
  <FAQSection lang="en" />
  <GoogleReviews
    reviews={reviewsData || []}
    totalCount={reviewsCount || 0}
    averageRating={averageRating ?? undefined}
    client:visible
  />

  {/* Static SEO rich text — read directly by Google without JS */}
  <section class="py-16 md:py-20 px-4 md:px-12 bg-background">
    <div class="editorial mx-auto">
    <h2>Car Hire Olbia — Your Trusted Car Rental Partner</h2>
    <p class="mb-4">
      Looking for <strong>car hire in Olbia</strong>? KS Rent Sardinia is the go-to <strong>Olbia car rental</strong>
      company for travellers who want to explore north-eastern Sardinia with no compromises. We deliver SUVs, supercars,
      city cars, motorbikes and quads straight to the
      <a href="/en/car-hire-olbia-port">Port of Olbia</a>,
      to <a href="/en/car-hire-olbia-airport">Olbia Costa Smeralda Airport</a>,
      to your hotel or your villa — from 10:00 to 22:30, 7 days a week.
    </p>
    <p class="mb-4">
      <strong>
        We are a proudly and exclusively Sardinian company (VAT 03028900904), fully independent and not
        affiliated with other similarly named businesses operating elsewhere in Italy.
      </strong>
      We are not your average car hire firm or an online intermediary: we physically own our fleet — Audi RS3, BMW M2,
      Mercedes A-Class, Jeep Avenger, Fiat Panda, Honda SH — and prepare it meticulously for every customer.
    </p>
    <p class="mb-4">
      Our <strong>Olbia car hire</strong> service stands out for one tangible advantage: we accept debit cards,
      prepaid cards and cash for the security deposit. No mandatory credit card, no card hold, no surprises.
      <a href="/en/car-hire-no-credit-card-olbia">Discover car hire without a credit card</a>.
    </p>

    <h3>Home delivery throughout Gallura and Costa Smeralda</h3>
    <p class="mb-4">
      KS Rent's <strong>Olbia car rental</strong> service covers the whole of Gallura. We deliver to the most popular destinations:
      <a href="/en/car-hire-porto-cervo">Porto Cervo</a>,
      <a href="/en/car-hire-san-teodoro">San Teodoro</a>,
      <a href="/en/car-hire-baja-sardinia">Baja Sardinia</a>,
      <a href="/en/car-hire-palau">Palau</a>,
      <a href="/en/car-hire-porto-rotondo">Porto Rotondo</a>,
      <a href="/en/car-hire-budoni">Budoni</a> and the
      <a href="/en/car-hire-costa-smeralda">Costa Smeralda</a>.
      Your <strong>car hire in Olbia</strong> begins the moment you land or step off the ferry.
    </p>

    <h3>The most beautiful beaches within easy reach</h3>
    <p class="mb-4">
      With a KS Rent SUV you can reach even the most hidden coves of north-eastern Sardinia:
      <a href="/en/spiaggia-del-principe">Spiaggia del Principe</a>,
      <a href="/en/cala-brandinchi">Cala Brandinchi</a>,
      <a href="/en/la-cinta">La Cinta</a>,
      <a href="/en/capriccioli">Capriccioli</a> and
      <a href="/en/porto-istana">Porto Istana</a> with views over Tavolara.
      For beaches with unpaved access we recommend the Jeep Avenger; for the panoramic coastal roads, the Audi RS3 or BMW M2.
    </p>
      </div>
  </section>
</BaseLayout>
