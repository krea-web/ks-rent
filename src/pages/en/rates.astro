---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { supabase } from "@/lib/supabase";
import RelatedGuides from "@/components/RelatedGuides.astro";
import { ArrowRight, ShieldCheck, Calendar, CreditCard, CheckCircle2 } from "lucide-react";

interface VehicleRow {
  make: string;
  model: string;
  category: string;
  group_slug: string | null;
  is_primary_variant: boolean | null;
  is_archived: boolean | null;
  transparent_image_url: string | null;
  image_url: string | null;
  daily_rate: number | null;
  rate_april: number | null;
  rate_may: number | null;
  rate_june: number | null;
  rate_july: number | null;
  rate_august: number | null;
  rate_september: number | null;
  rate_october: number | null;
}

interface SeoVehicleRow {
  group_slug: string;
  title: string | null;
}

const [vehRes, seoRes] = await Promise.all([
  supabase
    .from("vehicles")
    .select("*")
    .or("is_archived.is.null,is_archived.eq.false")
    .order("category"),
  supabase.from("seo_vehicles").select("group_slug, title"),
]);

const allVehicles = (vehRes.data || []) as VehicleRow[];
const seoMap = new Map<string, SeoVehicleRow>();
for (const s of (seoRes.data || []) as SeoVehicleRow[]) {
  seoMap.set(s.group_slug, s);
}

// Group by group_slug, take primary variant
const groupsMap = new Map<string, { primary: VehicleRow; rates: Record<string, number | null>; image: string | null; title: string }>();
for (const v of allVehicles) {
  const slug = v.group_slug || `${v.make}-${v.model}`.toLowerCase().replace(/[^a-z0-9]+/g, "-");
  if (!groupsMap.has(slug) || v.is_primary_variant) {
    const seo = seoMap.get(slug);
    groupsMap.set(slug, {
      primary: v,
      rates: {
        rate_april: v.rate_april,
        rate_may: v.rate_may,
        rate_june: v.rate_june,
        rate_july: v.rate_july,
        rate_august: v.rate_august,
        rate_september: v.rate_september,
        rate_october: v.rate_october,
      },
      image: v.transparent_image_url || v.image_url,
      title: seo?.title || `${v.make} ${v.model}`,
    });
  }
}

const groups = Array.from(groupsMap.entries())
  .map(([slug, g]) => ({ slug, ...g }))
  .sort((a, b) => a.primary.category.localeCompare(b.primary.category));

const MONTHS = [
  { key: "rate_april", label: "April" },
  { key: "rate_may", label: "May" },
  { key: "rate_june", label: "June" },
  { key: "rate_july", label: "July" },
  { key: "rate_august", label: "August" },
  { key: "rate_september", label: "September" },
  { key: "rate_october", label: "October" },
] as const;

// Categories for visual grouping
const byCategory = new Map<string, typeof groups>();
for (const g of groups) {
  const cat = g.primary.category;
  if (!byCategory.has(cat)) byCategory.set(cat, []);
  byCategory.get(cat)!.push(g);
}

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "PriceSpecification",
    name: "Seasonal car hire rates KS Rent Sardinia",
    description: "Official up-to-date rates for hiring cars, scooters and quads in Costa Smeralda.",
    priceCurrency: "EUR",
    validFrom: `${new Date().getFullYear()}-04-01`,
    validThrough: `${new Date().getFullYear()}-10-31`,
  },
];
---
<BaseLayout
  title="Car Hire Rates Olbia | Monthly Prices — KS Rent Sardinia"
  description="Transparent car hire rates in Olbia: monthly prices from April to October for every vehicle. Audi RS3, BMW M2, Jeep Avenger, Fiat Panda, scooters and quads."
  canonical="https://www.ksrentsardinia.com/en/rates"
  jsonLd={jsonLd}
  breadcrumbs={[{ name: "Rates", path: "/en/rates" }]}
>
  <div class="bg-background min-h-screen">
    {/* HERO */}
    <section class="relative overflow-hidden border-b border-border">
      <div class="absolute inset-0 bg-gradient-to-br from-card via-background to-card pointer-events-none"></div>
      <div class="absolute -top-20 -right-20 w-96 h-96 bg-gold/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative max-w-5xl mx-auto px-4 md:px-12 pt-32 pb-16 text-center">
        <span class="inline-flex items-center gap-2 text-gold font-bold tracking-[0.3em] uppercase text-[10px] mb-4">
          <Calendar className="w-3.5 h-3.5" />
          Official price list {new Date().getFullYear()}
        </span>
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-black italic uppercase tracking-tighter text-foreground leading-[0.95]">
          Car Hire Rates Olbia
        </h1>
        <p class="mt-6 text-lg md:text-xl text-foreground/70 font-light max-w-2xl mx-auto leading-relaxed">
          Transparent prices for every vehicle, from April to October. No credit card required, no surprises, no hidden fees.
        </p>

        <div class="mt-10 flex flex-wrap items-center justify-center gap-4 text-xs text-foreground/60">
          <span class="flex items-center gap-2"><CheckCircle2 className="w-4 h-4 text-gold" /> Free delivery</span>
          <span class="flex items-center gap-2"><CreditCard className="w-4 h-4 text-gold" /> No credit card required</span>
          <span class="flex items-center gap-2"><ShieldCheck className="w-4 h-4 text-gold" /> Insurance included</span>
        </div>
      </div>
    </section>

    {/* RATES BY CATEGORY */}
    {Array.from(byCategory.entries()).map(([category, catGroups]) => (
      <section class="py-12 md:py-16 px-4 md:px-12 border-b border-border last:border-0">
        <div class="max-w-6xl mx-auto">
          <div class="mb-8">
            <span class="text-gold font-bold tracking-[0.3em] uppercase text-[10px]">Category</span>
            <h2 class="text-3xl md:text-4xl font-black italic uppercase tracking-tighter text-foreground mt-1">
              {category}
            </h2>
          </div>

          <div class="bg-card border border-border rounded-2xl overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full text-sm min-w-[680px]">
                <thead class="bg-background/50 border-b border-border">
                  <tr>
                    <th class="px-4 py-4 text-left text-xs uppercase tracking-wider text-foreground/50 font-bold min-w-[200px]">
                      Vehicle
                    </th>
                    {MONTHS.map((m) => (
                      <th class="px-3 py-4 text-center text-xs uppercase tracking-wider text-foreground/50 font-bold">
                        {m.label.slice(0, 3)}
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {catGroups.map((g) => {
                    const validRates = MONTHS.map((m) => g.rates[m.key]).filter((r): r is number => typeof r === "number" && r > 0);
                    const minRate = validRates.length ? Math.min(...validRates) : null;
                    return (
                      <tr class="border-b border-border/50 last:border-0 hover:bg-background/30 transition-colors">
                        <td class="px-4 py-4">
                          <a href={`/en/fleet/${g.slug}`} class="flex items-center gap-3 group">
                            {g.image && (
                              <img
                                src={g.image}
                                alt={g.title}
                                class="w-14 h-14 object-contain bg-background rounded-lg p-1 shrink-0"
                                loading="lazy"
                              />
                            )}
                            <div>
                              <p class="font-bold text-foreground group-hover:text-gold transition-colors">
                                {g.title}
                              </p>
                              {minRate && (
                                <p class="text-xs text-foreground/50 mt-0.5">from €{minRate}/day</p>
                              )}
                            </div>
                          </a>
                        </td>
                        {MONTHS.map((m) => {
                          const rate = g.rates[m.key];
                          return (
                            <td class="px-3 py-4 text-center">
                              {rate ? (
                                <span class="text-gold font-bold">€{rate}</span>
                              ) : (
                                <span class="text-foreground/30">—</span>
                              )}
                            </td>
                          );
                        })}
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>
    ))}

    {groups.length === 0 && (
      <section class="py-20 px-4 text-center">
        <p class="text-foreground/60 text-lg">
          Price list being updated. Contact us directly for a personalised quote.
        </p>
      </section>
    )}

    {/* KASKO EXCESS & SECURITY DEPOSIT — transparency */}
    <section class="py-12 md:py-16 px-4 md:px-12 bg-background border-t border-border">
      <div class="max-w-4xl mx-auto">
        <span class="block text-gold font-bold tracking-[0.3em] uppercase text-[10px] mb-3">Insurance Transparency</span>
        <h2 class="text-2xl md:text-3xl font-black italic uppercase tracking-tighter text-foreground mb-3">
          Kasko excess and security deposit
        </h2>
        <p class="text-foreground/70 font-light mb-8 leading-relaxed">
          We want you to know in advance the maximum amount of your liability in case of vehicle damage. Indicative figures by category — confirmed in the quote and signed contract. An <strong>optional excess reduction</strong> is available at pickup.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="bg-card border border-border rounded-2xl p-5">
            <h3 class="font-bold text-foreground mb-1">City Car & Compact</h3>
            <p class="text-xs uppercase tracking-wider text-foreground/50 mb-3">Fiat Panda, Jeep Avenger</p>
            <dl class="text-sm text-foreground/75 space-y-1.5">
              <div class="flex justify-between"><dt>Kasko excess</dt><dd class="text-gold font-bold">€ 800 – 1,200</dd></div>
              <div class="flex justify-between"><dt>Security deposit</dt><dd class="text-gold font-bold">€ 500 – 800</dd></div>
            </dl>
          </div>
          <div class="bg-card border border-border rounded-2xl p-5">
            <h3 class="font-bold text-foreground mb-1">Premium SUV & Sedan</h3>
            <p class="text-xs uppercase tracking-wider text-foreground/50 mb-3">Mercedes A-Class</p>
            <dl class="text-sm text-foreground/75 space-y-1.5">
              <div class="flex justify-between"><dt>Kasko excess</dt><dd class="text-gold font-bold">€ 1,500 – 2,500</dd></div>
              <div class="flex justify-between"><dt>Security deposit</dt><dd class="text-gold font-bold">€ 800 – 1,200</dd></div>
            </dl>
          </div>
          <div class="bg-card border border-border rounded-2xl p-5">
            <h3 class="font-bold text-foreground mb-1">Sports & Supercars</h3>
            <p class="text-xs uppercase tracking-wider text-foreground/50 mb-3">Audi RS3, BMW M2</p>
            <dl class="text-sm text-foreground/75 space-y-1.5">
              <div class="flex justify-between"><dt>Kasko excess</dt><dd class="text-gold font-bold">€ 3,000 – 5,000</dd></div>
              <div class="flex justify-between"><dt>Security deposit</dt><dd class="text-gold font-bold">€ 1,500 – 2,500</dd></div>
            </dl>
          </div>
          <div class="bg-card border border-border rounded-2xl p-5">
            <h3 class="font-bold text-foreground mb-1">Scooters & Quads</h3>
            <p class="text-xs uppercase tracking-wider text-foreground/50 mb-3">Honda SH 125/350, Yamaha Raptor</p>
            <dl class="text-sm text-foreground/75 space-y-1.5">
              <div class="flex justify-between"><dt>Kasko excess</dt><dd class="text-gold font-bold">€ 500 – 1,500</dd></div>
              <div class="flex justify-between"><dt>Security deposit</dt><dd class="text-gold font-bold">€ 300 – 600</dd></div>
            </dl>
          </div>
        </div>

        <p class="text-xs text-foreground/55 mt-6 leading-relaxed">
          The excess represents the maximum amount payable by the driver in case of accident or damage; we never ask you to pay it upfront — it is charged <em>only</em> when damage is documented contradictorily. The security deposit is fully refunded upon vehicle return, except for pending damages or fines. For full details see our <a href="/en/terms-conditions" class="text-gold hover:underline">Rental Terms &amp; Conditions</a>.
        </p>
      </div>
    </section>

    {/* PRICE LIST INFO */}
    <section class="py-16 md:py-20 px-4 md:px-12 bg-card">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-black italic uppercase tracking-tighter text-foreground text-center mb-10">
          How our pricing works
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-background border border-border rounded-2xl p-6">
            <Calendar className="w-8 h-8 text-gold mb-4" />
            <h3 class="font-bold text-foreground mb-2">Seasonal rates</h3>
            <p class="text-foreground/60 text-sm font-light leading-relaxed">
              April and October are the best-value months. July and August are peak season: book in advance to secure your vehicle.
            </p>
          </div>
          <div class="bg-background border border-border rounded-2xl p-6">
            <CreditCard className="w-8 h-8 text-gold mb-4" />
            <h3 class="font-bold text-foreground mb-2">No credit card required</h3>
            <p class="text-foreground/60 text-sm font-light leading-relaxed">
              We accept debit cards, prepaid cards (PostePay, Revolut, N26) and cash for the security deposit. No card hold.
            </p>
          </div>
          <div class="bg-background border border-border rounded-2xl p-6">
            <ShieldCheck className="w-8 h-8 text-gold mb-4" />
            <h3 class="font-bold text-foreground mb-2">All-inclusive</h3>
            <p class="text-foreground/60 text-sm font-light leading-relaxed">
              Rates include insurance, unlimited mileage and free delivery throughout Gallura. No hidden fees.
            </p>
          </div>
        </div>
      </div>
    </section>
    <RelatedGuides lang="en" itSlugs={["quanto-costa-vacanza-costa-smeralda-budget-2026", "noleggio-auto-olbia-senza-carta-di-credito-guida-completa", "noleggio-scooter-quad-sardegna-come-scegliere"]} />


    {/* CTA FINALE su sfondo ORO */}
    <section class="relative bg-gold text-background py-20 md:py-24 text-center px-4 md:px-12 overflow-hidden">
      <div class="absolute inset-0 opacity-[0.07] mix-blend-overlay pointer-events-none bg-[radial-gradient(circle_at_20%_20%,#000_2px,transparent_2px),radial-gradient(circle_at_60%_70%,#000_1px,transparent_1px)] bg-[length:32px_32px,18px_18px]"></div>
      <div class="relative max-w-3xl mx-auto">
        <h2 class="font-serif text-3xl md:text-5xl text-background font-medium mb-5 leading-tight">
          Ready to book?
        </h2>
        <p class="font-serif text-background/85 text-[17px] md:text-lg leading-relaxed max-w-xl mx-auto mb-10">
          Confirm the rates for your dates and choose the perfect vehicle for your Costa Smeralda holiday.
        </p>
        <a
          href="/en/book-now"
          class="inline-flex items-center gap-2 bg-background text-foreground font-semibold tracking-wide text-sm px-10 py-4 rounded-full hover:scale-105 transition-transform shadow-xl ring-1 ring-background/20"
        >
          Check availability
          <ArrowRight className="w-4 h-4" />
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
