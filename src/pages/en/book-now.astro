---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PrenotaOra from "@/views/PrenotaOra";
import BookingIntro from "@/components/BookingIntro.astro";
import { buildBreadcrumb } from "@/lib/jsonLd";
---
<BaseLayout
  title="Book Car Hire Olbia Airport | KS Rent Costa Smeralda"
  description="Request your vehicle in Olbia in under 2 minutes. Delivery to the airport or your hotel. Transparent security deposit and full insurance cover."
  canonical="https://www.ksrentsardinia.com/en/book-now"
  jsonLd={buildBreadcrumb("Book Now", "/en/book-now")}
  hideMobileSticky={true}
>
  <PrenotaOra client:only="react" lang="en" />
  <BookingIntro lang="en" />
</BaseLayout>
