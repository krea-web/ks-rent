---
import BaseLayout from "@/layouts/BaseLayout.astro";
import VehicleComparison from "@/components/VehicleComparison.astro";
import { getTranslatedSpec } from "@/data/vehicle-specs-i18n";

const lang = "en" as const;
const a = getTranslatedSpec("mercedes-classe-a", lang);
const b = getTranslatedSpec("jeep-avenger", lang);

const h1 = "Mercedes A-Class vs Jeep Avenger: premium or SUV for Sardinia?";
const intro =
  "Mercedes A-Class 180d and Jeep Avenger are two intermediate options for car hire in Olbia, both with automatic gearbox and suitable for couples and families. The A-Class 180d is a diesel premium compact producing 116 hp with 4.5 L/100km consumption, ideal for comfortable motorway tours and for those seeking Mercedes elegance. The Jeep Avenger is a petrol compact SUV producing 100 hp with 6.1 L/100km consumption, raised driving position and greater versatility to access beaches reachable only by dirt road. Both start from €60-90/day in low season and reach €110-160/day in high season. The choice depends on the type of itinerary: motorway comfort and historic centres (Mercedes A) or off-road flexibility and family luggage (Jeep Avenger).";

const pageUrl = "https://www.ksrentsardinia.com/en/fleet/compare/mercedes-a-class-vs-jeep-avenger";
const jsonLd = [{
  "@context": "https://schema.org", "@type": "WebPage", "@id": `${pageUrl}#page`,
  name: h1, description: intro.slice(0, 220), url: pageUrl, inLanguage: "en-GB",
  isPartOf: { "@id": "https://www.ksrentsardinia.com/#website" },
  primaryImageOfPage: a.image,
  about: [
    { "@type": "Vehicle", name: a.name, brand: { "@type": "Brand", name: a.brand }, url: `https://www.ksrentsardinia.com${a.href}`, image: a.image, vehicleConfiguration: a.category },
    { "@type": "Vehicle", name: b.name, brand: { "@type": "Brand", name: b.brand }, url: `https://www.ksrentsardinia.com${b.href}`, image: b.image, vehicleConfiguration: b.category },
  ],
}];
---
<BaseLayout
  title="Mercedes A-Class vs Jeep Avenger Olbia: premium or SUV?"
  description="Comparison Mercedes A-Class 180d diesel vs Jeep Avenger SUV: fuel economy, comfort, off-road, prices. Which car hire to choose in Olbia."
  canonical={pageUrl}
  jsonLd={jsonLd}
  breadcrumbs={[{ name: "Fleet", path: "/en/fleet" }, { name: "Mercedes A-Class vs Jeep Avenger", path: "/en/fleet/compare/mercedes-a-class-vs-jeep-avenger" }]}
>
  <VehicleComparison a={a} b={b} h1={h1} intro={intro} lang={lang} />
</BaseLayout>
