---
import BaseLayout from "@/layouts/BaseLayout.astro";
import VehiclePageBody from "@/components/VehiclePageBody.astro";
import { supabase } from "@/lib/supabase";
import { buildVehiclePageJsonLd } from "@/lib/jsonLd";
import { getReviewSchemaData } from "@/lib/reviewSchemaData";

export async function getStaticPaths() {
  const [seoRes, vehRes] = await Promise.all([
    supabase.from("seo_vehicles").select("*"),
    supabase.from("vehicles").select("*").or("is_archived.is.null,is_archived.eq.false"),
  ]);
  const seoRows = (seoRes.data || []) as any[];
  const allVehicles = (vehRes.data || []) as any[];

  return seoRows
    .filter((s) => s.slug_en && s.title_en)
    .map((seo) => ({
      params: { slug: seo.slug_en as string },
      props: { seo, variants: allVehicles.filter((v) => v.group_slug === seo.group_slug) },
    }));
}

const { seo, variants } = Astro.props as { seo: any; variants: any[] };
const lang = "en" as const;

const primary = variants.find((v) => v.is_primary_variant) || variants[0] || null;
const heroImage = seo.hero_image_url || primary?.transparent_image_url || primary?.image_url || null;
const allRates: number[] = [];
for (const v of variants) {
  for (const k of ["rate_april","rate_may","rate_june","rate_july","rate_august","rate_september","rate_october"]) {
    const r = (v as any)[k]; if (typeof r === "number" && r > 0) allRates.push(r);
  }
}
const priceFrom = allRates.length ? Math.min(...allRates) : null;
const priceTo = allRates.length ? Math.max(...allRates) : null;
const pageUrl = `https://www.ksrentsardinia.com/${lang}/fleet/${seo.slug_en}`;

const { aggregateRating, reviews: schemaReviews } = await getReviewSchemaData(lang);

const jsonLd = buildVehiclePageJsonLd(
  {
    group_slug: seo.group_slug,
    name: seo.title_en,
    brand: primary?.make || null,
    category: primary?.category || null,
    fuel: primary?.fuel_type || null,
    description: seo.meta_description_en || null,
    image: heroImage,
    priceFrom,
    priceTo,
    url: pageUrl,
    aggregateRating,
    reviews: schemaReviews,
  },
  Array.isArray(seo.faqs) && seo.faqs.length > 0
    ? seo.faqs.map((f: any) => ({ q: f.q_en || f.q, a: f.a_en || f.a }))
    : undefined,
);
---
<BaseLayout
  title={seo.title_en}
  description={seo.meta_description_en || ""}
  canonical={pageUrl}
  ogImage={seo.og_image_url || heroImage || undefined}
  jsonLd={jsonLd}
  breadcrumbs={[
    { name: "Fleet", path: "/en/fleet" },
    { name: seo.title_en, path: `/en/fleet/${seo.slug_en}` },
  ]}
>
  <VehiclePageBody seo={seo} variants={variants} lang={lang} />
</BaseLayout>
