import NoleggioSenzaCartaCredito, {
  senzaCCJsonLd,
  senzaCCFaqJsonLd,
} from "@/views/NoleggioSenzaCartaCredito";
import { buildBreadcrumb } from "@/lib/jsonLd";
---
<BaseLayout
