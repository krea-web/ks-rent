---
import BaseLayout from "@/layouts/BaseLayout.astro";
import VehicleComparison from "@/components/VehicleComparison.astro";
import { getTranslatedSpec } from "@/data/vehicle-specs-i18n";

const lang = "fr" as const;
const a = getTranslatedSpec("mercedes-classe-a", lang);
const b = getTranslatedSpec("jeep-avenger", lang);

const h1 = "Mercedes Classe A vs Jeep Avenger : premium ou SUV pour la Sardaigne ?";
const intro =
  "Mercedes Classe A 180d et Jeep Avenger sont deux options intermediaires de la location a Olbia, toutes deux avec boite automatique et adaptees aux couples et familles. La Classe A 180d est une compacte premium diesel de 116 ch avec consommation 4,5 L/100km, ideale pour des tours autoroutiers confortables et pour qui cherche l'elegance Mercedes. La Jeep Avenger est un SUV compact essence de 100 ch avec consommation 6,1 L/100km, position de conduite surelevee et plus grande polyvalence pour acceder aux plages joignables uniquement par chemin de terre. Les deux partent de 60-90 €/jour basse saison et atteignent 110-160 €/jour en haute saison. Le choix depend du type d'itineraire : confort autoroutier et centres historiques (Mercedes A) ou flexibilite tout-terrain et bagages famille (Jeep Avenger).";

const pageUrl = "https://www.ksrentsardinia.com/fr/flotte/comparer/mercedes-classe-a-vs-jeep-avenger";
const jsonLd = [{
  "@context": "https://schema.org", "@type": "WebPage", "@id": `${pageUrl}#page`,
  name: h1, description: intro.slice(0, 220), url: pageUrl, inLanguage: "fr-FR",
  isPartOf: { "@id": "https://www.ksrentsardinia.com/#website" },
  primaryImageOfPage: a.image,
  about: [
    { "@type": "Vehicle", name: a.name, brand: { "@type": "Brand", name: a.brand }, url: `https://www.ksrentsardinia.com${a.href}`, image: a.image, vehicleConfiguration: a.category },
    { "@type": "Vehicle", name: b.name, brand: { "@type": "Brand", name: b.brand }, url: `https://www.ksrentsardinia.com${b.href}`, image: b.image, vehicleConfiguration: b.category },
  ],
}];
---
<BaseLayout
  title="Mercedes Classe A vs Jeep Avenger Olbia : premium ou SUV ?"
  description="Comparaison Mercedes Classe A 180d diesel vs Jeep Avenger SUV : consommation, confort, tout-terrain, prix. Quelle voiture louer a Olbia."
  canonical={pageUrl}
  jsonLd={jsonLd}
  breadcrumbs={[{ name: "Flotte", path: "/fr/flotte" }, { name: "Mercedes Classe A vs Jeep Avenger", path: "/fr/flotte/comparer/mercedes-classe-a-vs-jeep-avenger" }]}
>
  <VehicleComparison a={a} b={b} h1={h1} intro={intro} lang={lang} />
</BaseLayout>
