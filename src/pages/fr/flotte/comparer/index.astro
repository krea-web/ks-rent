---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ArrowRight, GitCompareArrows } from "lucide-react";
import { getTranslatedSpec, compareUrl } from "@/data/vehicle-specs-i18n";

const lang = "fr" as const;

const comparisons = [
  { aSlug: "audi-rs3", bSlug: "bmw-m2", url: compareUrl(lang, "audi-rs3-vs-bmw-m2"), eyebrow: "Sport vs sport", note: "400 ch transmission integrale vs 460 ch propulsion" },
  { aSlug: "audi-rs3", bSlug: "mercedes-classe-a", url: compareUrl(lang, "audi-rs3-vs-mercedes-classe-a"), eyebrow: "Sport vs Premium", note: "Experience pure pour quelques jours vs tour Sardaigne confortable" },
  { aSlug: "bmw-m2", bSlug: "mercedes-classe-a", url: compareUrl(lang, "bmw-m2-vs-mercedes-classe-a"), eyebrow: "Sport vs Premium", note: "460 ch pour courts sejours vs confort diesel 7-14 jours" },
  { aSlug: "audi-rs3", bSlug: "jeep-avenger", url: compareUrl(lang, "audi-rs3-vs-jeep-avenger"), eyebrow: "Supercar vs SUV", note: "Experience Costa Smeralda vs flexibilite vers plages tout-terrain" },
  { aSlug: "mercedes-classe-a", bSlug: "jeep-avenger", url: compareUrl(lang, "mercedes-classe-a-vs-jeep-avenger"), eyebrow: "Premium vs SUV", note: "Confort autoroutier diesel vs polyvalence famille + tout-terrain" },
  { aSlug: "jeep-avenger", bSlug: "fiat-panda", url: compareUrl(lang, "jeep-avenger-vs-fiat-panda"), eyebrow: "SUV vs citadine", note: "Plages cachees par chemin de terre vs centres historiques etroits" },
].map((c) => ({
  ...c,
  a: getTranslatedSpec(c.aSlug, lang),
  b: getTranslatedSpec(c.bSlug, lang),
}));

const pageUrl = "https://www.ksrentsardinia.com/fr/flotte/comparer";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${pageUrl}#page`,
    name: "Comparaisons vehicules location Olbia",
    description: "Comparaisons techniques detaillees des vehicules de location KS Rent Sardinia : supercars, premium, SUV et citadines a Olbia et Costa Smeralda.",
    url: pageUrl,
    inLanguage: "fr-FR",
    isPartOf: { "@id": "https://www.ksrentsardinia.com/#website" },
    hasPart: comparisons.map((c) => ({
      "@type": "WebPage",
      name: `${c.a.name} vs ${c.b.name}`,
      url: `https://www.ksrentsardinia.com${c.url}`,
    })),
  },
];
---
<BaseLayout
  title="Comparaisons vehicules Olbia | KS Rent Sardinia"
  description="Comparaisons detaillees des vehicules de location KS Rent Sardinia : Audi RS3 vs BMW M2, Mercedes Classe A vs Audi RS3, Jeep Avenger vs Fiat Panda."
  canonical={pageUrl}
  jsonLd={jsonLd}
  breadcrumbs={[
    { name: "Flotte", path: "/fr/flotte" },
    { name: "Comparer", path: "/fr/flotte/comparer" },
  ]}
>
  <div class="bg-background min-h-screen">
    <section class="relative overflow-hidden border-b border-border">
      <div class="absolute inset-0 bg-gradient-to-br from-card via-background to-card pointer-events-none"></div>
      <div class="relative max-w-5xl mx-auto px-4 md:px-12 pt-32 pb-16">
        <span class="inline-flex items-center gap-2 text-gold font-bold tracking-[0.3em] uppercase text-[10px] mb-4">
          <GitCompareArrows className="w-3.5 h-3.5" />
          Comparaisons vehicules
        </span>
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-black italic uppercase tracking-tighter text-foreground leading-[0.95]">
          Quel vehicule choisir
        </h1>
        <p class="mt-6 text-lg text-foreground/70 font-light max-w-2xl leading-relaxed">
          Comparaisons techniques detaillees des vehicules de location KS Rent Sardinia. Specifications, prix, conseils pratiques pour choisir le bon vehicule pour vos vacances en Costa Smeralda.
        </p>
      </div>
    </section>

    <section class="py-16 md:py-20 px-4 md:px-12">
      <div class="max-w-5xl mx-auto grid gap-6">
        {comparisons.map((c) => (
          <a
            href={c.url}
            class="group block bg-card border border-border rounded-2xl overflow-hidden hover:border-primary transition shadow-sm hover:shadow-lg"
          >
            <div class="grid md:grid-cols-[1fr,auto,1fr,auto] items-center gap-4 p-6 md:p-8">
              <div class="flex items-center gap-4">
                <img src={c.a.image} alt={`${c.a.name} location voiture Olbia`} width="100" height="70" loading="lazy" class="h-14 w-20 object-contain shrink-0" />
                <div>
                  <p class="font-bold text-foreground">{c.a.name}</p>
                  <p class="text-xs text-foreground/50">{c.a.category}</p>
                </div>
              </div>
              <span class="text-gold font-black text-3xl text-center">vs</span>
              <div class="flex items-center gap-4">
                <img src={c.b.image} alt={`${c.b.name} location voiture Olbia`} width="100" height="70" loading="lazy" class="h-14 w-20 object-contain shrink-0" />
                <div>
                  <p class="font-bold text-foreground">{c.b.name}</p>
                  <p class="text-xs text-foreground/50">{c.b.category}</p>
                </div>
              </div>
              <ArrowRight className="w-5 h-5 text-foreground/40 group-hover:text-primary group-hover:translate-x-1 transition" />
            </div>
            <div class="px-6 md:px-8 pb-6 md:pb-8 -mt-2">
              <p class="text-xs uppercase tracking-widest text-gold font-bold mb-1">{c.eyebrow}</p>
              <p class="text-sm text-foreground/70">{c.note}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="py-16 px-4 md:px-12 bg-card/30 border-t border-border">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl font-black italic uppercase tracking-tighter text-foreground mb-4">
          Encore indecis ?
        </h2>
        <p class="text-foreground/60 font-light mb-8">
          Francesco et Salvatore Milo sont disponibles sur WhatsApp +39 344 6107071 pour vous conseiller le bon vehicule selon votre itineraire.
        </p>
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a href="/fr/flotte" class="inline-flex items-center gap-2 px-8 py-4 border border-border text-foreground font-bold rounded-full hover:border-gold transition">Flotte complete</a>
          <a href="/fr/reserver" class="inline-flex items-center gap-2 px-8 py-4 bg-gold text-background font-bold rounded-full hover:scale-105 transition-transform shadow-lg">
            Verifier disponibilite
            <ArrowRight className="w-4 h-4" />
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
