---
import BaseLayout from "@/layouts/BaseLayout.astro";
import VehicleComparison from "@/components/VehicleComparison.astro";
import { getTranslatedSpec } from "@/data/vehicle-specs-i18n";

const lang = "fr" as const;
const a = getTranslatedSpec("audi-rs3", lang);
const b = getTranslatedSpec("mercedes-classe-a", lang);

const h1 = "Audi RS3 vs Mercedes Classe A : sportive ou premium pour la Sardaigne ?";
const intro =
  "Audi RS3 et Mercedes Classe A 180d representent deux philosophies differentes de la location premium a Olbia. La RS3 est une supercar pure : 400 ch, transmission integrale quattro, 0-100 en 3,8 secondes, tarif sur devis. La Classe A 180d est une compacte premium diesel : 116 ch, boite automatique 7G-DCT, consommation moyenne 4,5 L/100km, tarif fixe publie a partir de 90 €/jour. Chez KS Rent Sardinia, les deux sont disponibles avec livraison a domicile en Costa Smeralda. Le choix depend de l'objectif : experience sportive intense pour quelques jours en Costa Smeralda, ou tour de Sardaigne confortable pour 7-14 jours avec faible consommation.";

const pageUrl = "https://www.ksrentsardinia.com/fr/flotte/comparer/audi-rs3-vs-mercedes-classe-a";
const jsonLd = [{
  "@context": "https://schema.org", "@type": "WebPage", "@id": `${pageUrl}#page`,
  name: h1, description: intro.slice(0, 220), url: pageUrl, inLanguage: "fr-FR",
  isPartOf: { "@id": "https://www.ksrentsardinia.com/#website" },
  primaryImageOfPage: a.image,
  about: [
    { "@type": "Vehicle", name: a.name, brand: { "@type": "Brand", name: a.brand }, url: `https://www.ksrentsardinia.com${a.href}`, image: a.image, vehicleConfiguration: a.category },
    { "@type": "Vehicle", name: b.name, brand: { "@type": "Brand", name: b.brand }, url: `https://www.ksrentsardinia.com${b.href}`, image: b.image, vehicleConfiguration: b.category },
  ],
}];
---
<BaseLayout
  title="Audi RS3 vs Mercedes Classe A : location voiture Olbia | KS Rent"
  description="Comparaison Audi RS3 supercar vs Mercedes Classe A premium pour la location a Olbia. Prix, performances, consommation, quand choisir chacune."
  canonical={pageUrl}
  jsonLd={jsonLd}
  breadcrumbs={[{ name: "Flotte", path: "/fr/flotte" }, { name: "Audi RS3 vs Mercedes Classe A", path: "/fr/flotte/comparer/audi-rs3-vs-mercedes-classe-a" }]}
>
  <VehicleComparison a={a} b={b} h1={h1} intro={intro} lang={lang} />
</BaseLayout>
