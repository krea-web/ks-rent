    olbiaAutoRentalJsonLd,
    olbiaFaqJsonLd,
    buildBreadcrumb("Location Voiture Olbia", "/fr/location-voiture-olbia"),
  ]}
  breadcrumbs={[{ name: "Location Voiture Olbia", path: "/fr/location-voiture-olbia" }]}
