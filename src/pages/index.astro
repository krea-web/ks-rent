---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HeroSection from "@/components/HeroSection";
import TrustMarquee from "@/components/TrustMarquee";
import FleetShowcase from "@/components/FleetShowcase";
import FleetGrid from "@/components/FleetGrid.astro";
import GuideSpotlight from "@/components/GuideSpotlight.astro";
import FAQSection from "@/components/FAQSection";
import GoogleReviews from "@/components/GoogleReviews";
import { supabase } from "@/lib/supabase";

// Fetch reviews al build-time da Supabase
const { data: reviewsData } = await supabase
  .from("reviews")
  .select("author_name, author_photo_url, rating, text, published_at, is_featured")
  .eq("is_published", true)
  .order("is_featured", { ascending: false })
  .order("published_at", { ascending: false })
  .limit(3);

const { count: reviewsCount } = await supabase
  .from("reviews")
  .select("id", { count: "exact", head: true })
  .eq("is_published", true);

const { data: avgData } = await supabase
  .from("reviews")
  .select("rating")
  .eq("is_published", true);

const averageRating = avgData && avgData.length > 0
  ? avgData.reduce((s, r) => s + r.rating, 0) / avgData.length
  : null;
---
<BaseLayout
  title="Noleggio Auto Olbia | KS Rent Sardinia — Costa Smeralda"
  description="Noleggio auto a Olbia con consegna a domicilio in Costa Smeralda. SUV, supercar e city car senza carta di credito. Prenota online con KS Rent Sardinia."
  canonical="https://www.ksrentsardinia.com/"
  includeGlobalFaq={true}
  aggregateRating={
    averageRating !== null && (reviewsCount || 0) >= 5
      ? { ratingValue: averageRating, reviewCount: reviewsCount! }
      : undefined
  }
>
  <HeroSection lang="it" />
  <TrustMarquee lang="it" />
  <FleetShowcase lang="it" client:visible />
  <FleetGrid
    lang="it"
    heading="La nostra flotta"
    intro="Ogni veicolo ha la sua pagina con tariffe stagionali, varianti disponibili e destinazioni consigliate."
  />
  <GuideSpotlight lang="it" />
  <FAQSection lang="it" />
  <GoogleReviews
    reviews={reviewsData || []}
    totalCount={reviewsCount || 0}
    averageRating={averageRating ?? undefined}
    client:visible
  />

  {/* SEO RICH TEXT statico — letto direttamente da Google senza JS */}
  <section class="py-16 px-4 md:px-12 max-w-7xl mx-auto text-gray-600 dark:text-white/80 font-light leading-relaxed bg-background">
    <h2 class="text-3xl font-bold text-foreground mb-6">Noleggio Auto Olbia — Il tuo Autonoleggio di Fiducia</h2>
    <p class="mb-4">
      Cerchi un <strong>noleggio auto a Olbia</strong>? KS Rent Sardinia è l'<strong>autonoleggio Olbia</strong> di
      riferimento per chi vuole esplorare la Sardegna nord-orientale senza vincoli. Consegniamo SUV, supercar, city car,
      moto e quad direttamente al
      <a href="/noleggio-auto-porto-olbia" class="text-gold underline hover:text-gray-900 dark:hover:text-white transition-colors">Porto di Olbia</a>,
      all'<a href="/noleggio-auto-aeroporto-olbia" class="text-gold underline hover:text-gray-900 dark:hover:text-white transition-colors">Aeroporto Olbia Costa Smeralda</a>,
      al tuo hotel o alla tua villa — dalle 10:00 alle 22:30, 7 giorni su 7.
    </p>
    <p class="mb-4">
      <strong>
        Siamo una realtà orgogliosamente e unicamente sarda (P.IVA 03028900904), totalmente indipendente e non
        affiliata ad altre società omonime operanti nel resto d'Italia.
      </strong>
      Non siamo il classico autonoleggio o un intermediario web: possediamo fisicamente la nostra flotta — Audi RS3, BMW M2,
      Mercedes Classe A, Jeep Avenger, Fiat Panda, Honda SH — e la prepariamo maniacalmente per ogni cliente.
    </p>
    <p class="mb-4">
      Il nostro <strong>noleggio auto Olbia</strong> si distingue per un vantaggio concreto: accettiamo bancomat,
      prepagate e contanti per il deposito cauzionale. Nessuna carta di credito obbligatoria, nessun blocco sulla carta,
      nessuna sorpresa.
      <a href="/noleggio-auto-senza-carta-di-credito-olbia" class="text-gold underline hover:text-gray-900 dark:hover:text-white transition-colors">Scopri il noleggio senza carta di credito</a>.
    </p>

    <h3 class="text-2xl font-bold text-foreground mt-10 mb-4">Consegna a domicilio in tutta la Gallura e Costa Smeralda</h3>
    <p class="mb-4">
      Il servizio di <strong>autonoleggio a Olbia</strong> di KS Rent copre capillarmente tutta la Gallura. Consegniamo alle località più richieste:
      <a href="/noleggio-auto-porto-cervo" class="text-gold underline hover:text-gray-900 dark:hover:text-white transition-colors">Porto Cervo</a>,
      <a href="/noleggio-auto-san-teodoro" class="text-gold underline hover:text-gray-900 dark:hover:text-white transition-colors">San Teodoro</a>,
      <a href="/noleggio-auto-baja-sardinia" class="text-gold underline hover:text-gray-900 dark:hover:text-white transition-colors">Baja Sardinia</a>,
      <a href="/noleggio-auto-palau" class="text-gold underline hover:text-gray-900 dark:hover:text-white transition-colors">Palau</a>,
      <a href="/noleggio-auto-porto-rotondo" class="text-gold underline hover:text-gray-900 dark:hover:text-white transition-colors">Porto Rotondo</a>,
      <a href="/noleggio-auto-budoni" class="text-gold underline hover:text-gray-900 dark:hover:text-white transition-colors">Budoni</a> e la
      <a href="/noleggio-auto-costa-smeralda" class="text-gold underline hover:text-gray-900 dark:hover:text-white transition-colors">Costa Smeralda</a>.
      Il tuo <strong>noleggio auto a Olbia</strong> inizia dal momento in cui atterri o sbarchi dal traghetto.
    </p>

    <h3 class="text-2xl font-bold text-foreground mt-10 mb-4">Le spiagge più belle a portata di auto</h3>
    <p class="mb-4">
      Con un SUV KS Rent raggiungi anche le calette più nascoste della Sardegna nord-orientale:
      <a href="/spiaggia-del-principe" class="text-gold underline hover:text-gray-900 dark:hover:text-white transition-colors">Spiaggia del Principe</a>,
      <a href="/cala-brandinchi" class="text-gold underline hover:text-gray-900 dark:hover:text-white transition-colors">Cala Brandinchi</a>,
      <a href="/la-cinta" class="text-gold underline hover:text-gray-900 dark:hover:text-white transition-colors">La Cinta</a>,
      <a href="/capriccioli" class="text-gold underline hover:text-gray-900 dark:hover:text-white transition-colors">Capriccioli</a> e
      <a href="/porto-istana" class="text-gold underline hover:text-gray-900 dark:hover:text-white transition-colors">Porto Istana</a> con vista su Tavolara.
      Per le spiagge con sterrato consigliamo il Jeep Avenger; per le panoramiche costiere, l'Audi RS3 o la BMW M2.
    </p>
  </section>
</BaseLayout>
