---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Flotta, { flottaFaqJsonLd, flottaBreadcrumbJsonLd } from "@/views/Flotta";
import FleetGrid from "@/components/FleetGrid.astro";
import FleetIntro from "@/components/FleetIntro.astro";
import { flottaJsonLd, buildCollectionPageJsonLd } from "@/lib/jsonLd";
import { supabase } from "@/lib/supabase";

// Fetch primary variants per generare VehicleListing schema dinamico
const { data: vehiclesData } = await supabase
  .from("vehicles")
  .select("group_slug, make, model, category, fuel_type, year")
  .eq("is_primary_variant", true)
  .or("is_archived.is.null,is_archived.eq.false")
  .order("category");

const { data: seoData } = await supabase
  .from("seo_vehicles")
  .select("group_slug, title");

const seoTitleMap = new Map<string, string>();
for (const s of seoData || []) seoTitleMap.set(s.group_slug, s.title || "");

// VehicleListing schema (oltre a ItemList esistente): espone ogni veicolo
// come Vehicle entity con offer e collegamento a pagina dettaglio.
const vehicleListingJsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": "https://www.ksrentsardinia.com/flotta#vehicle-listing",
  name: "Flotta veicoli KS Rent Sardinia",
  numberOfItems: (vehiclesData || []).length,
  itemListElement: (vehiclesData || []).map((v, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "Vehicle",
      "@id": `https://www.ksrentsardinia.com/flotta/${v.group_slug || ""}#vehicle`,
      name: seoTitleMap.get(v.group_slug || "") || `${v.make} ${v.model}`,
      brand: { "@type": "Brand", name: v.make },
      model: v.model,
      vehicleConfiguration: v.category,
      fuelType: v.fuel_type,
      productionDate: v.year ? String(v.year) : undefined,
      url: `https://www.ksrentsardinia.com/flotta/${v.group_slug || ""}`,
      offers: {
        "@type": "Offer",
        url: `https://www.ksrentsardinia.com/flotta/${v.group_slug || ""}`,
        availability: "https://schema.org/InStock",
        priceCurrency: "EUR",
        seller: { "@id": "https://www.ksrentsardinia.com/#organization" },
      },
    },
  })),
};
---
<BaseLayout
  title="Flotta Veicoli KS Rent | Noleggio Auto Olbia"
  description="Scopri la flotta premium di KS Rent: auto sportive, SUV, city car, scooter e quad. Noleggio senza carta di credito a Olbia e Costa Smeralda."
  canonical="https://www.ksrentsardinia.com/flotta"
  ogImage="https://zgytnkimjpoosvshfopz.supabase.co/storage/v1/object/public/asset/og/flotta.webp"
  jsonLd={[flottaJsonLd, vehicleListingJsonLd, buildCollectionPageJsonLd({ name: "Flotta veicoli KS Rent Sardinia", description: "Pagina indice della flotta KS Rent Sardinia: auto sportive, SUV, city car, scooter e quad a noleggio a Olbia.", url: "https://www.ksrentsardinia.com/flotta", numberOfItems: (vehiclesData || []).length }), flottaFaqJsonLd]}
  breadcrumbs={[{ name: "Flotta", path: "/flotta" }]}
>
  <Flotta client:only="react" />
  <FleetGrid
    lang="it"
    heading="Tutti i nostri veicoli"
    intro="Scopri ogni modello in dettaglio: tariffe stagionali, varianti disponibili e destinazioni consigliate."
  />
  <FleetIntro lang="it" />
</BaseLayout>
