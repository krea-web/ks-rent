---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Flotta, { flottaFaqJsonLd, flottaBreadcrumbJsonLd } from "@/views/Flotta";
import FleetGrid from "@/components/FleetGrid.astro";
import { flottaJsonLd } from "@/lib/jsonLd";
---
<BaseLayout
  title="Flotta Veicoli KS Rent | Noleggio Auto Olbia"
  description="Scopri la flotta premium di KS Rent: auto sportive, SUV, city car, scooter e quad. Noleggio senza carta di credito a Olbia e Costa Smeralda."
  canonical="https://www.ksrentsardinia.com/flotta"
  jsonLd={[flottaJsonLd, flottaFaqJsonLd]}
  breadcrumbs={[{ name: "Flotta", path: "/flotta" }]}
>
  <Flotta client:load />
  <FleetGrid
    lang="it"
    heading="Tutti i nostri veicoli"
    intro="Scopri ogni modello in dettaglio: tariffe stagionali, varianti disponibili e destinazioni consigliate."
  />
</BaseLayout>
