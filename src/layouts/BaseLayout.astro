---
import "@/index.css";
import { localBusinessJsonLd, faqPageJsonLd, buildBreadcrumbJsonLd } from "@/lib/jsonLd";
import { getAlternateLinks, getLocaleFromPath, LOCALE_NAMES } from "@/lib/i18n";
import { getAggregateRating } from "@/lib/reviews";
import Navbar from "@/components/Navbar";
import Footer from "@/components/Footer";
import NewsletterSignup from "@/components/NewsletterSignup";
import WhatsAppCTA from "@/components/WhatsAppCTA";
import MobileStickyCTA from "@/components/MobileStickyCTA";

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, any> | Record<string, any>[];
  /** Mostra Navbar + Footer + CTA. Disattivato per /admin e /login. */
  showChrome?: boolean;
  /** Nasconde il MobileStickyCTA sulla pagina prenotaora */
  hideMobileSticky?: boolean;
  /** Inietta il FAQPage JSON-LD globale (homepage) */
  includeGlobalFaq?: boolean;
  /** Override aggregateRating in localBusinessJsonLd (es. dalla home con dati reali) */
  aggregateRating?: { ratingValue: number; reviewCount: number };
  /** Auto-inietta BreadcrumbList. Esempio: [{name: 'Flotta', path: '/flotta'}] */
  breadcrumbs?: { name: string; path: string }[];
}

const SITE = "https://www.ksrentsardinia.com";
// OG image trasformata via Supabase image render (1200x630 standard, ~50 KB)
const DEFAULT_OG = "https://zgytnkimjpoosvshfopz.supabase.co/storage/v1/render/image/public/asset/og-image.jpg?width=1200&height=630&resize=cover&quality=80";
const FAVICON = "https://zgytnkimjpoosvshfopz.supabase.co/storage/v1/object/public/asset/ksrent-favicon.webp";
const LOGO = "https://zgytnkimjpoosvshfopz.supabase.co/storage/v1/object/public/asset/KSRENTlogo.png";

const {
  title,
  description,
  canonical,
  ogImage = DEFAULT_OG,
  noindex = false,
  jsonLd,
  showChrome = true,
  hideMobileSticky = false,
  includeGlobalFaq = false,
  aggregateRating,
  breadcrumbs,
} = Astro.props;

// i18n: lingua corrente + hreflang alternates (definito PRIMA del JSON-LD per usare htmlLang)
const currentLocale = getLocaleFromPath(Astro.url.pathname);
const htmlLang = LOCALE_NAMES[currentLocale].htmlLang;
const alternateLinks = getAlternateLinks(Astro.url.pathname, SITE);

// AggregateRating: se la pagina passa la prop, usa quella; altrimenti fetch
// dal helper module-cached (build-time) che legge le reviews reali da Supabase.
// Niente valore hardcoded in localBusinessJsonLd: il dato resta sempre allineato.
// Override anche `inLanguage`. Deep-merge nel primo nodo di @graph: NON sul wrapper
// esterno, altrimenti Google legge "AggregateRating su parent_node invalido".
const ratingForSchema = aggregateRating ?? (await getAggregateRating());
const effectiveLocalBusinessJsonLd = {
  ...localBusinessJsonLd,
  "@graph": localBusinessJsonLd["@graph"].map((node: any, i: number) =>
    i === 0
      ? {
          ...node,
          inLanguage: htmlLang,
          ...(ratingForSchema
            ? {
                aggregateRating: {
                  "@type": "AggregateRating",
                  ratingValue: Number(ratingForSchema.ratingValue.toFixed(1)),
                  reviewCount: ratingForSchema.reviewCount,
                  bestRating: 5,
                  worstRating: 1,
                },
              }
            : {}),
        }
      : node,
  ),
};

// BreadcrumbList auto-injected
const autoBreadcrumbJsonLd = breadcrumbs && breadcrumbs.length > 0
  ? buildBreadcrumbJsonLd(breadcrumbs)
  : null;

// Canonical: forza https://www.ksrentsardinia.com + rimuove trailing slash (eccetto root)
let canonicalUrl = canonical
  ? canonical
  : new URL(Astro.url.pathname, SITE).href;
if (!canonicalUrl.startsWith(SITE)) {
  try {
    const parsed = new URL(canonicalUrl);
    canonicalUrl = `${SITE}${parsed.pathname}`;
  } catch {
    /* keep */
  }
}
if (canonicalUrl.endsWith("/") && canonicalUrl !== `${SITE}/`) {
  canonicalUrl = canonicalUrl.slice(0, -1);
}

// Normalizza il jsonLd custom in array per emettere uno script per ogni schema
const customJsonLdList: Record<string, any>[] = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="theme-color" content="#000000" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="KS Rent S.R.L." />
    <meta
      name="robots"
      content={noindex
        ? "noindex, nofollow"
        : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"}
    />
    <meta name="format-detection" content="telephone=yes, date=no, email=no, address=no" />

    <link rel="canonical" href={canonicalUrl} />
    {alternateLinks.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}

    <!-- Geo tags -->
    <meta name="geo.region" content="IT-SS" />
    <meta name="geo.placename" content="Olbia" />
    <meta name="geo.position" content="40.923018;9.520169" />
    <meta name="ICBM" content="40.923018, 9.520169" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={htmlLang.replace("-", "_")} />
    {currentLocale !== "it" && (
      <>
        <meta property="og:locale:alternate" content="it_IT" />
        {currentLocale !== "en" && <meta property="og:locale:alternate" content="en_GB" />}
        {currentLocale !== "de" && <meta property="og:locale:alternate" content="de_DE" />}
        {currentLocale !== "fr" && <meta property="og:locale:alternate" content="fr_FR" />}
      </>
    )}
    <meta property="og:site_name" content="KS Rent Sardinia" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ksrentsardinia" />
    <meta name="twitter:creator" content="@ksrentsardinia" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Icons & Manifest -->
    <link rel="icon" type="image/webp" href={FAVICON} />
    <link rel="apple-touch-icon" href={FAVICON} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="msapplication-config" content="/browserconfig.xml" />

    <!-- Preconnect: solo le origini critiche per il primo render
         (Supabase asset + Google Fonts). I preconnect Maps/iubenda sono
         dns-prefetch perche caricati on-demand (CompanyMap client:visible
         + iubenda widget defer). Riduce concorrenza preconnect a 4 max. -->
    <link rel="preconnect" href="https://zgytnkimjpoosvshfopz.supabase.co" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="dns-prefetch" href="https://maps.googleapis.com" />
    <link rel="dns-prefetch" href="https://maps.gstatic.com" />
    <link rel="dns-prefetch" href="https://embeds.iubenda.com" />
    <link rel="dns-prefetch" href="https://cdn.iubenda.com" />
    <link rel="dns-prefetch" href="https://idb.iubenda.com" />

    <!-- Logo preload -->
    <link rel="preload" as="image" href={LOGO} fetchpriority="high" />

    <!-- Fonts (print-swap technique) -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Playfair+Display:wght@700;800;900&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Playfair+Display:wght@700;800;900&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&family=Playfair+Display:wght@700;800;900&display=swap"
      />
    </noscript>

    <!-- Anti-flash dark mode -->
    <script is:inline>
      (function () {
        try {
          var key = "ksrent-ui-theme";
          var t = localStorage.getItem(key) || "dark";
          var apply = t;
          if (t === "system") {
            apply = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          }
          document.documentElement.classList.add(apply === "light" ? "light" : "dark");
        } catch (e) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>

    <!-- JSON-LD globale (Organization + WebSite + AggregateRating) -->
    <script type="application/ld+json" set:html={JSON.stringify(effectiveLocalBusinessJsonLd)} />

    {includeGlobalFaq && (
      <script type="application/ld+json" set:html={JSON.stringify(faqPageJsonLd)} />
    )}

    {autoBreadcrumbJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(autoBreadcrumbJsonLd)} />
    )}

    {customJsonLdList.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Iubenda: defer per non bloccare LCP. Il widget si attiva
         dopo il caricamento iniziale, l'utente non perde nulla a livello
         compliance perche lo script aggiunge il banner dinamicamente. -->
    <script
      type="text/javascript"
      src="https://embeds.iubenda.com/widgets/0ba8fa23-7357-47fd-827e-809c2c13c61f.js"
      defer
    ></script>

    <!-- GA4 + Google Ads -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-1JL353W8QW"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){ dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", "G-1JL353W8QW");
      gtag("config", "AW-18006357660");
    </script>
  </head>

  <body class="bg-background text-foreground antialiased font-sans overflow-x-hidden">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-md focus:bg-gold focus:text-background focus:font-semibold focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-gold/40"
    >
      {currentLocale === "en" ? "Skip to main content" : currentLocale === "de" ? "Zum Hauptinhalt springen" : currentLocale === "fr" ? "Aller au contenu principal" : "Vai al contenuto principale"}
    </a>
    {showChrome && <Navbar lang={currentLocale} client:load />}
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    {showChrome && (
      <section class="bg-card border-t border-border py-12 md:py-16 px-4 md:px-8">
        <div class="max-w-2xl mx-auto">
          <NewsletterSignup lang={currentLocale} client:idle />
        </div>
      </section>
    )}
    {showChrome && <Footer lang={currentLocale} />}
    {showChrome && <WhatsAppCTA lang={currentLocale} client:idle />}
    {showChrome && !hideMobileSticky && <MobileStickyCTA lang={currentLocale} client:idle />}

    <script type="text/javascript" src="https://cdn.iubenda.com/iubenda.js" defer></script>
  </body>
</html>
