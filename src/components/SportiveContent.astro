        { icon: "🏁", title: "De vraies sportives, pas des vitrines.", text: "L'Audi RS3 et la BMW M2 comptent parmi les sportives les plus désirables et amusantes à conduire. Pas d'exotiques de musée : des voitures que vous utilisez vraiment, chaque jour." },
        { icon: "🛣️", title: "Des routes de carte postale.", text: "La route côtière vers Porto Cervo, les virages de Capo Ceraso, la SP59 panoramique : des parcours faits pour être conduits avec une voiture à la hauteur." },
        { icon: "🔑", title: "Notre propre flotte.", text: "Nous ne sommes pas un courtier : la flotte est la nôtre, vérifiée avant chaque location. Nous connaissons chaque voiture et répondons personnellement — nous sommes les propriétaires." },
        { icon: "⭐", title: "5,0/5 sur Google.", text: "42 avis vérifiés. Livraison gratuite à Olbia et paiement même sans carte de crédit, sportives comprises." },
      ],
    },
    vehicles: {
      heading: "Nos voitures sportives à Olbia",
      lead: "Trois interprétations différentes du plaisir de conduite, toutes disponibles avec livraison à domicile en Gallura.",
      items: [
        { slug: "audi-rs3" as const, img: ASSETS.rs3, name: "Audi RS3 Sportback", desc: "Le cinq cylindres turbo de 400 ch : transmission intégrale quattro, accélération foudroyante et son inimitable. La sportive la plus complète de la flotte, sûre et amusante sur chaque route de la Costa Smeralda.", spec: "400 ch · quattro · Essence" },
        { slug: "bmw-m2" as const, img: ASSETS.m2, name: "BMW M2 Coupé", desc: "Propulsion arrière, moteur six cylindres en ligne et proportions compactes : la M2 est la conduite à l'état pur. Pour ceux qui cherchent l'expérience la plus engageante sur les virages de la Gallura.", spec: "Coupé · propulsion · Essence" },
        { slug: "mercedes-classe-a" as const, img: ASSETS.classea, name: "Mercedes Classe A 180d", desc: "L'alternative premium : intérieur soigné, infodivertissement haut de gamme et consommation diesel maîtrisée. Confort et style pour qui veut une voiture élégante sans renoncer au plaisir de conduite.", spec: "Premium · diesel · confort" },
      ],
      seeLabel: "Fiche complète →",
    },
    routes: {
      heading: "Où les conduire : les plus beaux itinéraires depuis Olbia",
      lead: "Les itinéraires préférés de nos clients au volant d'une sportive. Nous livrons directement dans ces localités.",
      spots: [
        { label: "Porto Cervo & la SP59", slug: "porto-cervo", time: "~ 35 min" },
        { label: "Baja Sardinia & Cannigione", slug: "baja-sardinia", time: "~ 35 min" },
        { label: "San Teodoro & la côte est", slug: "san-teodoro", time: "~ 25 min" },
        { label: "Golfo Aranci & Capo Figari", slug: "golfo-aranci", time: "~ 20 min" },
      ],
    },
    rates: {
      heading: "Tarifs et devis",
      body: "Les tarifs des sportives sont saisonniers et sur devis personnalisé, selon la période et la durée. La Mercedes Classe A démarre autour de 90 €/jour en basse saison ; pour l'Audi RS3 et la BMW M2 nous établissons un devis sur mesure. Caution et franchise varient selon le véhicule et sont communiquées en toute transparence avant la réservation — aucune surprise à la prise en charge.",
      ctaRates: "Voir la grille tarifaire →",
      ctaQuote: "Demander un devis sur WhatsApp →",
    },
    noCard: {
      heading: "Les sportives aussi sans carte de crédit",
      lead: "Contrairement aux grands réseaux, nous n'exigeons pas de carte de crédit, même pour les sportives. Nous acceptons les espèces, les cartes prépayées (Postepay, Revolut, N26), les cartes de débit et le virement, y compris pour la caution.",
      cta: "Comment fonctionne la location sans carte →",
    },
    faq: {
      heading: "Location de voiture sportive à Olbia — FAQ",
      items: [
        { q: "Quelles voitures sportives puis-je louer à Olbia ?", a: "L'Audi RS3 Sportback (400 ch), la BMW M2 Coupé et, en option premium, la Mercedes Classe A 180d. Elles nous appartiennent et sont vérifiées avant chaque location. Nous ne proposons pas de supercars exotiques : nous misons sur des sportives accessibles, fiables et amusantes." },
        { q: "Quel est l'âge minimum pour une sportive ?", a: "Pour l'Audi RS3 et la BMW M2, l'âge minimum est de 25 ans avec un permis B depuis au moins un an ; pour la Mercedes Classe A, à partir de 21 ans. À la prise en charge, il faut le permis, une pièce d'identité et le code fiscal." },
        { q: "Puis-je louer une sportive sans carte de crédit ?", a: "Oui. Nous acceptons le bancomat, les cartes de débit, les cartes prépayées rechargeables (Postepay, Revolut, N26) et les espèces, y compris pour la caution. La carte de crédit n'est pas obligatoire." },
        { q: "Livrez-vous la sportive à l'aéroport ou à l'hôtel ?", a: "Oui, livraison gratuite à l'aéroport d'Olbia Costa Smeralda (OLB) et au port d'Isola Bianca, ainsi qu'à votre hôtel ou villa dans toute la Gallura et la Costa Smeralda. Pour les livraisons hors d'Olbia, le coût est indiqué dans le devis." },
        { q: "Combien coûte la location d'une sportive à Olbia ?", a: "Tarifs saisonniers sur devis : la Mercedes Classe A démarre autour de 90 €/jour en basse saison ; pour la RS3 et la M2, écrivez-nous sur WhatsApp avec les dates et le véhicule pour un devis immédiat. Caution et franchise varient selon le véhicule et sont communiquées au préalable." },
      ],
    },
    cta: {
      heading: "Prêt à prendre le volant ?",
      addr1: "Siège : Viale Aldo Moro 367, Olbia · Livraison port : Viale Isola Bianca 38",
      addr2: "Ouvert 7 j/7, 10h00–13h00 et 15h00–22h30. Livraison gratuite à Olbia.",
      bookCta: "Réservez votre sportive",
      whatsappCta: "💬 Demander sur WhatsApp",
    },
  },
} satisfies Record<Lang, any>;

const t = T[lang];
const carHub = CAR_PAGE[lang];
const noCard = NOCARD_PAGE[lang];
const rates = RATES[lang];
const book = BOOK[lang];
---
<div class="bg-background">
  {/* HERO */}
  <section class="relative overflow-hidden border-b border-border/40 bg-gradient-to-br from-background via-background to-gold/5">
    <div class="container mx-auto px-4 py-16 md:py-24">
      <div class="max-w-4xl mx-auto text-center">
        <p class="text-xs uppercase tracking-[0.3em] text-gold font-bold mb-4">{t.eyebrow}</p>
        <h1 class="text-4xl md:text-6xl font-black italic uppercase tracking-tighter leading-[0.95] text-foreground">
          {t.titleLine1}<br /><span class="text-gold">{t.titleLine2}</span>
        </h1>
        <p class="mt-6 text-lg md:text-xl text-foreground/75 font-light max-w-3xl mx-auto leading-relaxed">{t.lead}</p>

        <div class="flex flex-wrap justify-center gap-3 mt-8 text-sm">
          <span class="px-4 py-2 bg-gold/10 border border-gold/30 text-foreground rounded-full font-medium">✓ {t.badge1}</span>
          <span class="px-4 py-2 bg-gold/10 border border-gold/30 text-foreground rounded-full font-medium">✓ {t.badge2}</span>
          <span class="px-4 py-2 bg-gold/10 border border-gold/30 text-foreground rounded-full font-medium" data-speakable>★ {t.badge3}</span>
        </div>

        <div class="flex flex-col sm:flex-row justify-center gap-4 mt-10">
          <a href={book} class="inline-flex items-center justify-center px-8 py-4 bg-gold text-background rounded-full font-bold uppercase tracking-wider text-sm hover:scale-105 transition-transform shadow-lg">{t.ctaBook}</a>
          <a href={WHATSAPP} rel="nofollow" class="inline-flex items-center justify-center px-8 py-4 border border-border text-foreground rounded-full font-bold uppercase tracking-wider text-sm hover:border-gold hover:text-gold transition-colors">{t.ctaQuote}</a>
        </div>
      </div>
    </div>
  </section>

  {/* WHY */}
  <section class="py-16 md:py-20 border-b border-border/40">
    <div class="container mx-auto px-4 max-w-5xl">
      <h2 class="text-3xl md:text-4xl font-black italic uppercase tracking-tighter text-foreground mb-4">{t.why.heading}</h2>
      <p class="text-lg text-foreground/70 font-light leading-relaxed mb-10 max-w-3xl">{t.why.lead}</p>
      <ul class="grid md:grid-cols-2 gap-6">
        {t.why.bullets.map((b) => (
          <li class="flex gap-4 bg-card border border-border rounded-2xl p-6">
            <span class="text-2xl shrink-0">{b.icon}</span>
            <div>
              <strong class="block text-foreground font-bold mb-1">{b.title}</strong>
              <span class="text-sm text-foreground/70 leading-relaxed">{b.text}</span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* VEHICLES */}
  <section class="py-16 md:py-20 border-b border-border/40 bg-card/30">
    <div class="container mx-auto px-4 max-w-6xl">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-black italic uppercase tracking-tighter text-foreground">{t.vehicles.heading}</h2>
        <p class="text-foreground/60 font-light mt-3 max-w-2xl mx-auto">{t.vehicles.lead}</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {t.vehicles.items.map((v) => (
          <a href={fleetHref(v.slug)} class="group block bg-background border border-border rounded-2xl overflow-hidden hover:border-gold/50 hover:shadow-xl transition">
            <div class="aspect-[4/3] flex items-center justify-center p-6 bg-gradient-to-br from-card to-background">
              <img src={v.img} alt={`Noleggio ${v.name} a Olbia — KS Rent Sardinia`} width="600" height="450" class="w-full h-full object-contain drop-shadow-2xl group-hover:scale-105 transition-transform" loading="lazy" decoding="async" />
            </div>
            <div class="p-5 border-t border-border/60">
              <span class="text-gold text-[10px] font-bold tracking-[0.2em] uppercase">{v.spec}</span>
              <h3 class="text-xl font-black italic uppercase tracking-tight text-foreground mt-1">{v.name}</h3>
              <p class="text-sm text-foreground/70 font-light mt-2 leading-relaxed">{v.desc}</p>
              <span class="inline-flex items-center gap-1 text-sm font-semibold text-foreground mt-4 group-hover:text-gold transition">{t.vehicles.seeLabel}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* ROUTES */}
  <section class="py-16 md:py-20 border-b border-border/40">
    <div class="container mx-auto px-4 max-w-5xl">
      <h2 class="text-3xl md:text-4xl font-black italic uppercase tracking-tighter text-foreground mb-3">{t.routes.heading}</h2>
      <p class="text-foreground/70 font-light leading-relaxed mb-8 max-w-3xl">{t.routes.lead}</p>
      <div class="grid sm:grid-cols-2 gap-4">
        {t.routes.spots.map((s) => (
          <a href={locHref(s.slug)} class="flex items-center justify-between bg-card border border-border rounded-xl px-5 py-4 hover:border-gold/50 hover:text-gold transition">
            <span class="font-semibold text-foreground">{s.label}</span>
            <span class="text-sm text-foreground/50">{s.time}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {/* RATES */}
  <section class="py-16 md:py-20 border-b border-border/40 bg-card/30">
    <div class="container mx-auto px-4 max-w-4xl">
      <h2 class="text-3xl md:text-4xl font-black italic uppercase tracking-tighter text-foreground mb-4">{t.rates.heading}</h2>
      <p class="text-lg text-foreground/75 font-light leading-relaxed">{t.rates.body}</p>
      <div class="flex flex-wrap gap-3 mt-6">
        <a href={rates} class="inline-flex items-center gap-2 text-sm font-semibold text-foreground border border-border rounded-full px-4 py-2 hover:border-gold hover:text-gold transition-colors">{t.rates.ctaRates}</a>
        <a href={WHATSAPP} rel="nofollow" class="inline-flex items-center gap-2 text-sm font-semibold text-background bg-gold rounded-full px-4 py-2 hover:scale-105 transition-transform">{t.rates.ctaQuote}</a>
      </div>
    </div>
  </section>

  {/* NO CARD */}
  <section class="py-16 md:py-20 border-b border-border/40">
    <div class="container mx-auto px-4 max-w-4xl">
      <h2 class="text-2xl md:text-3xl font-black italic uppercase tracking-tighter text-foreground mb-3">{t.noCard.heading}</h2>
      <p class="text-lg text-foreground/75 font-light leading-relaxed">{t.noCard.lead}</p>
      <a href={noCard} class="inline-flex items-center gap-2 text-sm font-semibold text-gold mt-5 hover:underline underline-offset-4">{t.noCard.cta}</a>
    </div>
  </section>

  {/* FAQ (statiche, crawler-friendly) */}
  <section class="py-16 md:py-20 border-b border-border/40 bg-card/30">
    <div class="container mx-auto px-4 max-w-4xl">
      <h2 class="text-3xl md:text-4xl font-black italic uppercase tracking-tighter text-foreground mb-8">{t.faq.heading}</h2>
      <div class="space-y-4">
        {t.faq.items.map((f) => (
          <details class="bg-background border border-border rounded-xl overflow-hidden group">
            <summary class="px-6 py-5 cursor-pointer text-foreground font-semibold hover:text-gold transition list-none">{f.q}</summary>
            <div class="px-6 pb-5"><p class="text-foreground/70 font-light leading-relaxed faq-answer">{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* CTA */}
  <section class="relative bg-gold text-background py-20 md:py-24 text-center px-4 overflow-hidden">
    <div class="relative max-w-3xl mx-auto">
      <h2 class="font-serif text-3xl md:text-5xl font-medium leading-tight mb-5">{t.cta.heading}</h2>
      <p class="font-serif text-background/85 text-base md:text-lg leading-relaxed mb-2">{t.cta.addr1}</p>
      <p class="font-serif text-background/75 text-sm md:text-base leading-relaxed mb-10">{t.cta.addr2}</p>
      <div class="flex flex-col sm:flex-row justify-center gap-4">
        <a href={book} class="inline-flex items-center justify-center gap-2 bg-background text-foreground font-semibold tracking-wide text-sm px-8 py-4 rounded-full hover:scale-105 transition-transform shadow-xl">{t.cta.bookCta}</a>
        <a href={WHATSAPP} rel="nofollow" class="inline-flex items-center justify-center gap-2 border border-background/40 text-background font-semibold tracking-wide text-sm px-8 py-4 rounded-full hover:bg-background/10 transition">{t.cta.whatsappCta}</a>
      </div>
    </div>
  </section>
</div>
