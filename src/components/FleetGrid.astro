---
import { supabase } from "@/lib/supabase";
import { ArrowRight } from "lucide-react";
import { getDict } from "@/i18n";
import { getFleetPath, type Locale } from "@/lib/i18n";

interface Props {
  heading?: string;
  intro?: string;
  lang?: Locale;
}

const { heading, intro, lang = "it" } = Astro.props as Props;
const t = getDict(lang);

const effectiveHeading = heading ?? t.fleet.allVehicles;
const effectiveIntro = intro ?? t.fleet.catalogIntro;

interface SeoVehicleRow {
  group_slug: string;
  title: string | null;
  h1: string | null;
  meta_description: string | null;
  hero_image_url: string | null;
  // multilingua
  title_en: string | null;
  title_de: string | null;
  title_fr: string | null;
  slug_en: string | null;
  slug_de: string | null;
  slug_fr: string | null;
}

interface VehicleRow {
  make: string;
  model: string;
  category: string;
  group_slug: string | null;
  is_primary_variant: boolean | null;
  is_archived: boolean | null;
  transparent_image_url: string | null;
  image_url: string | null;
  daily_rate: number | null;
  rate_april: number | null;
  rate_may: number | null;
  rate_june: number | null;
  rate_july: number | null;
  rate_august: number | null;
  rate_september: number | null;
  rate_october: number | null;
}

const [seoRes, vehRes] = await Promise.all([
  supabase.from("seo_vehicles").select("*"),
  supabase.from("vehicles").select("id, make, model, year, fuel_type, characteristics, color, daily_rate, image_url, logo_url, available, created_at, category, rate_april, rate_may, rate_june, rate_july, rate_august, rate_september, rate_october, group_slug, is_primary_variant, gallery_urls, transparent_image_url, is_archived, units").or("is_archived.is.null,is_archived.eq.false"),
]);

const seoRows = (seoRes.data || []) as SeoVehicleRow[];
const allVehicles = (vehRes.data || []) as VehicleRow[];

const fleetBase = getFleetPath(lang);
const fleetPrefix = lang === "it" ? fleetBase : `/${lang}${fleetBase}`;

// Currency formatter localizzato
const numberLocale =
  lang === "en" ? "en-GB" : lang === "de" ? "de-DE" : lang === "fr" ? "fr-FR" : "it-IT";
const formatPrice = (n: number) => `€${n.toLocaleString(numberLocale)}`;

const groups = seoRows
  .map((seo) => {
    const variants = allVehicles.filter((v) => v.group_slug === seo.group_slug);
    if (variants.length === 0) return null;
    const primary = variants.find((v) => v.is_primary_variant) || variants[0];
    const rates = variants
      .flatMap((v) => [
        v.rate_april, v.rate_may, v.rate_june, v.rate_july,
        v.rate_august, v.rate_september, v.rate_october,
        v.daily_rate,
      ])
      .filter((r): r is number => typeof r === "number" && r > 0);
    const priceFrom = rates.length ? Math.min(...rates) : null;

    // Slug + title localizzati con fallback IT
    const localizedSlug =
      lang === "it"
        ? seo.group_slug
        : (seo as any)[`slug_${lang}`] || seo.group_slug;
    const localizedTitle =
      lang === "it"
        ? seo.title || `${primary.make} ${primary.model}`
        : (seo as any)[`title_${lang}`] || seo.title || `${primary.make} ${primary.model}`;

    return {
      slug: localizedSlug,
      title: localizedTitle,
      category: primary.category,
      image: primary.transparent_image_url || seo.hero_image_url || primary.image_url,
      priceFrom,
      variantCount: variants.length,
    };
  })
  .filter((g): g is NonNullable<typeof g> => g !== null);
---
{groups.length > 0 && (
  <section class="py-16 md:py-24 px-4 md:px-12 bg-card">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-10">
        <span class="text-gold font-bold tracking-[0.3em] uppercase text-[10px]">{t.fleet.catalogEyebrow}</span>
        <h2 class="text-3xl md:text-5xl font-black italic uppercase tracking-tighter text-foreground mt-2">
          {effectiveHeading}
        </h2>
        {effectiveIntro && (
          <p class="text-foreground/60 font-light mt-4 max-w-2xl mx-auto leading-relaxed">{effectiveIntro}</p>
        )}
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {groups.map((g) => (
          <a
            href={`${fleetPrefix}/${g.slug}`}
            class="group relative bg-background border border-border rounded-2xl p-6 hover:border-gold/50 transition-all overflow-hidden"
          >
            <div class="absolute -top-10 -right-10 w-40 h-40 bg-gold/5 rounded-full blur-2xl group-hover:bg-gold/10 transition-colors pointer-events-none"></div>

            <div class="relative aspect-[3/2] flex items-center justify-center mb-4">
              {g.image ? (
                <img
                  src={g.image}
                  alt={g.title}
                  class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full bg-card/40 rounded-xl"></div>
              )}
            </div>

            <div class="relative">
              <span class="text-gold text-[10px] font-bold tracking-[0.2em] uppercase">
                {g.category}
              </span>
              <h3 class="text-foreground font-bold text-lg mt-1 group-hover:text-gold transition-colors">
                {g.title}
              </h3>
              <div class="mt-3 flex items-end justify-between">
                {g.priceFrom ? (
                  <div>
                    <span class="text-foreground/40 text-xs uppercase tracking-wider">{t.common.from}</span>
                    <span class="text-gold font-black text-xl ml-1">{formatPrice(g.priceFrom)}</span>
                    <span class="text-foreground/40 text-xs">{t.common.perDay}</span>
                  </div>
                ) : (
                  <span class="text-foreground/40 text-xs italic">{t.fleet.rentRequestPrice}</span>
                )}
                <span class="text-gold text-xs font-bold uppercase tracking-wider flex items-center gap-1 group-hover:gap-2 transition-all">
                  {t.cta.discover} <ArrowRight class="w-3 h-3" />
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}
