const t = T[lang];
---

<!-- COMPAGNIE AEREE -->
<section class="py-16 md:py-20 px-4 md:px-12 bg-card border-t border-border">
  <div class="max-w-5xl mx-auto">
    <span class="block text-gold font-bold tracking-[0.3em] uppercase text-[10px] mb-3">{t.airlinesEyebrow}</span>
    <h2 class="text-2xl md:text-4xl font-black italic uppercase tracking-tighter text-foreground mb-5">
      {t.airlinesHeading}
    </h2>
    <p class="text-foreground/75 font-light leading-relaxed mb-8" set:html={t.airlinesIntro}></p>

    <div class="bg-background border border-border rounded-2xl overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[640px]">
          <thead class="bg-card/50 border-b border-border">
            <tr>
              {t.airlinesTableHeaders.map((h) => (
                <th class="px-4 py-3 text-left text-xs uppercase tracking-wider text-foreground/50 font-bold">{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {t.airlinesData.map((row) => (
              <tr class="border-b border-border/50 last:border-0 hover:bg-card/30 transition-colors">
                <td class="px-4 py-3 font-bold text-foreground">{row[0]}</td>
                <td class="px-4 py-3 text-foreground/70">{row[1]}</td>
                <td class="px-4 py-3 text-gold font-semibold">{row[2]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <p class="text-xs text-foreground/55 mt-4 leading-relaxed">{t.airlinesNote}</p>
  </div>
</section>

<!-- DISTANZE TERMINAL -->
<section class="py-16 md:py-20 px-4 md:px-12 bg-background border-t border-border">
  <div class="max-w-5xl mx-auto">
    <span class="block text-gold font-bold tracking-[0.3em] uppercase text-[10px] mb-3">{t.distancesEyebrow}</span>
    <h2 class="text-2xl md:text-4xl font-black italic uppercase tracking-tighter text-foreground mb-5">
      {t.distancesHeading}
    </h2>
    <p class="text-foreground/75 font-light leading-relaxed mb-8" set:html={t.distancesIntro}></p>

    <div class="bg-card border border-border rounded-2xl overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[640px]">
          <thead class="bg-background/50 border-b border-border">
            <tr>
              {t.distancesTableHeaders.map((h) => (
                <th class="px-4 py-3 text-left text-xs uppercase tracking-wider text-foreground/50 font-bold">{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {t.distancesData.map((row) => (
              <tr class="border-b border-border/50 last:border-0">
                <td class="px-4 py-3 text-foreground/85">{row[0]}</td>
                <td class="px-4 py-3 text-foreground/85">{row[1]}</td>
                <td class="px-4 py-3 text-gold font-semibold">{row[2]}</td>
                <td class="px-4 py-3 text-foreground/70 font-medium">{row[3]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <p class="text-xs text-foreground/55 mt-4 leading-relaxed" set:html={t.distancesNote}></p>
  </div>
</section>

<!-- FAQ AVANZATA -->
<section class="py-16 md:py-20 px-4 md:px-12 bg-card border-t border-border">
  <div class="max-w-4xl mx-auto">
    <span class="block text-gold font-bold tracking-[0.3em] uppercase text-[10px] mb-3">{t.faqEyebrow}</span>
    <h2 class="text-2xl md:text-4xl font-black italic uppercase tracking-tighter text-foreground mb-10">
      {t.faqHeading}
    </h2>

    <div class="space-y-3">
      {t.faqs.map((faq, i) => (
        <details class="group bg-background border border-border rounded-2xl p-5 md:p-6 transition-colors hover:border-gold/40">
          <summary class="cursor-pointer list-none flex items-center justify-between gap-4">
            <span class="font-bold text-foreground text-[15px] md:text-base leading-snug">
              <span class="text-gold mr-2">{(i + 1).toString().padStart(2, "0")}.</span>
              {faq.q}
            </span>
            <span class="text-gold text-2xl shrink-0 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <div class="mt-4 text-foreground/75 font-light leading-relaxed text-sm md:text-[15px]" set:html={faq.a}></div>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- HUB GUIDE CORRELATE -->
<section class="py-16 md:py-20 px-4 md:px-12 bg-background border-t border-border">
  <div class="max-w-5xl mx-auto">
    <span class="block text-gold font-bold tracking-[0.3em] uppercase text-[10px] mb-3">{t.hubEyebrow}</span>
    <h2 class="text-2xl md:text-4xl font-black italic uppercase tracking-tighter text-foreground mb-3">
      {t.hubHeading}
    </h2>
    <p class="text-foreground/70 font-light mb-10 max-w-2xl">{t.hubIntro}</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {t.hubCards.map((c) => (
        <a
          href={c.href}
          class="block bg-card border border-border rounded-2xl p-6 hover:border-gold/50 hover:bg-card/80 transition-all group"
        >
          <h3 class="font-bold text-foreground group-hover:text-gold transition-colors text-lg mb-2 leading-tight">
            {c.title}
          </h3>
          <p class="text-foreground/65 font-light text-sm leading-relaxed">{c.desc}</p>
          <span class="inline-block mt-3 text-gold text-xs font-bold tracking-wider uppercase">→</span>
        </a>
      ))}
    </div>
  </div>
</section>
