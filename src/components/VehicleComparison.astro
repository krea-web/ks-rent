---
/**
 * Componente condiviso per pagine /flotta/confronta/[a]-vs-[b].
 * Renderizza l'intero body di una comparison page tra 2 veicoli.
 */
import { ArrowRight, CheckCircle2, XCircle, Zap, Fuel, Users, Car } from "lucide-react";
import type { VehicleSpec } from "@/data/vehicle-specs";

interface Props {
  a: VehicleSpec;
  b: VehicleSpec;
  /** H1 della pagina (es. "Audi RS3 vs BMW M2 a Olbia: quale scegliere?") */
  h1: string;
  /** Lead introduttivo (passaggio enciclopedico AI-citable, 80-150 parole) */
  intro: string;
}

const { a, b, h1, intro } = Astro.props;
---

<div class="bg-background min-h-screen">
  {/* HERO con 2 veicoli affiancati */}
  <section class="relative overflow-hidden border-b border-border">
    <div class="absolute inset-0 bg-gradient-to-br from-card via-background to-card pointer-events-none"></div>
    <div class="relative max-w-6xl mx-auto px-4 md:px-12 pt-32 pb-16">
      <span class="inline-flex items-center gap-2 text-gold font-bold tracking-[0.3em] uppercase text-[10px] mb-4">
        <Car className="w-3.5 h-3.5" />
        Confronto veicoli — KS Rent Sardinia
      </span>
      <h1 class="text-3xl md:text-5xl lg:text-6xl font-black italic uppercase tracking-tighter text-foreground leading-[1] mb-6">
        {h1}
      </h1>
      <p class="text-lg text-foreground/70 font-light max-w-3xl leading-relaxed">{intro}</p>

      {/* Side-by-side hero images */}
      <div class="mt-12 grid md:grid-cols-2 gap-6">
        <div class="bg-card border border-border rounded-2xl p-6 text-center">
          <span class="text-xs uppercase tracking-widest text-gold font-bold">{a.category}</span>
          <img
            src={a.image}
            alt={`Noleggio ${a.name} a Olbia con KS Rent Sardinia — confronto con ${b.name}`}
            width="400"
            height="280"
            loading="eager"
            class="mx-auto h-40 md:h-56 object-contain my-4"
          />
          <p class="font-bold text-2xl text-foreground">{a.name}</p>
          <p class="text-sm text-foreground/60 mt-2">{a.shortPitch}</p>
        </div>
        <div class="bg-card border border-border rounded-2xl p-6 text-center">
          <span class="text-xs uppercase tracking-widest text-gold font-bold">{b.category}</span>
          <img
            src={b.image}
            alt={`Noleggio ${b.name} a Olbia con KS Rent Sardinia — confronto con ${a.name}`}
            width="400"
            height="280"
            loading="eager"
            class="mx-auto h-40 md:h-56 object-contain my-4"
          />
          <p class="font-bold text-2xl text-foreground">{b.name}</p>
          <p class="text-sm text-foreground/60 mt-2">{b.shortPitch}</p>
        </div>
      </div>
    </div>
  </section>

  {/* TABELLA SPECS */}
  <section class="py-16 md:py-20 px-4 md:px-12 border-b border-border">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-black italic uppercase tracking-tighter text-foreground mb-8 text-center">
        Confronto tecnico
      </h2>
      <div class="overflow-x-auto bg-card border border-border rounded-2xl">
        <table class="w-full text-sm">
          <thead class="bg-background/50 border-b border-border">
            <tr>
              <th class="px-4 py-4 text-left text-xs uppercase tracking-wider text-foreground/50 font-bold">Specifica</th>
              <th class="px-4 py-4 text-center text-xs uppercase tracking-wider text-foreground/50 font-bold">{a.name}</th>
              <th class="px-4 py-4 text-center text-xs uppercase tracking-wider text-foreground/50 font-bold">{b.name}</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-border/50">
              <td class="px-4 py-3 font-semibold text-foreground/80">Potenza</td>
              <td class="px-4 py-3 text-center">{a.specs.power}</td>
              <td class="px-4 py-3 text-center">{b.specs.power}</td>
            </tr>
            <tr class="border-b border-border/50">
              <td class="px-4 py-3 font-semibold text-foreground/80">Cambio + trazione</td>
              <td class="px-4 py-3 text-center">{a.specs.transmission}</td>
              <td class="px-4 py-3 text-center">{b.specs.transmission}</td>
            </tr>
            <tr class="border-b border-border/50">
              <td class="px-4 py-3 font-semibold text-foreground/80">Alimentazione</td>
              <td class="px-4 py-3 text-center">{a.specs.fuel}</td>
              <td class="px-4 py-3 text-center">{b.specs.fuel}</td>
            </tr>
            <tr class="border-b border-border/50">
              <td class="px-4 py-3 font-semibold text-foreground/80">Posti</td>
              <td class="px-4 py-3 text-center">{a.specs.seats}</td>
              <td class="px-4 py-3 text-center">{b.specs.seats}</td>
            </tr>
            <tr class="border-b border-border/50">
              <td class="px-4 py-3 font-semibold text-foreground/80">Bagagliaio</td>
              <td class="px-4 py-3 text-center">{a.specs.bagagli}</td>
              <td class="px-4 py-3 text-center">{b.specs.bagagli}</td>
            </tr>
            <tr class="border-b border-border/50">
              <td class="px-4 py-3 font-semibold text-foreground/80">Consumo medio</td>
              <td class="px-4 py-3 text-center">{a.specs.consumo}</td>
              <td class="px-4 py-3 text-center">{b.specs.consumo}</td>
            </tr>
            {(a.specs.accelerazione0_100 || b.specs.accelerazione0_100) && (
              <tr class="border-b border-border/50">
                <td class="px-4 py-3 font-semibold text-foreground/80">0-100 km/h</td>
                <td class="px-4 py-3 text-center">{a.specs.accelerazione0_100 ?? "—"}</td>
                <td class="px-4 py-3 text-center">{b.specs.accelerazione0_100 ?? "—"}</td>
              </tr>
            )}
            {(a.specs.velocitaMax || b.specs.velocitaMax) && (
              <tr class="border-b border-border/50">
                <td class="px-4 py-3 font-semibold text-foreground/80">Velocità max</td>
                <td class="px-4 py-3 text-center">{a.specs.velocitaMax ?? "—"}</td>
                <td class="px-4 py-3 text-center">{b.specs.velocitaMax ?? "—"}</td>
              </tr>
            )}
            <tr class="border-b border-border/50">
              <td class="px-4 py-3 font-semibold text-foreground/80">Tariffa bassa stagione</td>
              <td class="px-4 py-3 text-center text-gold font-bold">{a.prezzi.bassaStagione}</td>
              <td class="px-4 py-3 text-center text-gold font-bold">{b.prezzi.bassaStagione}</td>
            </tr>
            <tr>
              <td class="px-4 py-3 font-semibold text-foreground/80">Tariffa alta stagione</td>
              <td class="px-4 py-3 text-center text-gold font-bold">{a.prezzi.altaStagione}</td>
              <td class="px-4 py-3 text-center text-gold font-bold">{b.prezzi.altaStagione}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {/* QUANDO SCEGLIERE */}
  <section class="py-16 md:py-20 px-4 md:px-12 border-b border-border bg-card/30">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-black italic uppercase tracking-tighter text-foreground mb-12 text-center">
        Quando scegliere quale
      </h2>
      <div class="grid md:grid-cols-2 gap-8">
        {/* Veicolo A */}
        <div class="bg-card border border-border rounded-2xl p-6 md:p-8">
          <h3 class="text-xl md:text-2xl font-bold text-foreground mb-4 flex items-center gap-3">
            <Zap className="w-5 h-5 text-gold" />
            Scegli {a.name} se:
          </h3>
          <ul class="space-y-3 mb-6">
            {a.ideale.map((item) => (
              <li class="flex gap-3 text-foreground/80 leading-relaxed">
                <CheckCircle2 className="w-5 h-5 text-gold shrink-0 mt-0.5" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <h4 class="font-bold text-foreground/70 mb-3 text-sm uppercase tracking-wider">Evita se:</h4>
          <ul class="space-y-2">
            {a.evitareSe.map((item) => (
              <li class="flex gap-3 text-foreground/60 text-sm leading-relaxed">
                <XCircle className="w-4 h-4 text-foreground/40 shrink-0 mt-0.5" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <a
            href={a.href}
            class="mt-8 inline-flex items-center gap-2 text-primary font-bold hover:underline"
          >
            Scopri {a.name} →
          </a>
        </div>

        {/* Veicolo B */}
        <div class="bg-card border border-border rounded-2xl p-6 md:p-8">
          <h3 class="text-xl md:text-2xl font-bold text-foreground mb-4 flex items-center gap-3">
            <Zap className="w-5 h-5 text-gold" />
            Scegli {b.name} se:
          </h3>
          <ul class="space-y-3 mb-6">
            {b.ideale.map((item) => (
              <li class="flex gap-3 text-foreground/80 leading-relaxed">
                <CheckCircle2 className="w-5 h-5 text-gold shrink-0 mt-0.5" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <h4 class="font-bold text-foreground/70 mb-3 text-sm uppercase tracking-wider">Evita se:</h4>
          <ul class="space-y-2">
            {b.evitareSe.map((item) => (
              <li class="flex gap-3 text-foreground/60 text-sm leading-relaxed">
                <XCircle className="w-4 h-4 text-foreground/40 shrink-0 mt-0.5" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <a
            href={b.href}
            class="mt-8 inline-flex items-center gap-2 text-primary font-bold hover:underline"
          >
            Scopri {b.name} →
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* CTA */}
  <section class="py-20 px-4 md:px-12">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-5xl font-black italic uppercase tracking-tighter text-foreground mb-4">
        Indeciso? Ti aiutiamo noi.
      </h2>
      <p class="text-foreground/60 font-light max-w-xl mx-auto mb-10 leading-relaxed">
        Francesco e Salvatore Milo rispondono direttamente su WhatsApp +39 344 6107071 per consigliarti il veicolo migliore in base al tuo itinerario in Costa Smeralda.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/prenotaora"
          class="inline-flex items-center gap-3 bg-gold text-background font-bold uppercase tracking-wider text-sm px-10 py-5 rounded-full hover:scale-105 transition-transform shadow-lg"
        >
          Verifica disponibilità
          <ArrowRight className="w-4 h-4" />
        </a>
        <a
          href="https://wa.me/393446107071"
          class="inline-flex items-center gap-3 border border-border text-foreground font-bold uppercase tracking-wider text-sm px-10 py-5 rounded-full hover:border-gold transition"
        >
          Chiedi su WhatsApp
        </a>
      </div>
    </div>
  </section>
</div>
