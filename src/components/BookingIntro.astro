---
/**
 * Blocco statico SEO per le pagine di prenotazione (4 lingue).
 *
 * Le pagine /prenotaora (+ /en/book-now, /de/jetzt-buchen, /fr/reserver)
 * montano <PrenotaOra client:only="react"> → ZERO testo server-side: i crawler
 * che NON eseguono JS (GPTBot, ClaudeBot, PerplexityBot) vedrebbero una pagina
 * vuota. Questo componente fornisce contenuto statico, indicizzabile e citabile:
 * come funziona la prenotazione (struttura HowTo), metodi di pagamento, consegna,
 * link interni a flotta/tariffe/hub. Va inserito DOPO l'isola React: l'utente
 * vede prima il wizard, i crawler leggono comunque tutto il testo.
 */
type Lang = "it" | "en" | "de" | "fr";
interface Props { lang?: Lang; }
const { lang = "it" } = Astro.props;

const FLEET: Record<Lang, string> = {
  it: "/flotta", en: "/en/fleet", de: "/de/fuhrpark", fr: "/fr/flotte",
};
const RATES: Record<Lang, string> = {
  it: "/tariffe", en: "/en/rates", de: "/de/preise", fr: "/fr/tarifs",
};
const CAR_HUB: Record<Lang, string> = {
  it: "/noleggio-auto-olbia", en: "/en/car-hire-olbia",
  de: "/de/autovermietung-olbia", fr: "/fr/location-voiture-olbia",
};
const NO_CARD: Record<Lang, string> = {
  it: "/noleggio-auto-senza-carta-di-credito-olbia", en: "/en/car-hire-no-credit-card-olbia",
  de: "/de/autovermietung-ohne-kreditkarte-olbia", fr: "/fr/location-voiture-sans-carte-credit-olbia",
};
const WHATSAPP = "https://wa.me/393446107071";

const T = {
  it: {
    heading: "Come prenotare il tuo noleggio a Olbia",
    lead: "Prenotare un veicolo con KS Rent Sardinia richiede pochi minuti, direttamente dal tuo smartphone. Scegli l'auto, la moto, lo scooter o il quad, indica le date e il luogo di consegna: ti aspettiamo all'Aeroporto di Olbia Costa Smeralda (OLB), al Porto Isola Bianca o in hotel, in tutta la Gallura e la Costa Smeralda.",
    stepsHeading: "I 4 passaggi della prenotazione",
    steps: [
      { t: "Scegli veicolo e date", d: "Seleziona il mezzo dalla flotta e indica la data di inizio e di fine del noleggio. Le tariffe sono stagionali (aprile–ottobre) e trasparenti." },
      { t: "Inserisci i tuoi dati", d: "Email e numero di telefono per la conferma, più la foto fronte e retro della patente (e di un eventuale secondo conducente)." },
      { t: "Scegli la consegna", d: "Aeroporto OLB, Porto Isola Bianca, hotel o villa: consegna gratuita nel comune di Olbia, su preventivo trasparente nelle altre località." },
      { t: "Firma dal telefono", d: "Firmi il contratto digitalmente e ricevi subito via email la conferma con il contratto allegato. Nessuna fila, nessuna attesa al banco." },
    ],
    payHeading: "Pagamento anche senza carta di credito",
    pay: "KS Rent Sardinia è uno dei pochi autonoleggi a Olbia che non impone la carta di credito tradizionale. Accettiamo contanti, bonifico bancario (anche istantaneo), carte prepagate ricaricabili come Postepay, Revolut e N26, bancomat e carte di debito. Il deposito cauzionale è proporzionato al veicolo e comunicato in modo chiaro prima del ritiro.",
    linksHeading: "Prima di prenotare",
    links: { fleet: "Vedi tutta la flotta", rates: "Consulta le tariffe stagionali", hub: "Noleggio auto a Olbia", noCard: "Noleggio senza carta di credito", whatsapp: "Chiedi un preventivo su WhatsApp" },
  },
  en: {
    heading: "How to book your rental in Olbia",
    lead: "Booking a vehicle with KS Rent Sardinia takes just a few minutes, straight from your smartphone. Choose the car, motorbike, scooter or quad, pick your dates and the delivery point: we meet you at Olbia Costa Smeralda Airport (OLB), at the Isola Bianca ferry port or at your hotel, across Gallura and the Costa Smeralda.",
    stepsHeading: "The 4 booking steps",
    steps: [
      { t: "Choose vehicle and dates", d: "Pick your vehicle from the fleet and set the rental start and end dates. Rates are seasonal (April–October) and transparent." },
      { t: "Enter your details", d: "Email and phone number for confirmation, plus front and back photos of your driving licence (and of any second driver)." },
      { t: "Choose the delivery", d: "Olbia Airport (OLB), Isola Bianca port, hotel or villa: free delivery within the town of Olbia, transparent quote elsewhere." },
      { t: "Sign from your phone", d: "Sign the contract digitally and instantly receive an email confirmation with the contract attached. No queues, no waiting at a desk." },
    ],
    payHeading: "Pay even without a credit card",
    pay: "KS Rent Sardinia is one of the few car hire companies in Olbia that does not require a traditional credit card. We accept cash, bank transfer (including instant), rechargeable prepaid cards such as Postepay, Revolut and N26, debit cards and bancomat. The security deposit is proportionate to the vehicle and clearly stated before pick-up.",
    linksHeading: "Before you book",
    links: { fleet: "See the whole fleet", rates: "Check the seasonal rates", hub: "Car hire in Olbia", noCard: "Car hire without a credit card", whatsapp: "Ask for a quote on WhatsApp" },
  },
  de: {
    heading: "So buchen Sie Ihre Anmietung in Olbia",
    lead: "Die Buchung eines Fahrzeugs bei KS Rent Sardinia dauert nur wenige Minuten, direkt vom Smartphone aus. Wählen Sie Auto, Motorrad, Roller oder Quad, geben Sie die Daten und den Lieferort an: Wir erwarten Sie am Flughafen Olbia Costa Smeralda (OLB), am Fährhafen Isola Bianca oder an Ihrem Hotel, in ganz Gallura und an der Costa Smeralda.",
    stepsHeading: "Die 4 Buchungsschritte",
    steps: [
      { t: "Fahrzeug und Daten wählen", d: "Wählen Sie das Fahrzeug aus dem Fuhrpark und legen Sie Beginn und Ende der Anmietung fest. Die Preise sind saisonal (April–Oktober) und transparent." },
      { t: "Ihre Daten eingeben", d: "E-Mail und Telefonnummer zur Bestätigung sowie Vorder- und Rückseite des Führerscheins (und eines etwaigen zweiten Fahrers)." },
      { t: "Lieferung wählen", d: "Flughafen Olbia (OLB), Hafen Isola Bianca, Hotel oder Villa: kostenlose Lieferung im Gemeindegebiet Olbia, transparentes Angebot in anderen Orten." },
      { t: "Vom Handy unterschreiben", d: "Sie unterschreiben den Vertrag digital und erhalten sofort eine E-Mail-Bestätigung mit dem Vertrag im Anhang. Keine Schlangen, kein Warten am Schalter." },
    ],
    payHeading: "Bezahlen auch ohne Kreditkarte",
    pay: "KS Rent Sardinia ist eine der wenigen Autovermietungen in Olbia, die keine klassische Kreditkarte voraussetzt. Wir akzeptieren Bargeld, Banküberweisung (auch sofort), aufladbare Prepaid-Karten wie Postepay, Revolut und N26, Debitkarten und Bancomat. Die Kaution richtet sich nach dem Fahrzeug und wird vor der Abholung klar mitgeteilt.",
    linksHeading: "Vor der Buchung",
    links: { fleet: "Den ganzen Fuhrpark ansehen", rates: "Saisonpreise ansehen", hub: "Autovermietung in Olbia", noCard: "Autovermietung ohne Kreditkarte", whatsapp: "Angebot per WhatsApp anfragen" },
  },
  fr: {
    heading: "Comment réserver votre location à Olbia",
    lead: "Réserver un véhicule chez KS Rent Sardinia prend quelques minutes, directement depuis votre smartphone. Choisissez la voiture, la moto, le scooter ou le quad, indiquez les dates et le lieu de livraison : nous vous attendons à l'aéroport d'Olbia Costa Smeralda (OLB), au port d'Isola Bianca ou à votre hôtel, dans toute la Gallura et la Costa Smeralda.",
    stepsHeading: "Les 4 étapes de la réservation",
    steps: [
      { t: "Choisir le véhicule et les dates", d: "Sélectionnez le véhicule dans la flotte et indiquez les dates de début et de fin. Les tarifs sont saisonniers (avril–octobre) et transparents." },
      { t: "Saisir vos coordonnées", d: "E-mail et numéro de téléphone pour la confirmation, plus les photos recto et verso du permis (et d'un éventuel second conducteur)." },
      { t: "Choisir la livraison", d: "Aéroport d'Olbia (OLB), port d'Isola Bianca, hôtel ou villa : livraison gratuite dans la commune d'Olbia, devis transparent ailleurs." },
      { t: "Signer depuis le téléphone", d: "Vous signez le contrat numériquement et recevez aussitôt un e-mail de confirmation avec le contrat en pièce jointe. Sans file ni attente au comptoir." },
    ],
    payHeading: "Payer même sans carte de crédit",
    pay: "KS Rent Sardinia est l'une des rares agences de location à Olbia à ne pas exiger de carte de crédit traditionnelle. Nous acceptons les espèces, le virement bancaire (même instantané), les cartes prépayées rechargeables comme Postepay, Revolut et N26, les cartes de débit et le bancomat. La caution est proportionnée au véhicule et communiquée clairement avant la prise en charge.",
    linksHeading: "Avant de réserver",
    links: { fleet: "Voir toute la flotte", rates: "Consulter les tarifs saisonniers", hub: "Location de voiture à Olbia", noCard: "Location sans carte de crédit", whatsapp: "Demander un devis sur WhatsApp" },
  },
} satisfies Record<Lang, any>;

const t = T[lang];
const fleet = FLEET[lang];
const rates = RATES[lang];
const carHub = CAR_HUB[lang];
const noCard = NO_CARD[lang];
---
<section class="border-t border-border bg-card/30" aria-labelledby="booking-intro-heading">
  <div class="max-w-4xl mx-auto px-4 py-12 md:py-16">
    <span class="text-gold font-bold tracking-[0.3em] uppercase text-[10px]">KS Rent Sardinia</span>
    <h2 id="booking-intro-heading" class="text-2xl md:text-3xl font-black text-foreground mt-3 mb-4">{t.heading}</h2>
    <p class="text-foreground/80 leading-relaxed max-w-3xl">{t.lead}</p>

    <h3 class="text-lg font-bold text-foreground mt-10 mb-5">{t.stepsHeading}</h3>
    <ol class="grid gap-4 sm:grid-cols-2">
      {t.steps.map((s, i) => (
        <li class="flex gap-4 bg-card border border-border rounded-2xl p-5">
          <span class="shrink-0 w-9 h-9 rounded-full bg-gold/15 border border-gold/30 text-gold font-black grid place-items-center">{i + 1}</span>
          <span>
            <span class="block font-bold text-foreground">{s.t}</span>
            <span class="block text-sm text-foreground/70 mt-1 leading-relaxed">{s.d}</span>
          </span>
        </li>
      ))}
    </ol>

    <h3 class="text-lg font-bold text-foreground mt-10 mb-3">{t.payHeading}</h3>
    <p class="text-foreground/80 leading-relaxed max-w-3xl">{t.pay}</p>

    <h3 class="text-lg font-bold text-foreground mt-10 mb-4">{t.linksHeading}</h3>
    <div class="flex flex-wrap gap-3">
      <a href={fleet} class="inline-flex items-center gap-2 text-sm font-semibold text-foreground border border-border rounded-full px-4 py-2 hover:border-gold hover:text-gold transition-colors">{t.links.fleet} →</a>
      <a href={rates} class="inline-flex items-center gap-2 text-sm font-semibold text-foreground border border-border rounded-full px-4 py-2 hover:border-gold hover:text-gold transition-colors">{t.links.rates} →</a>
      <a href={carHub} class="inline-flex items-center gap-2 text-sm font-semibold text-foreground border border-border rounded-full px-4 py-2 hover:border-gold hover:text-gold transition-colors">{t.links.hub} →</a>
      <a href={noCard} class="inline-flex items-center gap-2 text-sm font-semibold text-foreground border border-border rounded-full px-4 py-2 hover:border-gold hover:text-gold transition-colors">{t.links.noCard} →</a>
      <a href={WHATSAPP} rel="nofollow" class="inline-flex items-center gap-2 text-sm font-semibold text-background bg-gold rounded-full px-4 py-2 hover:scale-105 transition-transform">{t.links.whatsapp}</a>
    </div>
  </div>
</section>
