  <h2>{t.identityH}</h2>
  <ul>
    {t.identity.map((row) => (
      <li><strong>{row.k}</strong>: {row.v}</li>
    ))}
  </ul>

  <h2>{t.whyH}</h2>
  <p>{t.why}</p>

  <h2>{t.repH}</h2>
  <p>{t.rep}</p>

  <h2>{t.disamH}</h2>
  <p>{t.disam}</p>
</section>
