---
/**
 * Blocco "Chi siamo" crawler-readable per le 4 lingue.
 *
 * Le pagine about montano <ChiSiamo client:only="react"> → nessun contenuto
 * server-side. IT aveva un blocco sr-only inline; EN/DE/FR erano completamente
 * VUOTE per i crawler che non eseguono JS (GPTBot, ClaudeBot, PerplexityBot).
 * Questo componente fornisce a tutte e 4 le lingue lo stesso contenuto
 * enciclopedico citabile (identità, fondatori, dati ufficiali, disambiguazione).
 *
 * Reso come blocco sr-only: il contenuto è coerente con quanto la view React
 * mostra visivamente (storia + dati azienda), quindi NON è cloaking — è una
 * trascrizione accessibile e indicizzabile della stessa pagina. Tenerlo
 * sr-only evita la duplicazione visibile con l'isola React.
 */
type Lang = "it" | "en" | "de" | "fr";
interface Props { lang?: Lang; }
const { lang = "it" } = Astro.props;

const T: Record<Lang, {
  h1: string;
  intro: string;
  foundersH: string; founders: string;
  identityH: string; identity: { k: string; v: string }[];
  whyH: string; why: string;
  repH: string; rep: string;
  disamH: string; disam: string;
