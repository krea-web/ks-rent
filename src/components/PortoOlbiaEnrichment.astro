const t = T[lang];
---

<!-- COMPAGNIE TRAGHETTI -->
<section class="py-16 md:py-20 px-4 md:px-12 bg-card border-t border-border">
  <div class="max-w-5xl mx-auto">
    <span class="block text-gold font-bold tracking-[0.3em] uppercase text-[10px] mb-3">{t.ferriesEyebrow}</span>
    <h2 class="text-2xl md:text-4xl font-black italic uppercase tracking-tighter text-foreground mb-5">
      {t.ferriesHeading}
    </h2>
    <p class="text-foreground/75 font-light leading-relaxed mb-8" set:html={t.ferriesIntro}></p>

    <div class="bg-background border border-border rounded-2xl overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[640px]">
          <thead class="bg-card/50 border-b border-border">
            <tr>
              {t.ferriesTableHeaders.map((h) => (
                <th class="px-4 py-3 text-left text-xs uppercase tracking-wider text-foreground/50 font-bold">{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {t.ferriesData.map((row) => (
              <tr class="border-b border-border/50 last:border-0 hover:bg-card/30 transition-colors">
                <td class="px-4 py-3 font-bold text-foreground">{row[0]}</td>
                <td class="px-4 py-3 text-foreground/70">{row[1]}</td>
                <td class="px-4 py-3 text-gold font-semibold">{row[2]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <p class="text-xs text-foreground/55 mt-4 leading-relaxed" set:html={t.ferriesNote}></p>
  </div>
</section>

<!-- DISTANZE BANCHINA -->
<section class="py-16 md:py-20 px-4 md:px-12 bg-background border-t border-border">
  <div class="max-w-5xl mx-auto">
    <span class="block text-gold font-bold tracking-[0.3em] uppercase text-[10px] mb-3">{t.distancesEyebrow}</span>
    <h2 class="text-2xl md:text-4xl font-black italic uppercase tracking-tighter text-foreground mb-5">
      {t.distancesHeading}
    </h2>
    <p class="text-foreground/75 font-light leading-relaxed mb-8" set:html={t.distancesIntro}></p>

    <div class="bg-card border border-border rounded-2xl overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm min-w-[640px]">
          <thead class="bg-background/50 border-b border-border">
            <tr>
              {t.distancesTableHeaders.map((h) => (
                <th class="px-4 py-3 text-left text-xs uppercase tracking-wider text-foreground/50 font-bold">{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {t.distancesData.map((row) => (
              <tr class="border-b border-border/50 last:border-0">
                <td class="px-4 py-3 text-foreground/85">{row[0]}</td>
                <td class="px-4 py-3 text-foreground/85">{row[1]}</td>
                <td class="px-4 py-3 text-gold font-semibold">{row[2]}</td>
                <td class="px-4 py-3 text-foreground/70 font-medium">{row[3]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
    <p class="text-xs text-foreground/55 mt-4 leading-relaxed" set:html={t.distancesNote}></p>
  </div>
</section>

<!-- VISUAL CONSEGNA: foto chiavi al porto -->
<section class="relative overflow-hidden border-t border-border">
  <div class="grid md:grid-cols-2">
    <div class="bg-background flex items-center px-6 md:px-12 py-12 md:py-16 md:order-1 order-2">
      <div>
        <span class="block text-gold font-bold tracking-[0.3em] uppercase text-[10px] mb-3">
          {lang === "en" ? "100 m from the dock" : lang === "de" ? "100 m vom Anleger" : lang === "fr" ? "100 m du quai" : "100 m dalla banchina"}
        </span>
        <h2 class="text-2xl md:text-3xl font-black italic uppercase tracking-tighter text-foreground mb-4 leading-tight">
          {lang === "en" ? "Off the ferry. Into the car." : lang === "de" ? "Aus der Faehre. Ins Auto." : lang === "fr" ? "Hors du ferry. Dans la voiture." : "Sceso dal traghetto. In auto."}
        </h2>
        <p class="text-foreground/75 font-light leading-relaxed">
          {lang === "en" ? "Disembark from Moby, Tirrenia, GNV or Corsica Ferries, walk 100 metres along Viale Isola Bianca and you're at our base. Keys handed over outside, contract pre-filled, walkthrough done in 5 minutes flat."
            : lang === "de" ? "Aussteigen aus Moby, Tirrenia, GNV oder Corsica Ferries, 100 Meter entlang Viale Isola Bianca laufen und Sie sind an unserer Basis. Schluessel draussen uebergeben, Vertrag vorbereitet, Einweisung in glatten 5 Minuten erledigt."
            : lang === "fr" ? "Débarquez du Moby, Tirrenia, GNV ou Corsica Ferries, marchez 100 mètres le long du Viale Isola Bianca et vous êtes à notre base. Clés remises dehors, contrat pré-rempli, présentation faite en 5 minutes pile."
            : "Sbarchi da Moby, Tirrenia, GNV o Corsica Ferries, cammini 100 metri lungo Viale Isola Bianca e sei alla nostra sede. Chiavi consegnate fuori, contratto pre-compilato, walkthrough in 5 minuti netti."}
        </p>
      </div>
    </div>
    <div class="relative aspect-[4/3] md:aspect-auto md:order-2 order-1">
      <img
        src="https://zgytnkimjpoosvshfopz.supabase.co/storage/v1/object/public/asset/editorial/18-chiavi-consegna.webp"
        srcset="https://zgytnkimjpoosvshfopz.supabase.co/storage/v1/object/public/asset/editorial/18-chiavi-consegna.webp?width=480 480w, https://zgytnkimjpoosvshfopz.supabase.co/storage/v1/object/public/asset/editorial/18-chiavi-consegna.webp?width=800 800w, https://zgytnkimjpoosvshfopz.supabase.co/storage/v1/object/public/asset/editorial/18-chiavi-consegna.webp?width=1200 1200w"
        sizes="(min-width: 768px) 50vw, 100vw"
        alt={lang === "en" ? "KS Rent Sardinia key handover at Olbia Isola Bianca port — fast pickup" : lang === "de" ? "KS Rent Sardinia Schluesseluebergabe am Hafen Olbia Isola Bianca — schnelle Abholung" : lang === "fr" ? "Remise des clés KS Rent Sardinia au port d'Olbia Isola Bianca — retrait rapide" : "Consegna chiavi KS Rent Sardinia al porto Olbia Isola Bianca — ritiro rapido"}
        width="1200"
        height="900"
        class="w-full h-full object-cover"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>

<!-- FAQ AVANZATA -->
<section class="py-16 md:py-20 px-4 md:px-12 bg-card border-t border-border">
  <div class="max-w-4xl mx-auto">
    <span class="block text-gold font-bold tracking-[0.3em] uppercase text-[10px] mb-3">{t.faqEyebrow}</span>
    <h2 class="text-2xl md:text-4xl font-black italic uppercase tracking-tighter text-foreground mb-10">
      {t.faqHeading}
    </h2>

    <div class="space-y-3">
      {t.faqs.map((faq, i) => (
        <details class="group bg-background border border-border rounded-2xl p-5 md:p-6 transition-colors hover:border-gold/40">
          <summary class="cursor-pointer list-none flex items-center justify-between gap-4">
            <span class="font-bold text-foreground text-[15px] md:text-base leading-snug">
              <span class="text-gold mr-2">{(i + 1).toString().padStart(2, "0")}.</span>
              {faq.q}
            </span>
            <span class="text-gold text-2xl shrink-0 group-open:rotate-45 transition-transform">+</span>
          </summary>
          <div class="mt-4 text-foreground/75 font-light leading-relaxed text-sm md:text-[15px]" set:html={faq.a}></div>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- HUB GUIDE CORRELATE -->
<section class="py-16 md:py-20 px-4 md:px-12 bg-background border-t border-border">
  <div class="max-w-5xl mx-auto">
    <span class="block text-gold font-bold tracking-[0.3em] uppercase text-[10px] mb-3">{t.hubEyebrow}</span>
    <h2 class="text-2xl md:text-4xl font-black italic uppercase tracking-tighter text-foreground mb-3">
      {t.hubHeading}
    </h2>
    <p class="text-foreground/70 font-light mb-10 max-w-2xl">{t.hubIntro}</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {t.hubCards.map((c) => (
        <a
          href={c.href}
          class="block bg-card border border-border rounded-2xl p-6 hover:border-gold/50 hover:bg-card/80 transition-all group"
        >
          <h3 class="font-bold text-foreground group-hover:text-gold transition-colors text-lg mb-2 leading-tight">
            {c.title}
          </h3>
          <p class="text-foreground/65 font-light text-sm leading-relaxed">{c.desc}</p>
          <span class="inline-block mt-3 text-gold text-xs font-bold tracking-wider uppercase">→</span>
        </a>
      ))}
    </div>
  </div>
</section>
