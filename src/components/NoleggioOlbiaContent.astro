---

<main class="bg-background text-foreground">

  {/* ───── HERO ───── */}
  <section class="relative overflow-hidden border-b border-border/40 bg-gradient-to-br from-background via-background to-primary/5">
    <div class="container mx-auto px-4 py-16 md:py-24">
      <div class="max-w-4xl mx-auto text-center">
        <p class="text-sm uppercase tracking-widest text-primary/80 font-semibold mb-4">{T.hero.eyebrow}</p>
        <h1 class="text-4xl md:text-6xl font-bold leading-tight mb-6">
          {T.hero.titleLine1}<br/>
          <span class="text-primary">{T.hero.titleLine2}</span>
        </h1>
        <p class="text-lg md:text-xl text-muted-foreground mb-6 max-w-3xl mx-auto">{T.hero.lead}</p>

        {/* S1 (SXO): prova sociale above-the-fold più evidente */}
        <div class="flex justify-center mb-8">
          <span class="inline-flex items-center gap-2 px-5 py-2.5 bg-gold/10 border border-gold/30 rounded-full text-base font-semibold text-foreground" data-speakable>
            <span class="text-gold text-lg leading-none" aria-label={T.hero.ratingLabel}>★★★★★</span>
            <strong>5,0/5</strong>
            <span class="text-muted-foreground font-normal">{T.hero.ratingText}</span>
          </span>
        </div>

        <div class="flex flex-wrap justify-center gap-4 mb-10 text-sm">
          <span class="flex items-center gap-2 px-4 py-2 bg-primary/10 text-primary rounded-full font-medium">✓ {T.hero.badge1}</span>
          <span class="flex items-center gap-2 px-4 py-2 bg-primary/10 text-primary rounded-full font-medium">✓ {T.hero.badge2}</span>
          <span class="flex items-center gap-2 px-4 py-2 bg-primary/10 text-primary rounded-full font-medium">✓ {T.hero.badge3}</span>
        </div>

        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a href={BOOK_HUB[lang]} class="inline-flex items-center justify-center px-8 py-4 bg-primary text-primary-foreground rounded-full font-semibold text-lg hover:bg-primary/90 transition shadow-lg">{T.hero.ctaBook}</a>
          <a href={WHATSAPP_HREF} rel="nofollow" class="inline-flex items-center justify-center px-8 py-4 bg-gold text-background rounded-full font-semibold text-lg hover:scale-105 transition-transform shadow-lg">{T.hero.ctaQuote}</a>
        </div>

        <p class="mt-6 text-sm text-muted-foreground">
          📞 <a href="tel:+393446107071" class="font-medium hover:text-primary transition">+39 344 6107071</a>
          <span class="mx-2">·</span>
          {T.hero.updatedPrefix} {heroUpdated}
        </p>
      </div>
    </div>
  </section>

  {/* ───── WHY ───── */}
  <section class="py-16 md:py-20 border-b border-border/40">
    <div class="container mx-auto px-4 max-w-5xl">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">{T.why.heading}</h2>
      <p class="text-lg text-muted-foreground mb-8 leading-relaxed" set:html={T.why.lead} />
      <ul class="grid md:grid-cols-2 gap-6 text-base">
        {T.why.bullets.map((b) => (
          <li class="flex gap-3">
            <span class="text-primary text-2xl">{b.icon}</span>
            <div>
              <strong>{b.title}</strong> {b.text}
            </div>
          </li>
        ))}
      </ul>

      <div class="mt-10 grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-7 gap-3">
        {Object.entries(VEHICLE_ASSETS).map(([slug, v]) => {
          const catLabel = T.categoryLabels[v.categoryKey as keyof typeof T.categoryLabels];
          return (
            <a
              href={fleetHref(slug)}
              class="group flex flex-col items-center gap-2 p-3 bg-card border border-border rounded-xl hover:border-primary transition"
              title={T.why.titleAttrTpl(v.name)}
            >
              <img
                src={v.image}
                alt={T.why.altTpl(v.name, catLabel)}
                width="120"
                height="80"
                loading="lazy"
                class="h-16 w-full object-contain group-hover:scale-110 transition-transform duration-300"
              />
              <span class="text-[11px] font-semibold text-foreground text-center leading-tight">{v.name}</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  {/* ───── DELIVERY ───── */}
  <section class="py-16 md:py-20 border-b border-border/40 bg-muted/20">
    <div class="container mx-auto px-4 max-w-5xl">
      <h2 class="text-3xl md:text-4xl font-bold mb-6">{T.delivery.heading}</h2>
      <p class="text-lg text-muted-foreground mb-8 leading-relaxed" set:html={T.delivery.lead} />

      <div class="grid md:grid-cols-3 gap-6">
        <article class="bg-card border border-border rounded-2xl p-6">
