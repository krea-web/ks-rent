---
/**
 * Sezione magazine-editoriale per pubblicizzare gli articoli guide.
 * 4 card editoriali (1 large + 3 small) con hero, eyebrow categoria,
 * titolo serif, reading time. Linka tutte alla guida e ha un CTA
 * "Vedi tutte le guide" che porta a /guide (localizzato).
 *
 * Da inserire in homepage/chisiamo per dare risalto all'asset content.
 */
import { ArrowRight, Clock, BookOpen } from "lucide-react";
import {
  GUIDE_ARTICLES,
  GUIDE_ARTICLES_EN,
  GUIDE_ARTICLES_DE,
  GUIDE_ARTICLES_FR,
} from "@/data/guide-articles";

type Lang = "it" | "en" | "de" | "fr";

interface Props {
  lang: Lang;
  /** Slug IT dei 4 articoli da mostrare. Se omesso: i 4 piu' recenti. */
  featured?: string[];
}

const { lang, featured } = Astro.props;

const collection =
  lang === "en" ? GUIDE_ARTICLES_EN :
  lang === "de" ? GUIDE_ARTICLES_DE :
  lang === "fr" ? GUIDE_ARTICLES_FR :
  GUIDE_ARTICLES;

// Risali allo slug nella lingua corrente da un slug IT
function localSlugFor(itSlug: string): string | null {
  if (lang === "it") {
    return GUIDE_ARTICLES.some((a) => a.slug === itSlug) ? itSlug : null;
  }
  const found = (collection as { slug: string; itEquivalent?: string }[]).find(
    (a) => a.itEquivalent === itSlug,
  );
  return found?.slug ?? null;
}

let articles;
if (featured && featured.length > 0) {
  articles = featured
    .map((itSlug) => {
      const slug = localSlugFor(itSlug);
      return slug ? collection.find((a) => a.slug === slug) : null;
    })
    .filter(Boolean) as typeof collection;
} else {
  articles = [...collection]
    .sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime())
    .slice(0, 4);
}

if (articles.length < 4) {
  // Riempi con i piu' recenti
  const fill = [...collection]
    .sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime())
    .filter((a) => !articles.includes(a));
  while (articles.length < 4 && fill.length > 0) articles.push(fill.shift()!);
}

const [hero, ...rest] = articles;

const guideBase = lang === "it" ? "/guide" : `/${lang}/guide`;

const labels = {
  it: {
    eyebrow: "Le nostre guide",
    heading: "Tutto quello che ti serve per la Costa Smeralda",
    intro: "Itinerari, consigli sulla scelta del veicolo, sagre, distanze e parcheggi: la nostra redazione li aggiorna ogni stagione.",
    minRead: "min di lettura",
    seeAll: "Vedi tutte le guide",
  },
  en: {
    eyebrow: "Our guides",
    heading: "Everything you need for Costa Smeralda",
    intro: "Itineraries, vehicle advice, festivals, distances and parking: our editorial team keeps them up to date every season.",
    minRead: "min read",
    seeAll: "See all guides",
  },
  de: {
    eyebrow: "Unsere Anleitungen",
    heading: "Alles was Sie fuer die Costa Smeralda brauchen",
    intro: "Reiserouten, Fahrzeugtipps, Feste, Entfernungen und Parkmoeglichkeiten: unsere Redaktion aktualisiert sie jede Saison.",
    minRead: "Min. Lesezeit",
    seeAll: "Alle Anleitungen ansehen",
  },
  fr: {
    eyebrow: "Nos guides",
    heading: "Tout ce qu'il faut pour la Costa Smeralda",
    intro: "Itinéraires, conseils véhicule, festivals, distances et parkings : notre rédaction les met à jour chaque saison.",
    minRead: "min de lecture",
    seeAll: "Voir tous les guides",
  },
}[lang];
---

<section class="bg-card/30 border-y border-border py-14 md:py-20">
  <div class="max-w-7xl mx-auto px-4 md:px-8">
    {/* heading row */}
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10 md:mb-14">
      <div class="max-w-2xl">
        <p class="inline-flex items-center gap-2 text-[10px] uppercase tracking-[0.3em] font-bold text-gold mb-3">
          <BookOpen className="w-3.5 h-3.5" />
          {labels.eyebrow}
        </p>
        <h2 class="font-serif text-3xl md:text-4xl text-foreground font-medium leading-tight mb-3">
          {labels.heading}
        </h2>
        <p class="font-serif text-foreground/65 text-[16px] leading-relaxed">{labels.intro}</p>
      </div>
      <a
        href={guideBase}
        class="hidden md:inline-flex items-center gap-1.5 text-sm font-semibold text-foreground hover:text-gold transition self-start md:self-end whitespace-nowrap"
      >
        {labels.seeAll}
        <ArrowRight className="w-3.5 h-3.5" />
      </a>
    </div>

    {/* grid 1 large + 3 small */}
    <div class="grid md:grid-cols-3 gap-5 md:gap-6">
      {/* Hero card (sx, occupa 2 col su desktop) */}
      {hero && (
        <a
          href={`${guideBase}/${hero.slug}`}
          class="md:col-span-2 group block bg-background border border-border rounded-xl overflow-hidden hover:border-gold/50 transition shadow-sm hover:shadow-2xl"
        >
          <div class="aspect-[16/10] overflow-hidden">
            <img
              src={hero.heroImage}
              alt={hero.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />
          </div>
          <div class="p-6 md:p-7">
            <span class="text-[10px] uppercase tracking-[0.28em] text-gold font-bold">{hero.category}</span>
            <h3 class="font-serif text-2xl md:text-3xl text-foreground mt-3 leading-tight group-hover:text-gold transition">
              {hero.title}
            </h3>
            <p class="text-foreground/65 mt-3 leading-relaxed line-clamp-2">{hero.excerpt}</p>
            <p class="inline-flex items-center gap-1.5 text-[12px] text-foreground/45 mt-4">
              <Clock className="w-3 h-3" />
              {hero.readingMinutes} {labels.minRead}
            </p>
          </div>
        </a>
      )}

      {/* 3 small cards (stack su desktop nella colonna destra) */}
      <div class="md:col-span-1 space-y-4">
        {rest.map((a) => (
          <a
            href={`${guideBase}/${a.slug}`}
            class="group flex gap-3 bg-background border border-border rounded-xl overflow-hidden hover:border-gold/40 transition shadow-sm hover:shadow-lg"
          >
            <div class="w-28 h-28 shrink-0 overflow-hidden">
              <img
                src={a.heroImage}
                alt={a.title}
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                loading="lazy"
              />
            </div>
            <div class="py-3 pr-3 flex flex-col justify-center min-w-0">
              <span class="text-[9px] uppercase tracking-[0.25em] text-gold font-bold">{a.category}</span>
              <p class="font-serif text-[15px] text-foreground leading-snug mt-1.5 line-clamp-2 group-hover:text-gold transition">
                {a.title}
              </p>
              <p class="text-[11px] text-foreground/45 mt-1.5">{a.readingMinutes} {labels.minRead}</p>
            </div>
          </a>
        ))}
      </div>
    </div>

    {/* mobile cta */}
    <div class="md:hidden mt-8 text-center">
      <a
        href={guideBase}
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-foreground hover:text-gold transition"
      >
        {labels.seeAll}
        <ArrowRight className="w-3.5 h-3.5" />
      </a>
    </div>
  </div>
</section>
